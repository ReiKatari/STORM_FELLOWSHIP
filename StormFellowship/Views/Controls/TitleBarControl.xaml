<UserControl
    x:Class="StormFellowship.Views.Controls.TitleBarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:StormFellowship.Helpers"
    mc:Ignorable="d">

    <UserControl.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Height="42" Background="{StaticResource TitleBarBackgroundBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Brand / Logo & Title -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0" Spacing="10">
            <Border Width="26" Height="26" CornerRadius="6" Background="{StaticResource AccentBrush}" Padding="3">
                <Image Source="ms-appx:///Assets/Icons/storm_logo_512.png" Stretch="Uniform" />
            </Border>
            <TextBlock Text="STORM FELLOWSHIP" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
            <Border Background="{StaticResource AccentMutedBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                <TextBlock Text="v0.0.1" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
            </Border>
        </StackPanel>

        <!-- Search Bar / Quick Command Bar -->
        <Border Grid.Column="1" HorizontalAlignment="Center" Width="360" Height="28" Background="{StaticResource InputBackgroundBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE721;" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" PlaceholderText="Search channels, messages, or friends... (Ctrl+K)" 
                         Background="Transparent" BorderThickness="0" FontSize="11" 
                         Foreground="{StaticResource TextPrimaryBrush}" Margin="4,0,0,0" VerticalAlignment="Center" />
                <Border Grid.Column="2" Background="{StaticResource CardBackgroundBrush}" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                    <TextBlock Text="Ctrl+K" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                </Border>
            </Grid>
        </Border>

        <!-- Theme Quick Switches & Toast -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0" Spacing="8">
            <!-- Toast Banner -->
            <Border Background="{StaticResource AccentBrush}" CornerRadius="12" Padding="10,3" Margin="0,0,8,0"
                    Visibility="{x:Bind ViewModel.HasStatusNotification, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextOnAccentBrush}" />
            </Border>

            <!-- Theme Switcher Buttons -->
            <Button ToolTipService.ToolTip="STORM DARK" Width="28" Height="28" Padding="0" CornerRadius="14" Background="#0B0F17" BorderBrush="#00A3FF" BorderThickness="1" Click="OnDarkThemeClicked">
                <FontIcon Glyph="&#xE708;" FontSize="11" Foreground="#00A3FF" />
            </Button>
            <Button ToolTipService.ToolTip="STORM NIGHT (OLED)" Width="28" Height="28" Padding="0" CornerRadius="14" Background="#000000" BorderBrush="#00E5FF" BorderThickness="1" Click="OnNightThemeClicked">
                <FontIcon Glyph="&#xE706;" FontSize="11" Foreground="#00E5FF" />
            </Button>
            <Button ToolTipService.ToolTip="STORM DAY" Width="28" Height="28" Padding="0" CornerRadius="14" Background="#F1F5F9" BorderBrush="#0284C7" BorderThickness="1" Click="OnDayThemeClicked">
                <FontIcon Glyph="&#xE706;" FontSize="11" Foreground="#0284C7" />
            </Button>
            <Button ToolTipService.ToolTip="STORM MIDNIGHT" Width="28" Height="28" Padding="0" CornerRadius="14" Background="#0D0714" BorderBrush="#A855F7" BorderThickness="1" Click="OnMidnightThemeClicked">
                <FontIcon Glyph="&#xE781;" FontSize="11" Foreground="#A855F7" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
