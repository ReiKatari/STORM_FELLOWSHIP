<UserControl x:Class="StormFellowship.Views.Controls.TitleBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="38">
    <Grid Background="{DynamicResource TitleBarBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Logo & Title -->
        <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
            <Border Width="22" Height="22" CornerRadius="5" Background="{DynamicResource AccentBrush}" Margin="0,0,8,0">
                <TextBlock Text="⚡" FontSize="12" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="STORM FELLOWSHIP" FontWeight="Black" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
            <TextBlock Text="v0.0.1" FontSize="10" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Middle Drag Region -->
        <Grid Grid.Column="1" Background="Transparent" MouseDown="OnTitleBarMouseDown" />

        <!-- Quick Theme Selector Chips -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
            <Button Content="DARK" Click="OnDarkThemeClicked" Margin="2,0" Padding="8,3" FontSize="10" FontWeight="Bold" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Cursor="Hand" />
            <Button Content="NIGHT" Click="OnNightThemeClicked" Margin="2,0" Padding="8,3" FontSize="10" FontWeight="Bold" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Cursor="Hand" />
            <Button Content="DAY" Click="OnDayThemeClicked" Margin="2,0" Padding="8,3" FontSize="10" FontWeight="Bold" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Cursor="Hand" />
            <Button Content="MIDNIGHT" Click="OnMidnightThemeClicked" Margin="2,0" Padding="8,3" FontSize="10" FontWeight="Bold" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Cursor="Hand" />
        </StackPanel>

        <!-- Window System Buttons -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Stretch">
            <Button Width="46" Height="38" Background="Transparent" BorderThickness="0" Click="OnMinimizeClicked" Cursor="Hand">
                <TextBlock Text="🗕" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <Button Width="46" Height="38" Background="Transparent" BorderThickness="0" Click="OnMaximizeRestoreClicked" Cursor="Hand">
                <TextBlock Text="🗖" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <Button Width="46" Height="38" Background="Transparent" BorderThickness="0" Click="OnCloseClicked" Cursor="Hand">
                <TextBlock Text="✕" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
