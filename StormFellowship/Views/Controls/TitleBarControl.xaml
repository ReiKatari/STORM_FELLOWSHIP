<UserControl x:Class="StormFellowship.Views.Controls.TitleBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="48">
    <Grid Background="{DynamicResource TitleBarBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Logo & Title -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
            <Border Width="26" Height="26" CornerRadius="6" Background="{DynamicResource AccentBrush}" Margin="0,0,10,0">
                <TextBlock Text="⚡" FontSize="14" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="STORM" FontWeight="Black" FontSize="15" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
            <TextBlock Text=" FELLOWSHIP" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
            <Border Background="{DynamicResource AccentMutedBrush}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="v0.0.3" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
            </Border>
        </StackPanel>

        <!-- Check for Updates Button -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0" WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Click="OnCheckUpdatesClicked" Margin="3,0" Padding="12,5" FontSize="11" FontWeight="SemiBold" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Cursor="Hand" ToolTip="Проверить наличие обновлений">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="↺" FontSize="12" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="Проверить обновления" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Window System Buttons -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Width="46" Height="48" Background="Transparent" BorderThickness="0" Click="OnMinimizeClicked" Cursor="Hand" ToolTip="Свернуть">
                <TextBlock Text="🗕" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <Button Width="46" Height="48" Background="Transparent" BorderThickness="0" Click="OnMaximizeRestoreClicked" Cursor="Hand" ToolTip="Развернуть / Восстановить">
                <TextBlock Text="🗖" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <Button Width="46" Height="48" Background="Transparent" BorderThickness="0" Click="OnCloseClicked" Cursor="Hand" ToolTip="Закрыть">
                <TextBlock Text="✕" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
