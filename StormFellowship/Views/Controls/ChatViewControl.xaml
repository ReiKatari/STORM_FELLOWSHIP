<UserControl
    x:Class="StormFellowship.Views.Controls.ChatViewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:StormFellowship.Models"
    xmlns:helpers="using:StormFellowship.Helpers"
    mc:Ignorable="d">

    <UserControl.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis" />
        <helpers:NullToVisibilityConverter x:Key="NullToVis" />
        <helpers:HexToBrushConverter x:Key="HexToBrush" />
        <helpers:StringNotEmptyToVisibilityConverter x:Key="StrNotEmptyToVis" />
    </UserControl.Resources>

    <Grid Background="{StaticResource ContentBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Channel / DM Top Header -->
        <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="16,0" Background="{StaticResource ContentBackgroundBrush}">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Title & Topic -->
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.HeaderTitle, Mode=OneWay}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <Rectangle Width="1" Height="16" Fill="{StaticResource DividerBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.HeaderTopic, Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="450" />
                </StackPanel>

                <!-- Action Controls: Audio Call, Video Call, Pin, Member Toggle -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- Start Audio Call -->
                    <Button ToolTipService.ToolTip="Start Direct Audio Call" Width="32" Height="32" Padding="0" CornerRadius="6"
                            Background="Transparent" BorderThickness="0" Command="{x:Bind ViewModel.StartDirectAudioCallCommand}">
                        <FontIcon Glyph="&#xE717;" FontSize="14" Foreground="{StaticResource AccentBrush}" />
                    </Button>

                    <!-- Start Video Call -->
                    <Button ToolTipService.ToolTip="Start Direct Video Call" Width="32" Height="32" Padding="0" CornerRadius="6"
                            Background="Transparent" BorderThickness="0" Command="{x:Bind ViewModel.StartDirectVideoCallCommand}">
                        <FontIcon Glyph="&#xE714;" FontSize="14" Foreground="{StaticResource AccentBrush}" />
                    </Button>

                    <!-- Pinned Messages -->
                    <Button ToolTipService.ToolTip="Pinned Messages" Width="32" Height="32" Padding="0" CornerRadius="6"
                            Background="Transparent" BorderThickness="0">
                        <FontIcon Glyph="&#xE718;" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Button>

                    <!-- Member List Toggle -->
                    <Button ToolTipService.ToolTip="Toggle Member List" Width="32" Height="32" Padding="0" CornerRadius="6"
                            Background="Transparent" BorderThickness="0" Click="OnToggleMemberListClicked">
                        <FontIcon Glyph="&#xE716;" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Chat Messages List -->
        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.CurrentMessages, Mode=OneWay}"
                  SelectionMode="None" Padding="16,12" Background="Transparent">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0,4" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ChatMessage">
                    <Grid Margin="0,4" HorizontalAlignment="Stretch">
                        <!-- Message Container Card -->
                        <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="8" Padding="12,10" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Author Avatar -->
                                <Border Width="40" Height="40" CornerRadius="20" VerticalAlignment="Top" Margin="0,0,12,0" BorderBrush="{StaticResource AccentGlowBrush}" BorderThickness="1">
                                    <Image Source="{x:Bind Author.AvatarPath}" Stretch="UniformToFill" Width="40" Height="40" />
                                </Border>

                                <!-- Message Body -->
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <!-- Quoted Reply Box -->
                                    <Border Background="{StaticResource InputBackgroundBrush}" CornerRadius="4" Padding="8,4" Margin="0,0,0,4"
                                            BorderBrush="{StaticResource AccentBrush}" BorderThickness="2,0,0,0"
                                            Visibility="{x:Bind HasReply, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{x:Bind ReplyToAuthor}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Text="{x:Bind ReplyToContent}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Author Header & Time -->
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Author.DisplayName}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                        
                                        <!-- Role Tag -->
                                        <Border Background="{StaticResource AccentMutedBrush}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Author.RoleName}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                        </Border>

                                        <TextBlock Text="{x:Bind FormattedDate}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                        
                                        <!-- Pinned Indicator -->
                                        <FontIcon Glyph="&#xE718;" FontSize="10" Foreground="{StaticResource AccentBrush}"
                                                  Visibility="{x:Bind IsPinned, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>

                                    <!-- Message Text Content -->
                                    <TextBlock Text="{x:Bind Content}" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                               Visibility="{x:Bind Content, Converter={StaticResource StrNotEmptyToVis}}" />

                                    <!-- Sticker Attachment (if any) -->
                                    <Border Margin="0,6,0,0" HorizontalAlignment="Left" CornerRadius="8"
                                            Visibility="{x:Bind HasSticker, Converter={StaticResource BoolToVis}}">
                                        <Image Source="{x:Bind StickerUrl}" Width="160" Height="160" Stretch="Uniform" />
                                    </Border>

                                    <!-- Image Attachment (if any) -->
                                    <Border Margin="0,6,0,0" HorizontalAlignment="Left" CornerRadius="8"
                                            Visibility="{x:Bind HasAttachment, Converter={StaticResource BoolToVis}}">
                                        <Image Source="{x:Bind AttachmentUrl}" MaxWidth="360" MaxHeight="240" Stretch="Uniform" />
                                    </Border>

                                    <!-- Reactions Row -->
                                    <ItemsControl ItemsSource="{x:Bind Reactions}" Margin="0,6,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="6" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:MessageReaction">
                                                <Button Padding="6,2" CornerRadius="12" Background="{StaticResource InputBackgroundBrush}"
                                                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                                        Click="OnReactionButtonClicked" Tag="{x:Bind}">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <TextBlock Text="{x:Bind EmojiSymbol}" FontSize="12" />
                                                        <TextBlock Text="{x:Bind Count}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Message Hover Action Toolbar -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Top" Margin="8,0,0,0">
                                    <!-- Quick React ⚡ -->
                                    <Button ToolTipService.ToolTip="React ⚡" Width="26" Height="26" Padding="0" CornerRadius="4"
                                            Background="Transparent" BorderThickness="0" Click="OnQuickReactLightning" Tag="{x:Bind}">
                                        <TextBlock Text="⚡" FontSize="11" />
                                    </Button>

                                    <!-- Quick React ❤️ -->
                                    <Button ToolTipService.ToolTip="React ❤️" Width="26" Height="26" Padding="0" CornerRadius="4"
                                            Background="Transparent" BorderThickness="0" Click="OnQuickReactHeart" Tag="{x:Bind}">
                                        <TextBlock Text="❤️" FontSize="11" />
                                    </Button>

                                    <!-- Reply -->
                                    <Button ToolTipService.ToolTip="Reply" Width="26" Height="26" Padding="0" CornerRadius="4"
                                            Background="Transparent" BorderThickness="0" Click="OnReplyClicked" Tag="{x:Bind}">
                                        <FontIcon Glyph="&#xE97A;" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Button>

                                    <!-- Pin -->
                                    <Button ToolTipService.ToolTip="Pin / Unpin" Width="26" Height="26" Padding="0" CornerRadius="4"
                                            Background="Transparent" BorderThickness="0" Click="OnPinClicked" Tag="{x:Bind}">
                                        <FontIcon Glyph="&#xE718;" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Button>

                                    <!-- Delete -->
                                    <Button ToolTipService.ToolTip="Delete" Width="26" Height="26" Padding="0" CornerRadius="4"
                                            Background="Transparent" BorderThickness="0" Click="OnDeleteClicked" Tag="{x:Bind}">
                                        <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Message Composer Bottom Area -->
        <Border Grid.Row="2" Padding="16,8,16,16" Background="{StaticResource ContentBackgroundBrush}">
            <StackPanel Spacing="6">
                <!-- Replying Banner (if active) -->
                <Border Background="{StaticResource InputBackgroundBrush}" CornerRadius="6" Padding="10,6"
                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="1,0,0,0"
                        Visibility="{x:Bind ViewModel.ReplyingToMessage, Mode=OneWay, Converter={StaticResource NullToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Replying to" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.ReplyingToMessage.Author.DisplayName, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Width="22" Height="22" Padding="0" Background="Transparent" BorderThickness="0"
                                Command="{x:Bind ViewModel.CancelReplyCommand}">
                            <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Composer Input Box -->
                <Border Background="{StaticResource InputBackgroundBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="8,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Attach File Button -->
                        <Button ToolTipService.ToolTip="Attach File or Image" Width="32" Height="32" Padding="0" CornerRadius="16"
                                Background="Transparent" BorderThickness="0" Click="OnAttachFileClicked">
                            <FontIcon Glyph="&#xE710;" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Button>

                        <!-- Message Text Box -->
                        <TextBox x:Name="MessageInputBox" Grid.Column="1" Text="{x:Bind ViewModel.MessageInputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Type a message or use :emoji: and **markdown**..."
                                 Background="Transparent" BorderThickness="0" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                 VerticalAlignment="Center" Margin="6,0" KeyDown="OnMessageInputKeyDown" />

                        <!-- Right Actions: Stickers, Emojis, Send -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                            <!-- Sticker Flyout Button -->
                            <Button ToolTipService.ToolTip="Storm Stickers" Width="32" Height="32" Padding="0" CornerRadius="16" Background="Transparent" BorderThickness="0">
                                <FontIcon Glyph="&#xE700;" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" />
                                <Button.Flyout>
                                    <Flyout Placement="Top">
                                        <StackPanel Width="280" Height="260" Spacing="8">
                                            <TextBlock Text="STORM FELLOWSHIP STICKERS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                            <GridView ItemsSource="{x:Bind ViewModel.Stickers, Mode=OneWay}" SelectionMode="None"
                                                      IsItemClickEnabled="True" ItemClick="OnStickerItemClicked">
                                                <GridView.ItemTemplate>
                                                    <DataTemplate x:DataType="models:StickerItem">
                                                        <Border Width="80" Height="80" CornerRadius="8" Margin="4" Background="{StaticResource CardBackgroundBrush}" Padding="4">
                                                            <Image Source="{x:Bind ImagePath}" Stretch="Uniform" />
                                                        </Border>
                                                    </DataTemplate>
                                                </GridView.ItemTemplate>
                                            </GridView>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <!-- Emoji Flyout Button -->
                            <Button ToolTipService.ToolTip="Emojis" Width="32" Height="32" Padding="0" CornerRadius="16" Background="Transparent" BorderThickness="0">
                                <FontIcon Glyph="&#xE76E;" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" />
                                <Button.Flyout>
                                    <Flyout Placement="Top">
                                        <StackPanel Width="280" Height="260" Spacing="8">
                                            <TextBlock Text="EMOJIS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                            <GridView ItemsSource="{x:Bind ViewModel.Emojis, Mode=OneWay}" SelectionMode="None"
                                                      IsItemClickEnabled="True" ItemClick="OnEmojiItemClicked">
                                                <GridView.ItemTemplate>
                                                    <DataTemplate x:DataType="models:EmojiItem">
                                                        <Border Width="36" Height="36" CornerRadius="6" Background="{StaticResource CardBackgroundBrush}" Margin="2">
                                                            <TextBlock Text="{x:Bind Symbol}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </DataTemplate>
                                                </GridView.ItemTemplate>
                                            </GridView>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <!-- Send Button -->
                            <Button ToolTipService.ToolTip="Send Message (Enter)" Width="32" Height="32" Padding="0" CornerRadius="16"
                                    Background="{StaticResource AccentBrush}" BorderThickness="0"
                                    Command="{x:Bind ViewModel.SendMessageCommand}">
                                <FontIcon Glyph="&#xE724;" FontSize="13" Foreground="{StaticResource TextOnAccentBrush}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
