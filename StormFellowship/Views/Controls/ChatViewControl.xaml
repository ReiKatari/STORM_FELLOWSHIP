<UserControl x:Class="StormFellowship.Views.Controls.ChatViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource ContentBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Chat Header Bar -->
        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="#" FontWeight="Black" FontSize="18" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ChannelName}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <Border Width="1" Height="14" Background="{DynamicResource DividerBrush}" Margin="12,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ChannelTopic}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Header Actions (E2EE Shield, Search, Poll, MemberList) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Width="32" Height="32" Background="Transparent" BorderThickness="0" Cursor="Hand" Command="{Binding OpenE2EEDialogCommand}" ToolTip="🔒 E2EE Сквозное шифрование (AES-256)">
                        <TextBlock Text="🔒" FontSize="13" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button Width="32" Height="32" Background="Transparent" BorderThickness="0" Cursor="Hand" Command="{Binding OpenSearchCommand}" ToolTip="🔍 Поиск по сообщениям" Margin="4,0,0,0">
                        <TextBlock Text="🔍" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button Width="32" Height="32" Background="Transparent" BorderThickness="0" Cursor="Hand" Command="{Binding OpenCreatePollCommand}" ToolTip="📊 Создать опрос" Margin="4,0,0,0">
                        <TextBlock Text="📊" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button Width="32" Height="32" Background="Transparent" BorderThickness="0" Cursor="Hand" Command="{Binding ToggleMemberListCommand}" ToolTip="Список участников" Margin="4,0,0,0">
                        <TextBlock Text="👥" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Chat Messages Scroll Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,10">
            <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,4" Padding="8" CornerRadius="8" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Author Avatar -->
                                <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,2,12,0">
                                    <TextBlock Text="{Binding Author.AvatarGlyph}" FontSize="18" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <!-- Message Body -->
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Author.DisplayName}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding FormattedTime}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="8,2,0,0" />
                                    </StackPanel>

                                    <!-- Content -->
                                    <TextBlock Text="{Binding Content}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />

                                    <!-- Interactive Poll Card if Poll is present -->
                                    <Border Margin="0,8,0,0" CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" Padding="14" Visibility="{Binding IsPoll, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <TextBlock Text="📊" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Poll.Question}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            </StackPanel>

                                            <!-- Poll Options List -->
                                            <ItemsControl ItemsSource="{Binding Poll.Options}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Margin="0,3" Padding="10,8" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" HorizontalContentAlignment="Stretch" Cursor="Hand" Command="{Binding DataContext.VoteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="4" />
                                                                </Grid.RowDefinitions>
                                                                <Grid Margin="0,0,0,4">
                                                                    <TextBlock Text="{Binding Text}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock HorizontalAlignment="Right" Text="{Binding Percentage, StringFormat='{}{0:F0}%'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                                                </Grid>
                                                                <!-- Progress Bar -->
                                                                <ProgressBar Grid.Row="1" Value="{Binding Percentage}" Maximum="100" Height="4" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BorderSubtleBrush}" BorderThickness="0" />
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Text="{Binding Poll.TotalVotes, StringFormat='{}Всего голосов: {0}'}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Voice Note Card with Whisper AI Transcription Button -->
                                    <Border Margin="0,6,0,0" HorizontalAlignment="Left" CornerRadius="8" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="10" Visibility="{Binding IsVoiceNote, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🎙️ Голосовое сообщение (0:05)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <Button Content="🤖 Whisper AI: Расшифровать в текст" Background="{DynamicResource AccentBrush}" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Padding="8,4" FontSize="10" Cursor="Hand" Command="{Binding DataContext.TranscribeVoiceNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            </StackPanel>

                                            <!-- Transcribed Text View -->
                                            <Border Margin="0,6,0,0" Padding="8" Background="{DynamicResource InputBackgroundBrush}" CornerRadius="6" Visibility="{Binding IsTranscribed, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding TranscriptionText}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- Reactions Wrap -->
                                    <ItemsControl ItemsSource="{Binding Reactions}" Margin="0,6,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Margin="0,0,6,4" Padding="6,2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Cursor="Hand" Tag="{Binding}" Click="OnReactionBadgeClicked">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding EmojiSymbol}" FontSize="12" Margin="0,0,4,0" />
                                                        <TextBlock Text="{Binding Count}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Message Input Bar (Bottom) -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="16,10">
            <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="8,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Attachment (+) Button -->
                    <Button Width="30" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="OnAttachButtonClicked" ToolTip="Прикрепить файл">
                        <TextBlock Text="+" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                    </Button>

                    <!-- Text Input Box -->
                    <TextBox Grid.Column="1" Text="{Binding MessageInputText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" FontSize="13" VerticalContentAlignment="Center" Margin="8,0" KeyDown="OnMessageInputKeyDown" />

                    <!-- Actions (Emoji, Sticker, Poll, Voice Note, Send) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Width="30" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand" Command="{Binding OpenCreatePollCommand}" ToolTip="Создать опрос" Margin="2,0">
                            <TextBlock Text="📊" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <Button Width="30" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="OnEmojiButtonClicked" ToolTip="Эмодзи" Margin="2,0">
                            <TextBlock Text="😊" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <Button Width="30" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="OnStickerButtonClicked" ToolTip="Стикеры" Margin="2,0">
                            <TextBlock Text="👾" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <Button Width="30" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="OnVoiceNoteButtonClicked" ToolTip="Голосовое сообщение" Margin="2,0">
                            <TextBlock Text="🎙️" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <Button Width="32" Height="30" Background="{DynamicResource AccentBrush}" BorderThickness="0" Cursor="Hand" Command="{Binding SendMessageCommand}" ToolTip="Отправить" Margin="4,0,0,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="6" Background="{TemplateBinding Background}">
                                        <TextBlock Text="➤" FontSize="12" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
