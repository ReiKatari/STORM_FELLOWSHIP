<UserControl x:Class="StormFellowship.Views.Controls.FellowshipRailControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="64">
    <Grid Background="{DynamicResource RailBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Direct Messages / Home Button -->
        <Button Margin="0,10,0,6" Width="44" Height="44" Background="{DynamicResource AccentBrush}" BorderThickness="0" HorizontalAlignment="Center" Cursor="Hand" Command="{Binding SelectHomeCommand}" ToolTip="Личные сообщения">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="12" Background="{TemplateBinding Background}">
                        <TextBlock Text="⚡" FontSize="20" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- Divider -->
        <Border Grid.Row="1" Width="32" Height="2" Background="{DynamicResource DividerBrush}" HorizontalAlignment="Center" Margin="0,4" />

        <!-- Fellowship Guild List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Fellowships}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4" HorizontalAlignment="Center">
                            <!-- Indicator pill on active -->
                            <Border Width="4" Height="36" CornerRadius="2" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" Margin="-10,0,0,0" Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />

                            <Button Width="44" Height="44" BorderThickness="0" Cursor="Hand" Tag="{Binding}" Click="OnFellowshipClicked" ToolTip="{Binding Name}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="14" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                            <Grid>
                                                <TextBlock Text="🛡️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <!-- Unread badge -->
                                                <Border Width="16" Height="16" CornerRadius="8" Background="{DynamicResource StatusDndBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2" Visibility="{Binding UnreadCount, Converter={StaticResource NullToVis}}">
                                                    <TextBlock Text="{Binding UnreadCount}" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Add Fellowship (+) Button -->
        <Button Grid.Row="3" Margin="0,6,0,6" Width="44" Height="44" HorizontalAlignment="Center" Cursor="Hand" Command="{Binding CreateFellowshipCommand}" ToolTip="Создать или войти в содружество">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="22" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                        <TextBlock Text="+" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- User Settings (Gear) Button -->
        <Button Grid.Row="4" Margin="0,0,0,10" Width="44" Height="44" HorizontalAlignment="Center" Cursor="Hand" Command="{Binding OpenUserSettingsCommand}" ToolTip="Настройки пользователя">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="22" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                        <TextBlock Text="⚙" FontSize="18" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</UserControl>
