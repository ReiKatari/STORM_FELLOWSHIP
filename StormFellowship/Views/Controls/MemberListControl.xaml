<UserControl x:Class="StormFellowship.Views.Controls.MemberListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="220">
    <Grid Background="{DynamicResource SidebarBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="14,0">
            <TextBlock Text="{Binding HeaderText}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
        </Border>

        <!-- Member List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,10">
            <ItemsControl ItemsSource="{Binding Members}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,2" CornerRadius="8" Background="Transparent" Padding="6,5">
                            <!-- Context Menu for Member (Volume, Mute for me, Priority Speaker, E2EE) -->
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="💬 Написать сообщение" Command="{Binding DataContext.MessageMemberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <MenuItem Header="📞 Позвонить (Аудио)" Command="{Binding DataContext.CallMemberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <Separator />
                                    <MenuItem Header="🔇 Заглушить для меня" Command="{Binding DataContext.ToggleMuteForMeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <MenuItem Header="📢 Приоритетный голос" Command="{Binding DataContext.TogglePrioritySpeakerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <MenuItem Header="🔒 Проверить E2EE ключ" Command="{Binding DataContext.VerifyE2EECommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </ContextMenu>
                            </Border.ContextMenu>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Avatar with Voice Glow Effect -->
                                <Grid VerticalAlignment="Center">
                                    <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource AccentBrush}">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#00E5FF" BlurRadius="8" ShadowDepth="0" Opacity="0.45" />
                                        </Border.Effect>
                                        <TextBlock Text="{Binding AvatarGlyph}" FontSize="15" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Border Width="9" Height="9" CornerRadius="4.5" Background="{DynamicResource StatusOnlineBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" BorderBrush="{DynamicResource SidebarBackgroundBrush}" BorderThickness="1.5" />
                                </Grid>

                                <!-- User Name & Role Badge -->
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="100" />
                                        <!-- Role Badge Pill -->
                                        <Border Background="{Binding RoleColorHex, Converter={StaticResource HexToBrush}}" CornerRadius="4" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RoleName}" FontSize="8" FontWeight="Bold" Foreground="#FFFFFF" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding CustomStatus}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
