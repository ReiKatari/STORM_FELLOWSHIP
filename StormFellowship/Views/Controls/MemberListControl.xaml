<UserControl x:Class="StormFellowship.Views.Controls.MemberListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="220">
    <Grid Background="{DynamicResource SidebarBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="14,0">
            <TextBlock Text="{Binding HeaderText}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
        </Border>

        <!-- Member List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,10">
            <ItemsControl ItemsSource="{Binding Members}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Background="Transparent" BorderThickness="0" Margin="0,2" Padding="6,5" Cursor="Hand" HorizontalContentAlignment="Stretch"
                                Command="{Binding DataContext.MessageMemberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <!-- Context Menu for Member (Volume, Mute for me, Priority Speaker, E2EE, Role, Kick, Ban) -->
                            <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Написать личное сообщение" Command="{Binding PlacementTarget.Tag.MessageMemberCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="Позвонить (Голосовой вызов)" Command="{Binding PlacementTarget.Tag.CallMemberCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="Начать видеозвонок HD" Command="{Binding PlacementTarget.Tag.VideoCallMemberCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <Separator />
                                        <MenuItem Header="Заглушить для меня" Command="{Binding PlacementTarget.Tag.ToggleMuteForMeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="Приоритетный оратор" Command="{Binding PlacementTarget.Tag.TogglePrioritySpeakerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="Проверить E2EE ключ" Command="{Binding PlacementTarget.Tag.VerifyE2EECommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <Separator />
                                        <MenuItem Header="Исключить из содружества" Foreground="#F59E0B" Command="{Binding PlacementTarget.Tag.KickMemberCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="Заблокировать пользователя" Foreground="#EF4444" Command="{Binding PlacementTarget.Tag.BanMemberCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    </ContextMenu>
                            </Button.ContextMenu>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="MemberCard" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Avatar with Voice Glow Effect & Custom Image Support -->
                                            <Grid VerticalAlignment="Center">
                                                <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource IconGradCyan}" Visibility="{Binding HasCustomAvatarImage, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#00E5FF" BlurRadius="8" ShadowDepth="0" Opacity="0.45" />
                                                    </Border.Effect>
                                                    <Path Data="{Binding AvatarGlyph, Converter={StaticResource GeoKeyToGeo}}" Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <Border Width="32" Height="32" CornerRadius="16" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" Visibility="{Binding HasCustomAvatarImage, Converter={StaticResource BoolToVis}}">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#00E5FF" BlurRadius="8" ShadowDepth="0" Opacity="0.45" />
                                                    </Border.Effect>
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding AvatarPath}" Stretch="UniformToFill" />
                                                    </Border.Background>
                                                </Border>
                                                <Border Width="9" Height="9" CornerRadius="4.5" Background="{DynamicResource StatusOnlineBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" BorderBrush="{DynamicResource SidebarBackgroundBrush}" BorderThickness="1.5" />
                                            </Grid>

                                            <!-- User Name & Role Badge -->
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="100" />
                                                    <!-- Role Badge Pill -->
                                                    <Border Background="{Binding RoleColorHex, Converter={StaticResource HexToBrush}}" CornerRadius="4" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding RoleName}" FontSize="8" FontWeight="Bold" Foreground="#FFFFFF" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding CustomStatus}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="MemberCard" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
