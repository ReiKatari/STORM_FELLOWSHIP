<UserControl
    x:Class="StormFellowship.Views.Controls.MemberListControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:StormFellowship.Models"
    xmlns:helpers="using:StormFellowship.Helpers"
    mc:Ignorable="d">

    <UserControl.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis" />
        <helpers:HexToBrushConverter x:Key="HexToBrush" />
    </UserControl.Resources>

    <Grid Width="220" Background="{StaticResource SidebarBackgroundBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,14">
            <StackPanel Spacing="16">
                <!-- ONLINE SECTION -->
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="ONLINE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="—" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.OnlineMembers.Count, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.OnlineMembers, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:User">
                                <Button Background="Transparent" BorderThickness="0" Padding="6,4" CornerRadius="6" HorizontalAlignment="Stretch" Margin="0,1"
                                        Click="OnMemberClicked" Tag="{x:Bind}">
                                    <Button.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Send Direct Message" Click="OnSendDmClicked" Tag="{x:Bind}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8BD;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Start Direct Call" Click="OnStartCallClicked" Tag="{x:Bind}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE717;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Change Nickname">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Server Mute">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE720;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.ContextFlyout>
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Avatar & Status Dot -->
                                        <Grid Margin="0,0,8,0">
                                            <Border Width="30" Height="30" CornerRadius="15">
                                                <Image Source="{x:Bind AvatarPath}" Stretch="UniformToFill" Width="30" Height="30" />
                                            </Border>
                                            <Ellipse Width="8" Height="8" Fill="{x:Bind StatusBadgeColor, Converter={StaticResource HexToBrush}}"
                                                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Stroke="{StaticResource SidebarBackgroundBrush}" StrokeThickness="1" />
                                        </Grid>

                                        <!-- Member Name & Role -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="{x:Bind DisplayName}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <FontIcon Glyph="&#xE735;" FontSize="9" Foreground="{StaticResource AccentBrush}"
                                                          Visibility="{x:Bind IsSpeaking, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind CustomStatus}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- OFFLINE SECTION -->
                <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.OfflineMembers.Count, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="OFFLINE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="—" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.OfflineMembers.Count, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.OfflineMembers, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:User">
                                <Grid Margin="0,2" Opacity="0.6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,8,0">
                                        <Image Source="{x:Bind AvatarPath}" Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{x:Bind DisplayName}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
