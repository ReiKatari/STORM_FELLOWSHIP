<UserControl x:Class="StormFellowship.Views.Controls.CallOverlayControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Call Overlay Host (Full Grid Canvas with Mesh Ambient Glow) -->
    <Grid Background="{DynamicResource CallOverlayBackgroundBrush}">
        <!-- Dynamic Mesh Ambient Gradient Background -->
        <Border Opacity="0.18">
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.4" GradientOrigin="0.5,0.4" RadiusX="0.7" RadiusY="0.6">
                    <GradientStop Color="#00E5FF" Offset="0.0" />
                    <GradientStop Color="#A855F7" Offset="0.5" />
                    <GradientStop Color="Transparent" Offset="1.0" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- Main Call Container Card -->
        <Border CornerRadius="20" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1.5"
                Margin="24,16" Padding="0">
            <Border.Effect>
                <DropShadowEffect Color="#00A3FF" BlurRadius="30" ShadowDepth="0" Opacity="0.25" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 1. Top Call Header (Title, Connection Quality Sparkline, Volume, E2EE Shield) -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="20,0" CornerRadius="20,20,0,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Call Title & Security Indicator -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CallTitle}" FontWeight="Black" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Border Width="1" Height="14" Background="{DynamicResource DividerBrush}" Margin="12,0" VerticalAlignment="Center" />
                            
                            <!-- E2EE Link Button -->
                            <Button Command="{Binding OpenE2EEDialogCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Проверить E2EE ключи">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource GeoShieldLock}" Fill="{DynamicResource StatusOnlineBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="🔒 E2EE Защищено" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource StatusOnlineBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Live Network Sparkline Micro-Chart -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="Пинг:" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Border Width="100" Height="22" Background="{DynamicResource InputBackgroundBrush}" CornerRadius="4" Padding="2">
                                <Polyline Points="{Binding SparklinePoints}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>

                        <!-- Volume Slider -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoSpeaker}" Fill="{DynamicResource TextSecondaryBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <Slider Width="90" Minimum="0" Maximum="200" Value="{Binding CallVolume}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CallVolume, StringFormat='{}{0:0}%'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. Middle Participant Avatars Stage & 32-Band FFT Spectrum Analyzer -->
                <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Avatars Row with Dynamic Glowing Voice Pulse -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
                            <!-- Remote Participant Card with Glow -->
                            <Border CornerRadius="18" Background="{DynamicResource InputBackgroundBrush}" Padding="20,16" Margin="14,0" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1.5">
                                <Border.Effect>
                                    <DropShadowEffect Color="#00E5FF" BlurRadius="{Binding RemoteGlowRadius}" ShadowDepth="0" Opacity="0.8" />
                                </Border.Effect>
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="80" Height="80" CornerRadius="40" Background="{DynamicResource AccentBrush}" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding RemoteAvatarGlyph}" FontSize="38" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding RemoteDisplayName}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding RemoteCustomStatus}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Local Participant Card with Glow -->
                            <Border CornerRadius="18" Background="{DynamicResource InputBackgroundBrush}" Padding="20,16" Margin="14,0" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1.5">
                                <Border.Effect>
                                    <DropShadowEffect Color="#10B981" BlurRadius="{Binding LocalGlowRadius}" ShadowDepth="0" Opacity="0.8" />
                                </Border.Effect>
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="80" Height="80" CornerRadius="40" Background="{DynamicResource AccentMutedBrush}" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding LocalAvatarGlyph}" FontSize="38" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding LocalDisplayName}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Вы (Локальный голос)" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 32-Band FFT Spectrum Analyzer Bars -->
                        <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="12" Padding="14,10" HorizontalAlignment="Center" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="32-BAND FFT SPECTRUM ANALYZER" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding SpectrumBands}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="6" Height="{Binding}" Margin="2,0" VerticalAlignment="Bottom" CornerRadius="3" Background="{DynamicResource AccentBrush}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- 3. Floating Call Control Pill Bar with Vector Icons -->
                <Border Grid.Row="2" Background="{DynamicResource CallControlBarBackgroundBrush}"
                        CornerRadius="24" Padding="16,8" HorizontalAlignment="Center" Margin="0,0,0,12"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <!-- Mic Button -->
                        <Button Width="44" Height="44" Background="{DynamicResource CallControlButtonBrush}" BorderThickness="0" Cursor="Hand" Command="{Binding ToggleMuteCommand}" ToolTip="Микрофон" Margin="4,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="22" Background="{TemplateBinding Background}">
                                        <Path Data="{StaticResource GeoMic}" Fill="{Binding IsMicMuted, Converter={StaticResource BoolToMutedColor}}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Sound Button -->
                        <Button Width="44" Height="44" Background="{DynamicResource CallControlButtonBrush}" BorderThickness="0" Cursor="Hand" Command="{Binding ToggleDeafenCommand}" ToolTip="Звук" Margin="4,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="22" Background="{TemplateBinding Background}">
                                        <Path Data="{StaticResource GeoHeadphones}" Fill="{Binding IsDeafened, Converter={StaticResource BoolToMutedColor}}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Video Camera Toggle -->
                        <Button Width="44" Height="44" Background="{DynamicResource CallControlButtonBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" Cursor="Hand" Command="{Binding ToggleVideoCommand}" ToolTip="Камера" Margin="4,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                        <Path Data="{StaticResource GeoVideo}" Fill="{DynamicResource AccentBrush}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Screen Share Toggle -->
                        <Button Width="44" Height="44" Background="{DynamicResource CallControlButtonBrush}" BorderThickness="0" Cursor="Hand" Command="{Binding ToggleScreenShareCommand}" ToolTip="Демонстрация экрана" Margin="4,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="12" Background="{TemplateBinding Background}">
                                        <Path Data="{StaticResource GeoScreenShare}" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- End Call (Red Pill) -->
                        <Button Width="52" Height="44" Background="{DynamicResource CallEndButtonBrush}" BorderThickness="0" Cursor="Hand" Command="{Binding EndCallCommand}" ToolTip="Завершить вызов" Margin="8,0,0,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="22" Background="{TemplateBinding Background}">
                                        <Path Data="{StaticResource GeoPhoneEnd}" Fill="#FFFFFF" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 4. Bottom Status Pill -->
                <Border Grid.Row="3" Background="{DynamicResource CallOverlayPillBrush}" CornerRadius="12"
                        Padding="14,5" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource StatusOnlineBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding BottomCallStatus}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
