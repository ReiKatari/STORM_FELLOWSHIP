<UserControl
    x:Class="StormFellowship.Views.Controls.CallOverlayControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:StormFellowship.Models"
    xmlns:helpers="using:StormFellowship.Helpers"
    mc:Ignorable="d">

    <UserControl.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis" />
        <helpers:NullToVisibilityConverter x:Key="NullToVis" />
        <helpers:HexToBrushConverter x:Key="HexToBrush" />
    </UserControl.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}" Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Title (Matching Reference Banner) -->
        <TextBlock Text="{x:Bind ViewModel.ActiveCall.Title, Mode=OneWay}"
                   FontSize="34" FontWeight="Black"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   HorizontalAlignment="Center" Margin="0,0,0,16" />

        <!-- Main Call Stage Card (Matching Screenshot) -->
        <Border Grid.Row="1" Background="{StaticResource CallContainerBackgroundBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                CornerRadius="16" MaxWidth="920" MinHeight="360"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Card Header: User status & More options -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="14">
                            <Image Source="{x:Bind ViewModel.ActiveCall.RemoteUser.AvatarPath, Mode=OneWay}" Stretch="UniformToFill" />
                        </Border>
                        <TextBlock Text="{x:Bind ViewModel.ActiveCall.RemoteUser.DisplayName, Mode=OneWay}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.ActiveCall.RemoteUser.CustomStatus, Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- More options ... button -->
                    <Button Grid.Column="1" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6">
                        <FontIcon Glyph="&#xE712;" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Button>
                </Grid>

                <!-- Center Stage: Sakura + Waveform + You -->
                <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,20">
                    <StackPanel Orientation="Horizontal" Spacing="40" VerticalAlignment="Center">

                        <!-- Remote Participant (Sakura) -->
                        <StackPanel HorizontalAlignment="Center" Spacing="10">
                            <!-- Avatar with animated glowing speaking ring -->
                            <Grid Width="110" Height="110">
                                <!-- Outer Pulsing Ring -->
                                <Ellipse Width="110" Height="110" Stroke="{StaticResource CallAvatarSpeakingRingBrush}" StrokeThickness="3"
                                         Visibility="{x:Bind ViewModel.ActiveCall.IsRemoteSpeaking, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                
                                <!-- Avatar Picture -->
                                <Border Width="96" Height="96" CornerRadius="48" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="2">
                                    <Image Source="{x:Bind ViewModel.ActiveCall.RemoteUser.AvatarPath, Mode=OneWay}" Stretch="UniformToFill" Width="96" Height="96" />
                                </Border>
                            </Grid>

                            <TextBlock Text="{x:Bind ViewModel.ActiveCall.RemoteUser.DisplayName, Mode=OneWay}" FontWeight="Bold" FontSize="14"
                                       Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Middle Indicator: Dynamic Audio Waveform & Timer -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                            <!-- Equalizer Audio Waveform Bars (7 Bars) -->
                            <StackPanel Orientation="Horizontal" Spacing="3" Height="36" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border Width="3" Height="{x:Bind ViewModel.Bar1Height, Mode=OneWay}" CornerRadius="1.5" Background="{StaticResource CallWaveformActiveBrush}" VerticalAlignment="Center" />
                                <Border Width="3" Height="{x:Bind ViewModel.Bar2Height, Mode=OneWay}" CornerRadius="1.5" Background="{StaticResource CallWaveformActiveBrush}" VerticalAlignment="Center" />
                                <Border Width="3" Height="{x:Bind ViewModel.Bar3Height, Mode=OneWay}" CornerRadius="1.5" Background="{StaticResource CallWaveformActiveBrush}" VerticalAlignment="Center" />
                                <Border Width="3" Height="{x:Bind ViewModel.Bar4Height, Mode=OneWay}" CornerRadius="1.5" Background="{StaticResource CallWaveformActiveBrush}" VerticalAlignment="Center" />
                                <Border Width="3" Height="{x:Bind ViewModel.Bar5Height, Mode=OneWay}" CornerRadius="1.5" Background="{StaticResource CallWaveformActiveBrush}" VerticalAlignment="Center" />
                                <Border Width="3" Height="{x:Bind ViewModel.Bar6Height, Mode=OneWay}" CornerRadius="1.5" Background="{StaticResource CallWaveformActiveBrush}" VerticalAlignment="Center" />
                                <Border Width="3" Height="{x:Bind ViewModel.Bar7Height, Mode=OneWay}" CornerRadius="1.5" Background="{StaticResource CallWaveformActiveBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="{x:Bind ViewModel.ActiveCall.DurationFormatted, Mode=OneWay}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Local Participant (You) -->
                        <StackPanel HorizontalAlignment="Center" Spacing="10">
                            <!-- Avatar -->
                            <Grid Width="110" Height="110">
                                <!-- Outer Pulsing Ring -->
                                <Ellipse Width="110" Height="110" Stroke="{StaticResource CallAvatarSpeakingRingBrush}" StrokeThickness="3"
                                         Visibility="{x:Bind ViewModel.ActiveCall.IsLocalSpeaking, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                                <Border Width="96" Height="96" CornerRadius="48" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="2">
                                    <Image Source="{x:Bind ViewModel.ActiveCall.LocalUser.AvatarPath, Mode=OneWay}" Stretch="UniformToFill" Width="96" Height="96" />
                                </Border>
                            </Grid>

                            <TextBlock Text="{x:Bind ViewModel.ActiveCall.LocalUser.DisplayName, Mode=OneWay}" FontWeight="Bold" FontSize="14"
                                       Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>

                    </StackPanel>
                </Grid>

                <!-- Floating Control Pill Bar (Matching Screenshot) -->
                <Border Grid.Row="2" Background="{StaticResource CallControlBarBackgroundBrush}"
                        CornerRadius="24" Padding="14,8" HorizontalAlignment="Center" Margin="0,0,0,16"
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <!-- Mic Button with Dropdown -->
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button ToolTipService.ToolTip="Mute / Unmute Microphone" Width="40" Height="40" CornerRadius="20"
                                    Background="{StaticResource CallControlButtonBrush}" BorderThickness="0"
                                    Command="{x:Bind ViewModel.ToggleMuteCommand}">
                                <FontIcon Glyph="&#xE720;" FontSize="15"
                                          Foreground="{x:Bind ViewModel.ActiveCall.IsMicMuted, Mode=OneWay, Converter={StaticResource BoolToMutedColor}}" />
                            </Button>
                            <Button Width="18" Height="40" Padding="0" Background="Transparent" BorderThickness="0">
                                <FontIcon Glyph="&#xE70D;" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                            </Button>
                        </StackPanel>

                        <!-- Sound / Deafen Button with Dropdown -->
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button ToolTipService.ToolTip="Deafen / Undeafen Audio" Width="40" Height="40" CornerRadius="20"
                                    Background="{StaticResource CallControlButtonBrush}" BorderThickness="0"
                                    Command="{x:Bind ViewModel.ToggleDeafenCommand}">
                                <FontIcon Glyph="&#xE74F;" FontSize="15"
                                          Foreground="{x:Bind ViewModel.ActiveCall.IsDeafened, Mode=OneWay, Converter={StaticResource BoolToMutedColor}}" />
                            </Button>
                            <Button Width="18" Height="40" Padding="0" Background="Transparent" BorderThickness="0">
                                <FontIcon Glyph="&#xE70D;" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                            </Button>
                        </StackPanel>

                        <!-- Camera Toggle Button -->
                        <Button ToolTipService.ToolTip="Toggle Camera" Width="40" Height="40" CornerRadius="8"
                                Background="{StaticResource CallControlButtonBrush}" BorderThickness="1"
                                BorderBrush="{StaticResource CallWaveformActiveBrush}"
                                Command="{x:Bind ViewModel.ToggleVideoCommand}">
                            <FontIcon Glyph="&#xE714;" FontSize="15" Foreground="{StaticResource CallWaveformActiveBrush}" />
                        </Button>

                        <!-- Screen Share Toggle Button -->
                        <Button ToolTipService.ToolTip="Share Screen" Width="40" Height="40" CornerRadius="8"
                                Background="{StaticResource CallControlButtonBrush}" BorderThickness="0"
                                Command="{x:Bind ViewModel.ToggleScreenShareCommand}">
                            <FontIcon Glyph="&#xE7EE;" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Button>

                        <!-- End Call Button (Red) -->
                        <Button ToolTipService.ToolTip="End Call" Width="44" Height="40" CornerRadius="20"
                                Background="{StaticResource CallEndButtonBrush}" BorderThickness="0"
                                Command="{x:Bind ViewModel.EndCallCommand}">
                            <FontIcon Glyph="&#xE717;" FontSize="15" Foreground="#FFFFFF" />
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Bottom Status Pill (Matching Screenshot: "🟢 Call ongoing • 13:37") -->
                <Border Grid.Row="3" Background="{StaticResource CallOverlayPillBrush}" CornerRadius="12"
                        Padding="14,4" HorizontalAlignment="Center" Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource StatusOnlineBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.ActiveCall.BottomCallStatus, Mode=OneWay}"
                                   FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource StatusOnlineBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Bottom Sub-banner Footer -->
        <TextBlock Grid.Row="2" Text="STORM FELLOWSHIP LOW-LATENCY DIRECT AUDIO"
                   FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                   HorizontalAlignment="Center" Margin="0,16,0,0" />
    </Grid>
</UserControl>
