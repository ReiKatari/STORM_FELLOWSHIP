<UserControl x:Class="StormFellowship.Views.Controls.CallOverlayControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Title & Connection Stats Banner -->
        <StackPanel HorizontalAlignment="Center" Margin="0,16,0,12">
            <TextBlock Text="{Binding CallTitle}"
                       FontSize="26" FontWeight="Black"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding ConnectionStats}"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}"
                       HorizontalAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Main Call Stage Card -->
        <Border Grid.Row="1" Background="{DynamicResource CallContainerBackgroundBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                CornerRadius="16" MaxWidth="960" MinHeight="420"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="30,0,30,0" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Card Header (Participant Info + Volume Slider with Pill) -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource AccentBrush}" Margin="0,0,10,0">
                            <TextBlock Text="{Binding RemoteAvatarGlyph}" FontSize="16" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding RemoteDisplayName}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding RemoteCustomStatus}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Beautiful Volume Slider with Separator and Pill Badge -->
                    <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="20" Padding="12,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔊" FontSize="12" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Slider Width="120" Minimum="0" Maximum="200" Value="{Binding CallVolume}" VerticalAlignment="Center" />
                            <Border Background="{DynamicResource AccentMutedBrush}" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                                <TextBlock Text="{Binding CallVolume, StringFormat='{}{0:0}%'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <Separator Grid.Row="0" VerticalAlignment="Bottom" Background="{DynamicResource DividerBrush}" Margin="0,8,0,0" />

                <!-- Center Stage: Audio Waveform View OR Video Cameras View OR Screen Share View -->
                <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,16,0,16">

                    <!-- 1. AUDIO CALL VIEW (Shown when neither Video nor ScreenShare is active) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsVideoOn, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">

                        <!-- Remote Participant -->
                        <StackPanel HorizontalAlignment="Center" Width="150">
                            <Grid Width="112" Height="112" HorizontalAlignment="Center">
                                <Ellipse Width="112" Height="112" Stroke="{DynamicResource CallAvatarSpeakingRingBrush}" StrokeThickness="3"
                                         Visibility="{Binding IsRemoteSpeaking, Converter={StaticResource BoolToVis}}" />
                                <Border Width="96" Height="96" CornerRadius="48" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding RemoteAvatarGlyph}" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding RemoteDisplayName}" FontWeight="Bold" FontSize="14"
                                       Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>

                        <!-- Middle Dynamic Audio Waveform (7 Bars) & Timer -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="36,0" Width="120">
                            <StackPanel Orientation="Horizontal" Height="40" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border Width="4" Height="{Binding Bar1Height}" CornerRadius="2" Background="{DynamicResource CallWaveformActiveBrush}" VerticalAlignment="Center" Margin="2,0" />
                                <Border Width="4" Height="{Binding Bar2Height}" CornerRadius="2" Background="{DynamicResource CallWaveformActiveBrush}" VerticalAlignment="Center" Margin="2,0" />
                                <Border Width="4" Height="{Binding Bar3Height}" CornerRadius="2" Background="{DynamicResource CallWaveformActiveBrush}" VerticalAlignment="Center" Margin="2,0" />
                                <Border Width="4" Height="{Binding Bar4Height}" CornerRadius="2" Background="{DynamicResource CallWaveformActiveBrush}" VerticalAlignment="Center" Margin="2,0" />
                                <Border Width="4" Height="{Binding Bar5Height}" CornerRadius="2" Background="{DynamicResource CallWaveformActiveBrush}" VerticalAlignment="Center" Margin="2,0" />
                                <Border Width="4" Height="{Binding Bar6Height}" CornerRadius="2" Background="{DynamicResource CallWaveformActiveBrush}" VerticalAlignment="Center" Margin="2,0" />
                                <Border Width="4" Height="{Binding Bar7Height}" CornerRadius="2" Background="{DynamicResource CallWaveformActiveBrush}" VerticalAlignment="Center" Margin="2,0" />
                            </StackPanel>

                            <TextBlock Text="{Binding DurationFormatted}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>

                        <!-- Local Participant (You) -->
                        <StackPanel HorizontalAlignment="Center" Width="150">
                            <Grid Width="112" Height="112" HorizontalAlignment="Center">
                                <Ellipse Width="112" Height="112" Stroke="{DynamicResource CallAvatarSpeakingRingBrush}" StrokeThickness="3"
                                         Visibility="{Binding IsLocalSpeaking, Converter={StaticResource BoolToVis}}" />
                                <Border Width="96" Height="96" CornerRadius="48" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LocalAvatarGlyph}" FontSize="42" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding LocalDisplayName}" FontWeight="Bold" FontSize="14"
                                       Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 2. VIDEO STREAM STAGE (Shown when Camera is active) -->
                    <Grid Visibility="{Binding IsVideoOn, Converter={StaticResource BoolToVis}}" Width="680" Height="260">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Remote Camera Feed Card -->
                        <Border Grid.Column="0" Background="#060A14" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" CornerRadius="12" Margin="6" Padding="12">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding RemoteAvatarGlyph}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding RemoteDisplayName}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="📹 HD 1080p 60 FPS" FontSize="10" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>
                                <Border Background="#D900E5FF" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <TextBlock Text="LIVE" FontSize="9" FontWeight="Bold" Foreground="#000000" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Local Camera Feed Card (You) -->
                        <Border Grid.Column="1" Background="#060A14" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" CornerRadius="12" Margin="6" Padding="12">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding LocalAvatarGlyph}" FontSize="28" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding LocalDisplayName}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="📹 Ваша веб-камера" FontSize="10" Foreground="{DynamicResource StatusOnlineBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>
                                <Border Background="#D922C55E" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <TextBlock Text="YOU" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 3. SCREEN SHARE STAGE (Shown when Screen Sharing is active) -->
                    <Border Visibility="{Binding IsScreenSharing, Converter={StaticResource BoolToVis}}" Background="#050812" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="12" Width="680" Height="260" Padding="16">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="🖥️" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                <TextBlock Text="Трансляция рабочего стола активна" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="Передача видеопотока 1920x1080 @ 60 FPS • Сверхнизкая задержка" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                            <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBlock Text="SCREEN STREAM" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Floating Call Control Pill Bar -->
                <Border Grid.Row="2" Background="{DynamicResource CallControlBarBackgroundBrush}"
                        CornerRadius="24" Padding="14,8" HorizontalAlignment="Center" Margin="0,0,0,12"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <!-- Mic Button -->
                        <Button Width="44" Height="44" Background="{DynamicResource CallControlButtonBrush}" BorderThickness="0" Cursor="Hand" Command="{Binding ToggleMuteCommand}" ToolTip="Микрофон" Margin="4,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="22" Background="{TemplateBinding Background}">
                                        <TextBlock Text="{Binding IsMicMuted, Converter={StaticResource BoolToMicIcon}}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Sound Button -->
                        <Button Width="44" Height="44" Background="{DynamicResource CallControlButtonBrush}" BorderThickness="0" Cursor="Hand" Command="{Binding ToggleDeafenCommand}" ToolTip="Звук" Margin="4,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="22" Background="{TemplateBinding Background}">
                                        <TextBlock Text="{Binding IsDeafened, Converter={StaticResource BoolToSoundIcon}}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Video Camera Toggle -->
                        <Button Width="44" Height="44" Background="{DynamicResource CallControlButtonBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" Cursor="Hand" Command="{Binding ToggleVideoCommand}" ToolTip="Камера" Margin="4,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                        <TextBlock Text="📹" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Screen Share Toggle -->
                        <Button Width="44" Height="44" Background="{DynamicResource CallControlButtonBrush}" BorderThickness="0" Cursor="Hand" Command="{Binding ToggleScreenShareCommand}" ToolTip="Демонстрация экрана" Margin="4,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="10" Background="{TemplateBinding Background}">
                                        <TextBlock Text="🖥️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- End Call (Red Pill) -->
                        <Button Width="52" Height="44" Background="{DynamicResource CallEndButtonBrush}" BorderThickness="0" Cursor="Hand" Command="{Binding EndCallCommand}" ToolTip="Завершить вызов" Margin="8,0,0,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="22" Background="{TemplateBinding Background}">
                                        <TextBlock Text="📵" FontSize="18" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Bottom Status Pill -->
                <Border Grid.Row="3" Background="{DynamicResource CallOverlayPillBrush}" CornerRadius="12"
                        Padding="14,5" HorizontalAlignment="Center" Margin="0,0,0,2">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource StatusOnlineBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding BottomCallStatus}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource StatusOnlineBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Bottom Subtitle Footer -->
        <TextBlock Grid.Row="2" Text="НИЗКАЯ ЗАДЕРЖКА ЗВУКА STORM FELLOWSHIP"
                   FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                   HorizontalAlignment="Center" Margin="0,14,0,16" />
    </Grid>
</UserControl>
