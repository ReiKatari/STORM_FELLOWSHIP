<UserControl x:Class="StormFellowship.Views.Controls.CallOverlayControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Title Banner -->
        <TextBlock Text="{Binding CallTitle}"
                   FontSize="28" FontWeight="Black"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   HorizontalAlignment="Center" Margin="0,20,0,16" />

        <!-- Main Call Stage Card -->
        <Border Grid.Row="1" Background="{DynamicResource CallContainerBackgroundBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                CornerRadius="16" MaxWidth="920" MinHeight="360"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="30,0,30,0" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Card Header -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentBrush}" Margin="0,0,10,0">
                            <TextBlock Text="👤" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding RemoteDisplayName}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding RemoteCustomStatus}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>

                    <!-- More options -->
                    <Button Grid.Column="1" Width="32" Height="32" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Параметры">
                        <TextBlock Text="•••" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </Grid>

                <!-- Center Stage: Remote User + Equalizer Waveform + Local User -->
                <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,16,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- Remote Participant -->
                        <StackPanel HorizontalAlignment="Center" Width="130">
                            <!-- Avatar with animated glowing speaking ring -->
                            <Grid Width="106" Height="106" HorizontalAlignment="Center">
                                <Ellipse Width="106" Height="106" Stroke="{DynamicResource CallAvatarSpeakingRingBrush}" StrokeThickness="3"
                                         Visibility="{Binding IsRemoteSpeaking, Converter={StaticResource BoolToVis}}" />
                                <Border Width="92" Height="92" CornerRadius="46" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="👤" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding RemoteDisplayName}" FontWeight="Bold" FontSize="14"
                                       Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>

                        <!-- Middle Dynamic Audio Waveform (7 Bars) & Timer -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40,0" Width="100">
                            <StackPanel Orientation="Horizontal" Height="36" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border Width="3" Height="{Binding Bar1Height}" CornerRadius="1.5" Background="{DynamicResource CallWaveformActiveBrush}" VerticalAlignment="Center" Margin="2,0" />
                                <Border Width="3" Height="{Binding Bar2Height}" CornerRadius="1.5" Background="{DynamicResource CallWaveformActiveBrush}" VerticalAlignment="Center" Margin="2,0" />
                                <Border Width="3" Height="{Binding Bar3Height}" CornerRadius="1.5" Background="{DynamicResource CallWaveformActiveBrush}" VerticalAlignment="Center" Margin="2,0" />
                                <Border Width="3" Height="{Binding Bar4Height}" CornerRadius="1.5" Background="{DynamicResource CallWaveformActiveBrush}" VerticalAlignment="Center" Margin="2,0" />
                                <Border Width="3" Height="{Binding Bar5Height}" CornerRadius="1.5" Background="{DynamicResource CallWaveformActiveBrush}" VerticalAlignment="Center" Margin="2,0" />
                                <Border Width="3" Height="{Binding Bar6Height}" CornerRadius="1.5" Background="{DynamicResource CallWaveformActiveBrush}" VerticalAlignment="Center" Margin="2,0" />
                                <Border Width="3" Height="{Binding Bar7Height}" CornerRadius="1.5" Background="{DynamicResource CallWaveformActiveBrush}" VerticalAlignment="Center" Margin="2,0" />
                            </StackPanel>

                            <TextBlock Text="{Binding DurationFormatted}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>

                        <!-- Local Participant (You) -->
                        <StackPanel HorizontalAlignment="Center" Width="130">
                            <!-- Avatar with animated glowing speaking ring -->
                            <Grid Width="106" Height="106" HorizontalAlignment="Center">
                                <Ellipse Width="106" Height="106" Stroke="{DynamicResource CallAvatarSpeakingRingBrush}" StrokeThickness="3"
                                         Visibility="{Binding IsLocalSpeaking, Converter={StaticResource BoolToVis}}" />
                                <Border Width="92" Height="92" CornerRadius="46" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="⚡" FontSize="42" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding LocalDisplayName}" FontWeight="Bold" FontSize="14"
                                       Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>

                    </StackPanel>
                </Grid>

                <!-- Floating Call Control Pill Bar -->
                <Border Grid.Row="2" Background="{DynamicResource CallControlBarBackgroundBrush}"
                        CornerRadius="24" Padding="14,8" HorizontalAlignment="Center" Margin="0,0,0,16"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <!-- Mic Button -->
                        <Button Width="42" Height="42" Background="{DynamicResource CallControlButtonBrush}" BorderThickness="0" Cursor="Hand" Command="{Binding ToggleMuteCommand}" ToolTip="Микрофон" Margin="3,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="21" Background="{TemplateBinding Background}">
                                        <TextBlock Text="🎤" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Sound Button -->
                        <Button Width="42" Height="42" Background="{DynamicResource CallControlButtonBrush}" BorderThickness="0" Cursor="Hand" Command="{Binding ToggleDeafenCommand}" ToolTip="Звук" Margin="3,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="21" Background="{TemplateBinding Background}">
                                        <TextBlock Text="🎧" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Video Camera Toggle -->
                        <Button Width="42" Height="42" Background="{DynamicResource CallControlButtonBrush}" BorderBrush="{DynamicResource CallWaveformActiveBrush}" BorderThickness="1.5" Cursor="Hand" Command="{Binding ToggleVideoCommand}" ToolTip="Камера" Margin="3,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                        <TextBlock Text="📹" FontSize="16" Foreground="{DynamicResource CallWaveformActiveBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Screen Share Toggle -->
                        <Button Width="42" Height="42" Background="{DynamicResource CallControlButtonBrush}" BorderThickness="0" Cursor="Hand" Command="{Binding ToggleScreenShareCommand}" ToolTip="Демонстрация экрана" Margin="3,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                        <TextBlock Text="🖥" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- End Call (Red Pill) -->
                        <Button Width="48" Height="42" Background="{DynamicResource CallEndButtonBrush}" BorderThickness="0" Cursor="Hand" Command="{Binding EndCallCommand}" ToolTip="Завершить вызов" Margin="6,0,0,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="21" Background="{TemplateBinding Background}">
                                        <TextBlock Text="📵" FontSize="16" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Bottom Status Pill ("🟢 Вызов активен • 00:00") -->
                <Border Grid.Row="3" Background="{DynamicResource CallOverlayPillBrush}" CornerRadius="12"
                        Padding="14,5" HorizontalAlignment="Center" Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource StatusOnlineBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding BottomCallStatus}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource StatusOnlineBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Bottom Subtitle Footer -->
        <TextBlock Grid.Row="2" Text="НИЗКАЯ ЗАДЕРЖКА ЗВУКА STORM"
                   FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                   HorizontalAlignment="Center" Margin="0,16,0,20" />
    </Grid>
</UserControl>
