<UserControl x:Class="StormFellowship.Views.Controls.ChannelSidebarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="240">
    <Grid Background="{DynamicResource SidebarBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="58" />
        </Grid.RowDefinitions>

        <!-- Sidebar Header (Fellowship Title or Direct Messages) -->
        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="14,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding FellowshipTitle}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                <!-- Action buttons (Create Channel, Fellowship Settings) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Command="{Binding OpenCreateChannelCommand}" ToolTip="Создать канал" Margin="0,0,2,0">
                        <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource CardHoverBrush}">
                            <TextBlock Text="+" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                        </Border>
                    </Button>
                    <Button Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Command="{Binding OpenFellowshipSettingsCommand}" ToolTip="Настройки содружества">
                        <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource CardHoverBrush}">
                            <Path Data="{StaticResource GeoGear}" Fill="{DynamicResource TextSecondaryBrush}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Channels & DM Scroll List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,10">
            <StackPanel>
                <!-- IF IN HOME/DM MODE: DIRECT MESSAGES LIST -->
                <StackPanel Visibility="{Binding IsInDmMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="ЛИЧНЫЕ СООБЩЕНИЯ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="8,4,0,8" />

                    <ItemsControl ItemsSource="{Binding DmUsers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,2" CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}" Padding="8,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Avatar with status dot -->
                                        <Grid VerticalAlignment="Center">
                                            <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource AccentBrush}">
                                                <TextBlock Text="{Binding AvatarGlyph}" FontSize="15" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource StatusOnlineBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" BorderBrush="{DynamicResource SidebarBackgroundBrush}" BorderThickness="1.5" />
                                        </Grid>

                                        <!-- User info -->
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding CustomStatus}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- Direct Call Button -->
                                        <Button Grid.Column="2" Width="28" Height="28" Background="{DynamicResource AccentBrush}" BorderThickness="0" Cursor="Hand" Tag="{Binding}" Click="OnDirectCallButtonClicked" ToolTip="Начать прямой вызов">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border CornerRadius="14" Background="{TemplateBinding Background}">
                                                        <Path Data="{StaticResource GeoSpeaker}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- IF IN FELLOWSHIP MODE: CATEGORIES & CHANNELS -->
                <StackPanel Visibility="{Binding IsInFellowshipMode, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4,0,8">
                                    <!-- Category Header with + Button -->
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Padding="6,2" Cursor="Hand" Tag="{Binding}" Click="OnCategoryHeaderClicked">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="▾ " FontSize="10" Foreground="{DynamicResource AccentBrush}" />
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Width="20" Height="20" Background="Transparent" BorderThickness="0" Cursor="Hand" Tag="{Binding}" Click="OnAddChannelToCategoryClicked" ToolTip="Добавить канал в категорию">
                                            <TextBlock Text="+" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                    </Grid>

                                    <!-- Channels -->
                                    <ItemsControl ItemsSource="{Binding Channels}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Margin="0,1" Padding="8,6" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Cursor="Hand" Tag="{Binding}" Click="OnChannelClicked">
                                                    <!-- Right-Click Context Menu -->
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="✏️ Настройка канала" Tag="{Binding}" Click="OnContextEditChannelClicked" />
                                                            <Separator />
                                                            <MenuItem Header="🗑️ Удалить канал" Foreground="#EF4444" Tag="{Binding}" Click="OnContextDeleteChannelClicked" />
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- Channel Icon -->
                                                                    <TextBlock Text="{Binding IconGlyph}" FontSize="13" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />

                                                                    <!-- Channel Name -->
                                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                                                    <!-- Bitrate or unread badge -->
                                                                    <TextBlock Grid.Column="2" Text="{Binding BitrateDisplay}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                                                </Grid>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom User Bar (Avatar + Name + Status + Mic/Headphone/Settings Toggles) -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="10,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Avatar -->
                <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource AccentBrush}">
                    <TextBlock Text="{Binding CurrentUser.AvatarGlyph}" FontSize="16" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Name & Status -->
                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentUser.DisplayName}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding CurrentUser.CustomStatus}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Controls with Vector Glyphs -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <!-- Mic Button -->
                    <Button Width="28" Height="28" Margin="1,0" Background="Transparent" BorderThickness="0" Cursor="Hand" Command="{Binding ToggleMuteCommand}" ToolTip="{Binding MicTooltip}">
                        <Border Width="26" Height="26" CornerRadius="6" Background="{DynamicResource CardHoverBrush}">
                            <Path Data="{StaticResource GeoMic}" Fill="{Binding IsMicMuted, Converter={StaticResource BoolToMutedColor}}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Button>

                    <!-- Headphones Button -->
                    <Button Width="28" Height="28" Margin="1,0" Background="Transparent" BorderThickness="0" Cursor="Hand" Command="{Binding ToggleDeafenCommand}" ToolTip="{Binding SoundTooltip}">
                        <Border Width="26" Height="26" CornerRadius="6" Background="{DynamicResource CardHoverBrush}">
                            <Path Data="{StaticResource GeoHeadphones}" Fill="{Binding IsDeafened, Converter={StaticResource BoolToMutedColor}}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Button>

                    <!-- Settings Button -->
                    <Button Width="28" Height="28" Margin="1,0" Background="Transparent" BorderThickness="0" Cursor="Hand" Command="{Binding OpenUserSettingsCommand}" ToolTip="Настройки пользователя">
                        <Border Width="26" Height="26" CornerRadius="6" Background="{DynamicResource CardHoverBrush}">
                            <Path Data="{StaticResource GeoGear}" Fill="{DynamicResource TextSecondaryBrush}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
