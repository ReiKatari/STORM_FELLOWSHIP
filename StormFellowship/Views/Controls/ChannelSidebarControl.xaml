<UserControl x:Class="StormFellowship.Views.Controls.ChannelSidebarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="240">
    <Grid Background="{DynamicResource SidebarBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="54" />
        </Grid.RowDefinitions>

        <!-- Sidebar Header (Fellowship Title or Direct Messages) -->
        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="14,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding FellowshipTitle}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                <!-- Action buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Width="26" Height="26" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="OnCreateChannelClicked" ToolTip="Создать канал">
                        <TextBlock Text="+" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button Width="26" Height="26" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="OnServerSettingsClicked" ToolTip="Настройки содружества">
                        <TextBlock Text="⚙" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Channels & DM Scroll List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,10">
            <StackPanel>
                <!-- IF IN HOME/DM MODE: DIRECT MESSAGES LIST -->
                <StackPanel Visibility="{Binding IsInDmMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="ЛИЧНЫЕ СООБЩЕНИЯ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="8,4,0,8" />

                    <ItemsControl ItemsSource="{Binding DmUsers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,2" CornerRadius="8" Background="{DynamicResource CardBackgroundBrush}" Padding="8,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Avatar with status dot -->
                                        <Grid VerticalAlignment="Center">
                                            <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource InputBackgroundBrush}">
                                                <TextBlock Text="👤" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource StatusOnlineBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" BorderBrush="{DynamicResource SidebarBackgroundBrush}" BorderThickness="1.5" />
                                        </Grid>

                                        <!-- User info -->
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding CustomStatus}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- Direct Call Button (Phone icon) -->
                                        <Button Grid.Column="2" Width="28" Height="28" Background="{DynamicResource AccentBrush}" BorderThickness="0" Cursor="Hand" Tag="{Binding}" Click="OnDirectCallButtonClicked" ToolTip="Начать прямой вызов">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border CornerRadius="14" Background="{TemplateBinding Background}">
                                                        <TextBlock Text="📞" FontSize="11" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- IF IN FELLOWSHIP MODE: CATEGORIES & CHANNELS -->
                <StackPanel Visibility="{Binding IsInFellowshipMode, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4,0,8">
                                    <!-- Category Header -->
                                    <Button Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Padding="6,2" Cursor="Hand" Tag="{Binding}" Click="OnCategoryHeaderClicked">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="▾ " FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Channels -->
                                    <ItemsControl ItemsSource="{Binding Channels}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Margin="0,1" Padding="8,6" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Cursor="Hand" Tag="{Binding}" Click="OnChannelClicked">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- Channel Icon (# for text, 🔊 for voice) -->
                                                                    <TextBlock Text="{Binding IconGlyph}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />

                                                                    <!-- Channel Name -->
                                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                                                    <!-- Bitrate or unread badge -->
                                                                    <TextBlock Grid.Column="2" Text="{Binding BitrateDisplay}" FontSize="9" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                                                </Grid>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom User Bar (Avatar + Name + Mic/Headphone/Settings Toggles) -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="10,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Avatar -->
                <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource AccentBrush}">
                    <TextBlock Text="⚡" FontSize="16" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Name & Status -->
                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentUser.DisplayName}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding CurrentUser.StatusText}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Command="{Binding ToggleMuteCommand}" ToolTip="Отключить микрофон">
                        <TextBlock Text="🎤" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Command="{Binding ToggleDeafenCommand}" ToolTip="Заглушить звук">
                        <TextBlock Text="🎧" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Command="{Binding OpenUserSettingsCommand}" ToolTip="Настройки пользователя">
                        <TextBlock Text="⚙" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
