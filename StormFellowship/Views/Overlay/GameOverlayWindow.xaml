<Window x:Class="StormFellowship.Views.Overlay.GameOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="STORM FELLOWSHIP Game Overlay"
        Width="380" Height="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Left="30" Top="30"
        MouseLeftButtonDown="OnWindowDrag">

    <Border Background="#D9060A14"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="1.5"
            CornerRadius="16"
            Padding="14"
            Opacity="{Binding OverlayOpacity}">
        <Border.Effect>
            <DropShadowEffect Color="#00A3FF" BlurRadius="16" ShadowDepth="0" Opacity="0.5" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header & Pin / Close -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/AppIcon.png" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="STORM OVERLAY" FontSize="11" FontWeight="Black" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Width="24" Height="24" Background="Transparent" BorderThickness="0" Cursor="Hand" Command="{Binding ToggleChatCommand}" ToolTip="Чат" Margin="0,0,4,0">
                        <TextBlock Text="💬" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button Width="24" Height="24" Background="Transparent" BorderThickness="0" Cursor="Hand" Command="{Binding CloseOverlayCommand}" ToolTip="Скрыть оверлей">
                        <TextBlock Text="✕" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Active Voice Participants (Avatars with Neon Speaking Rings) -->
            <Border Grid.Row="1" Background="#660F172A" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,0,0,10">
                <ItemsControl ItemsSource="{Binding SpeakingParticipants}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="6,4" HorizontalAlignment="Center">
                                <Grid Width="42" Height="42" HorizontalAlignment="Center">
                                    <Ellipse Width="42" Height="42" Stroke="{DynamicResource StatusOnlineBrush}" StrokeThickness="2.5" />
                                    <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AvatarGlyph}" FontSize="16" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding DisplayName}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxWidth="60" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Quick In-Game Chat Feed -->
            <Border Grid.Row="2" Background="#400A0E17" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,0,0,10"
                    Visibility="{Binding IsChatExpanded, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding RecentChatMessages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,3" Padding="4" CornerRadius="6" Background="#331E293B">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Author.DisplayName}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding FormattedTime}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Content}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Bottom Floating Control Bar -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Text="{Binding QuickMessageText, UpdateSourceTrigger=PropertyChanged}" Background="#661E293B" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" Padding="8,5" FontSize="11" KeyDown="OnQuickMessageKeyDown" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Width="30" Height="28" Background="#661E293B" BorderThickness="0" Cursor="Hand" Command="{Binding ToggleMuteCommand}" ToolTip="Микрофон" Margin="0,0,4,0">
                        <TextBlock Text="{Binding MicIcon}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button Width="30" Height="28" Background="#661E293B" BorderThickness="0" Cursor="Hand" Command="{Binding ToggleDeafenCommand}" ToolTip="Звук">
                        <TextBlock Text="{Binding SoundIcon}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
