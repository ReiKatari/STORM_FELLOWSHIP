<UserControl x:Class="StormFellowship.Views.Dialogs.E2EESecurityDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Backdrop Overlay -->
    <Grid Background="#85000000" MouseDown="OnBackdropMouseDown">
        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1.5" CornerRadius="20" Width="500" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" MouseDown="OnDialogCardMouseDown">
            <Border.Effect>
                <DropShadowEffect Color="#00D2FF" BlurRadius="36" ShadowDepth="8" Opacity="0.25" />
            </Border.Effect>
            <StackPanel>
                <!-- Header -->
                <Grid Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="42" Height="42" CornerRadius="12" Background="#2634D399" BorderBrush="#4D34D399" BorderThickness="1" Margin="0,0,12,0">
                            <Path Data="{StaticResource GeoShieldLock}" Fill="{StaticResource IconGradEmerald}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="E2EE СКВОЗНОЕ ШИФРОВАНИЕ" FontWeight="Black" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,2" />
                            <TextBlock Text="Протокол криптографической защиты STORM" FontSize="11" Foreground="{StaticResource IconGradEmerald}" />
                        </StackPanel>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Style="{StaticResource IconButtonStyle}" Command="{Binding CloseE2EESecurityDialogCommand}" ToolTip="Закрыть (Esc)">
                        <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource CardHoverBrush}">
                            <Path Data="{StaticResource GeoClose}" Fill="{DynamicResource TextSecondaryBrush}" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Button>
                </Grid>

                <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="НОМЕРА БЕЗОПАСНОСТИ СЕССИИ (SAFETY NUMBERS):" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8" />
                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="#34D399" BorderThickness="1.2" CornerRadius="8" Padding="14,10">
                            <TextBlock Text="{Binding E2EEFingerprint}" FontSize="15" FontWeight="Black" Foreground="{StaticResource IconGradEmerald}" HorizontalAlignment="Center" FontFamily="Consolas" />
                        </Border>
                        <TextBlock Text="Все голосовые потоки, видеосвязь и текстовые сообщения зашифрованы алгоритмом AES-256-GCM с обменом ключами ECDH Curve25519." FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,12,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Actions -->
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource GeoCheck}" Fill="#34D399" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Ключи безопасности подтверждены" FontSize="11" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center" />
                    </StackPanel>

                    <Button HorizontalAlignment="Right" Style="{StaticResource IconButtonStyle}" Command="{Binding CloseE2EESecurityDialogCommand}">
                        <Border Background="{StaticResource IconGradCyan}" CornerRadius="10" Padding="20,8">
                            <TextBlock Text="Закрыть (Esc)" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" />
                        </Border>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
