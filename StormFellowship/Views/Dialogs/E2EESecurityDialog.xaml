<UserControl x:Class="StormFellowship.Views.Dialogs.E2EESecurityDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Backdrop Overlay -->
    <Grid Background="{DynamicResource ModalOverlayBackgroundBrush}" MouseDown="OnBackdropMouseDown">
        <Border Background="{DynamicResource ModalDialogBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" MouseDown="OnDialogCardMouseDown">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="🔒" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Text="E2EE СКВОЗНОЕ ШИФРОВАНИЕ" FontWeight="Black" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Протокол криптографической защиты STORM" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                    </StackPanel>
                </StackPanel>

                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,8,0,14">
                    <StackPanel>
                        <TextBlock Text="НОМЕРА БЕЗОПАСНОСТИ СЕССИИ (SAFETY NUMBERS):" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8">
                            <TextBlock Text="{Binding E2EEFingerprint}" FontSize="15" FontWeight="Black" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" FontFamily="Consolas" />
                        </Border>
                        <TextBlock Text="Все голосовые потоки, видеосвязь и текстовые сообщения зашифрованы алгоритмом AES-256-GCM с обменом ключами ECDH Curve25519." FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Actions -->
                <Grid>
                    <TextBlock Text="✓ Ключи подтверждены" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource StatusOnlineBrush}" VerticalAlignment="Center" />
                    <Button Content="Закрыть" HorizontalAlignment="Right" Background="{DynamicResource AccentBrush}" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Padding="18,8" Cursor="Hand" Command="{Binding CloseE2EESecurityDialogCommand}" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
