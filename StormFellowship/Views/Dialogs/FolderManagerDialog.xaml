<UserControl x:Class="StormFellowship.Views.Dialogs.FolderManagerDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             KeyDown="OnDialogKeyDown" Focusable="True">
    <!-- Backdrop with click-to-close -->
    <Grid Background="#85000000" MouseDown="OnBackdropMouseDown">
        <Border Width="540" MaxHeight="640" Background="{DynamicResource CardBackgroundBrush}" 
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1.5" 
                CornerRadius="20" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                MouseDown="OnCardMouseDown">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="36" ShadowDepth="10" Opacity="0.7" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="44" Height="44" CornerRadius="14" Background="{Binding FolderEditColor, Converter={StaticResource HexToBrush}}" BorderBrush="#80FFFFFF" BorderThickness="1.5" Margin="0,0,14,0">
                            <Path Data="{Binding FolderEditIcon, Converter={StaticResource GeoKeyToGeo}}" Fill="#FFFFFF" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Управление папкой" FontWeight="Black" FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,2" />
                            <TextBlock Text="Название, иконка, цвет и управление содержимым" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Style="{StaticResource IconButtonStyle}" Command="{Binding CloseFolderManagerCommand}" ToolTip="Закрыть (Esc)">
                        <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource CardHoverBrush}">
                            <Path Data="{StaticResource GeoClose}" Fill="{DynamicResource TextSecondaryBrush}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Button>
                </Grid>

                <!-- Body ScrollViewer -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20">
                    <StackPanel>
                        <!-- Folder Name Input -->
                        <TextBlock Text="НАЗВАНИЕ ПАПКИ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="4,0,0,8" />
                        <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,20">
                            <TextBox Text="{Binding FolderEditName, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" />
                        </Border>
                        
                        <!-- Folder Icon Selector (100% Vector & Colorful Neon Badges) -->
                        <TextBlock Text="ВЫБОР ИКОНКИ ПАПКИ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="4,0,0,8" />
                        <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="14" Padding="10" Margin="0,0,0,20">
                            <WrapPanel HorizontalAlignment="Center">
                                <!-- 1. Folder -->
                                <Button Style="{StaticResource IconButtonStyle}" Width="48" Height="48" Margin="4" Command="{Binding SetFolderEditIconCommand}" CommandParameter="📁" ToolTip="Папка">
                                    <Border Width="40" Height="40" CornerRadius="12" Background="#26FBBF24" BorderBrush="#4DFBBF24" BorderThickness="1">
                                        <Path Data="{StaticResource GeoFolder}" Fill="{StaticResource IconGradAmber}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Button>
                                <!-- 2. Gamepad -->
                                <Button Style="{StaticResource IconButtonStyle}" Width="48" Height="48" Margin="4" Command="{Binding SetFolderEditIconCommand}" CommandParameter="🎮" ToolTip="Игры">
                                    <Border Width="40" Height="40" CornerRadius="12" Background="#26C084FC" BorderBrush="#4DC084FC" BorderThickness="1">
                                        <Path Data="{StaticResource GeoGamepad}" Fill="{StaticResource IconGradPurple}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Button>
                                <!-- 3. Lightning -->
                                <Button Style="{StaticResource IconButtonStyle}" Width="48" Height="48" Margin="4" Command="{Binding SetFolderEditIconCommand}" CommandParameter="⚡" ToolTip="Молния">
                                    <Border Width="40" Height="40" CornerRadius="12" Background="#2600D2FF" BorderBrush="#4D00D2FF" BorderThickness="1">
                                        <Path Data="{StaticResource GeoLightning}" Fill="{StaticResource IconGradCyan}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Button>
                                <!-- 4. Fire -->
                                <Button Style="{StaticResource IconButtonStyle}" Width="48" Height="48" Margin="4" Command="{Binding SetFolderEditIconCommand}" CommandParameter="🔥" ToolTip="Огонь">
                                    <Border Width="40" Height="40" CornerRadius="12" Background="#26FF6B00" BorderBrush="#4DFF6B00" BorderThickness="1">
                                        <Path Data="{StaticResource GeoFire}" Fill="{StaticResource IconGradFlame}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Button>
                                <!-- 5. Shield -->
                                <Button Style="{StaticResource IconButtonStyle}" Width="48" Height="48" Margin="4" Command="{Binding SetFolderEditIconCommand}" CommandParameter="🛡️" ToolTip="Щит">
                                    <Border Width="40" Height="40" CornerRadius="12" Background="#2634D399" BorderBrush="#4D34D399" BorderThickness="1">
                                        <Path Data="{StaticResource GeoShield}" Fill="{StaticResource IconGradEmerald}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Button>
                                <!-- 6. Rocket -->
                                <Button Style="{StaticResource IconButtonStyle}" Width="48" Height="48" Margin="4" Command="{Binding SetFolderEditIconCommand}" CommandParameter="🚀" ToolTip="Ракета">
                                    <Border Width="40" Height="40" CornerRadius="12" Background="#2638BDF8" BorderBrush="#4D38BDF8" BorderThickness="1">
                                        <Path Data="{StaticResource GeoRocket}" Fill="{StaticResource IconGradSky}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Button>
                                <!-- 7. Target -->
                                <Button Style="{StaticResource IconButtonStyle}" Width="48" Height="48" Margin="4" Command="{Binding SetFolderEditIconCommand}" CommandParameter="🎯" ToolTip="Цель">
                                    <Border Width="40" Height="40" CornerRadius="12" Background="#26FB7185" BorderBrush="#4DFB7185" BorderThickness="1">
                                        <Path Data="{StaticResource GeoTarget}" Fill="{StaticResource IconGradRose}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Button>
                                <!-- 8. Crown -->
                                <Button Style="{StaticResource IconButtonStyle}" Width="48" Height="48" Margin="4" Command="{Binding SetFolderEditIconCommand}" CommandParameter="👑" ToolTip="Корона">
                                    <Border Width="40" Height="40" CornerRadius="12" Background="#26FFE259" BorderBrush="#4DFFE259" BorderThickness="1">
                                        <Path Data="{StaticResource GeoCrown}" Fill="{StaticResource IconGradGold}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Button>
                                <!-- 9. Diamond -->
                                <Button Style="{StaticResource IconButtonStyle}" Width="48" Height="48" Margin="4" Command="{Binding SetFolderEditIconCommand}" CommandParameter="💎" ToolTip="Алмаз">
                                    <Border Width="40" Height="40" CornerRadius="12" Background="#2600D2FF" BorderBrush="#4D00D2FF" BorderThickness="1">
                                        <Path Data="{StaticResource GeoDiamond}" Fill="{StaticResource IconGradCyan}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Button>
                                <!-- 10. Trophy -->
                                <Button Style="{StaticResource IconButtonStyle}" Width="48" Height="48" Margin="4" Command="{Binding SetFolderEditIconCommand}" CommandParameter="🏆" ToolTip="Кубок">
                                    <Border Width="40" Height="40" CornerRadius="12" Background="#26FFE259" BorderBrush="#4DFFE259" BorderThickness="1">
                                        <Path Data="{StaticResource GeoTrophy}" Fill="{StaticResource IconGradGold}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Button>
                                <!-- 11. Headphones -->
                                <Button Style="{StaticResource IconButtonStyle}" Width="48" Height="48" Margin="4" Command="{Binding SetFolderEditIconCommand}" CommandParameter="🎧" ToolTip="Наушники">
                                    <Border Width="40" Height="40" CornerRadius="12" Background="#266366F1" BorderBrush="#4D6366F1" BorderThickness="1">
                                        <Path Data="{StaticResource GeoHeadphones}" Fill="{StaticResource IconGradElectricIndigo}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Button>
                                <!-- 12. Star -->
                                <Button Style="{StaticResource IconButtonStyle}" Width="48" Height="48" Margin="4" Command="{Binding SetFolderEditIconCommand}" CommandParameter="🌟" ToolTip="Звезда">
                                    <Border Width="40" Height="40" CornerRadius="12" Background="#26FFE259" BorderBrush="#4DFFE259" BorderThickness="1">
                                        <Path Data="{StaticResource GeoStar}" Fill="{StaticResource IconGradGold}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Button>
                                <!-- 13. Bot -->
                                <Button Style="{StaticResource IconButtonStyle}" Width="48" Height="48" Margin="4" Command="{Binding SetFolderEditIconCommand}" CommandParameter="🤖" ToolTip="Робот">
                                    <Border Width="40" Height="40" CornerRadius="12" Background="#2600D2FF" BorderBrush="#4D00D2FF" BorderThickness="1">
                                        <Path Data="{StaticResource GeoBot}" Fill="{StaticResource IconGradCyan}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Button>
                                <!-- 14. Pizza -->
                                <Button Style="{StaticResource IconButtonStyle}" Width="48" Height="48" Margin="4" Command="{Binding SetFolderEditIconCommand}" CommandParameter="🍕" ToolTip="Пицца">
                                    <Border Width="40" Height="40" CornerRadius="12" Background="#26FBBF24" BorderBrush="#4DFBBF24" BorderThickness="1">
                                        <Path Data="{StaticResource GeoPizza}" Fill="{StaticResource IconGradAmber}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Button>
                                <!-- 15. Swords -->
                                <Button Style="{StaticResource IconButtonStyle}" Width="48" Height="48" Margin="4" Command="{Binding SetFolderEditIconCommand}" CommandParameter="⚔️" ToolTip="Мечи">
                                    <Border Width="40" Height="40" CornerRadius="12" Background="#2638BDF8" BorderBrush="#4D38BDF8" BorderThickness="1">
                                        <Path Data="{StaticResource GeoSwords}" Fill="{StaticResource IconGradSky}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Button>
                                <!-- 16. Popcorn -->
                                <Button Style="{StaticResource IconButtonStyle}" Width="48" Height="48" Margin="4" Command="{Binding SetFolderEditIconCommand}" CommandParameter="🍿" ToolTip="Попкорн">
                                    <Border Width="40" Height="40" CornerRadius="12" Background="#26FF2E93" BorderBrush="#4DFF2E93" BorderThickness="1">
                                        <Path Data="{StaticResource GeoPopcorn}" Fill="{StaticResource IconGradNeonPink}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Button>
                            </WrapPanel>
                        </Border>
                        
                        <!-- Color Accents -->
                        <TextBlock Text="ЦВЕТОВОЙ АКЦЕНТ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="4,0,0,8" />
                        <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="14" Padding="10" Margin="0,0,0,20">
                            <WrapPanel HorizontalAlignment="Center">
                                <Button Style="{StaticResource IconButtonStyle}" Width="40" Height="40" Margin="4" Command="{Binding SetFolderEditColorCommand}" CommandParameter="#A855F7" ToolTip="Фиолетовый"><Border Width="28" Height="28" CornerRadius="14" Background="#A855F7" /></Button>
                                <Button Style="{StaticResource IconButtonStyle}" Width="40" Height="40" Margin="4" Command="{Binding SetFolderEditColorCommand}" CommandParameter="#00D2FF" ToolTip="Кибер-циан"><Border Width="28" Height="28" CornerRadius="14" Background="#00D2FF" /></Button>
                                <Button Style="{StaticResource IconButtonStyle}" Width="40" Height="40" Margin="4" Command="{Binding SetFolderEditColorCommand}" CommandParameter="#10B981" ToolTip="Изумруд"><Border Width="28" Height="28" CornerRadius="14" Background="#10B981" /></Button>
                                <Button Style="{StaticResource IconButtonStyle}" Width="40" Height="40" Margin="4" Command="{Binding SetFolderEditColorCommand}" CommandParameter="#FBBF24" ToolTip="Золотой"><Border Width="28" Height="28" CornerRadius="14" Background="#FBBF24" /></Button>
                                <Button Style="{StaticResource IconButtonStyle}" Width="40" Height="40" Margin="4" Command="{Binding SetFolderEditColorCommand}" CommandParameter="#EF4444" ToolTip="Рубиновый"><Border Width="28" Height="28" CornerRadius="14" Background="#EF4444" /></Button>
                                <Button Style="{StaticResource IconButtonStyle}" Width="40" Height="40" Margin="4" Command="{Binding SetFolderEditColorCommand}" CommandParameter="#38BDF8" ToolTip="Небесный"><Border Width="28" Height="28" CornerRadius="14" Background="#38BDF8" /></Button>
                                <Button Style="{StaticResource IconButtonStyle}" Width="40" Height="40" Margin="4" Command="{Binding SetFolderEditColorCommand}" CommandParameter="#EC4899" ToolTip="Розовый неон"><Border Width="28" Height="28" CornerRadius="14" Background="#EC4899" /></Button>
                                <Button Style="{StaticResource IconButtonStyle}" Width="40" Height="40" Margin="4" Command="{Binding SetFolderEditColorCommand}" CommandParameter="#6366F1" ToolTip="Индиго"><Border Width="28" Height="28" CornerRadius="14" Background="#6366F1" /></Button>
                            </WrapPanel>
                        </Border>
                        
                        <!-- Fellowships in this folder -->
                        <TextBlock Text="СОДРУЖЕСТВА В ЭТОЙ ПАПКЕ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="4,0,0,8" />
                        <ItemsControl ItemsSource="{Binding SelectedFolderForEdit.Fellowships}" Margin="0,0,0,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,3">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource AccentBrush}" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Initials}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Button HorizontalAlignment="Right" Padding="12,6" Style="{StaticResource IconButtonStyle}" Command="{Binding DataContext.ExtractFellowshipFromFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                <Border Background="#26EF4444" CornerRadius="8" Padding="10,4">
                                                    <TextBlock Text="Извлечь" FontSize="11" FontWeight="Bold" Foreground="#EF4444" />
                                                </Border>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        
                        <!-- Available Fellowships to add -->
                        <TextBlock Text="ДОСТУПНЫЕ ДЛЯ ДОБАВЛЕНИЯ В ПАПКУ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="4,4,0,8" />
                        <ItemsControl ItemsSource="{Binding AvailableFellowshipsToAddToFolder}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardHoverBrush}" CornerRadius="12" Padding="12,8" Margin="0,3">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource CardBackgroundBrush}" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Initials}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Button HorizontalAlignment="Right" Padding="12,6" Style="{StaticResource IconButtonStyle}" Command="{Binding DataContext.AddFellowshipToEditedFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                <Border Background="{StaticResource IconGradCyan}" CornerRadius="8" Padding="12,4">
                                                    <TextBlock Text="+ Добавить" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                                                </Border>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Actions Footer -->
                <Grid Grid.Row="2">
                    <Button HorizontalAlignment="Left" Style="{StaticResource IconButtonStyle}" Command="{Binding DeleteCurrentFolderCommand}">
                        <Border Background="#26EF4444" BorderBrush="#4DEF4444" BorderThickness="1" CornerRadius="12" Padding="16,10">
                            <TextBlock Text="Удалить папку" FontSize="13" FontWeight="Bold" Foreground="#EF4444" />
                        </Border>
                    </Button>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource IconButtonStyle}" Command="{Binding CloseFolderManagerCommand}" Margin="0,0,12,0">
                            <Border Background="{DynamicResource CardHoverBrush}" CornerRadius="12" Padding="16,10">
                                <TextBlock Text="Отмена (Esc)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Command="{Binding SaveFolderChangesCommand}">
                            <Border Background="{StaticResource IconGradPurple}" CornerRadius="12" Padding="20,10">
                                <TextBlock Text="Сохранить" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" />
                            </Border>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
