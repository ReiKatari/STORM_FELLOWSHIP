<UserControl x:Class="StormFellowship.Views.Dialogs.QuickSwitcherDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Backdrop Overlay -->
    <Grid Background="{DynamicResource ModalOverlayBackgroundBrush}" MouseDown="OnBackdropMouseDown">
        <Border Background="{DynamicResource ModalDialogBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1.5" CornerRadius="16" Width="580" Height="440" HorizontalAlignment="Center" VerticalAlignment="Center" MouseDown="OnDialogCardMouseDown">
            <Border.Effect>
                <DropShadowEffect Color="#00A3FF" BlurRadius="28" ShadowDepth="0" Opacity="0.35" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="40" />
                </Grid.RowDefinitions>

                <!-- Search Input Header -->
                <Border Background="{DynamicResource ModalHeaderBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="16,14" CornerRadius="16,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Data="{StaticResource GeoSearch}" Fill="{DynamicResource AccentBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBox Grid.Column="1" x:Name="SearchInput" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" FontSize="14" FontWeight="SemiBold" VerticalContentAlignment="Center" TextChanged="OnSearchInputTextChanged" KeyDown="OnSearchInputKeyDown" />
                        <Border Grid.Column="2" Background="{DynamicResource InputBackgroundBrush}" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="ESC для выхода" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Navigation Results List -->
                <ScrollViewer Grid.Row="1" Padding="14,10" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ResultsPanel">
                        <!-- Populated in code-behind -->
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer Hint -->
                <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="16,0" CornerRadius="0,0,16,16">
                    <Grid VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚡ Навигация: " FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="Каналы (#), Голосовые комнаты (🔊), Личные сообщения, Настройки" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
