<UserControl x:Class="StormFellowship.Views.Dialogs.CreatePollDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Backdrop Overlay -->
    <Grid Background="{DynamicResource ModalOverlayBackgroundBrush}" MouseDown="OnBackdropMouseDown">
        <Border Background="{DynamicResource ModalDialogBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" MouseDown="OnDialogCardMouseDown">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="📊" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="СОЗДАНИЕ ОПРОСА В ЧАТЕ" FontWeight="Black" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Задайте вопрос и укажите варианты ответов для голосования участников." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,16" />

                <!-- Question -->
                <TextBlock Text="ВОПРОС ОПРОСА" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                <TextBox Text="{Binding NewPollQuestion, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" Padding="10,8" Margin="0,0,0,12" />

                <!-- Options -->
                <TextBlock Text="ВАРИАНТ 1" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                <TextBox Text="{Binding NewPollOption1, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" Padding="8,6" Margin="0,0,0,8" />

                <TextBlock Text="ВАРИАНТ 2" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                <TextBox Text="{Binding NewPollOption2, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" Padding="8,6" Margin="0,0,0,8" />

                <TextBlock Text="ВАРИАНТ 3 (НЕОБЯЗАТЕЛЬНО)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                <TextBox Text="{Binding NewPollOption3, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" Padding="8,6" Margin="0,0,0,8" />

                <TextBlock Text="ВАРИАНТ 4 (НЕОБЯЗАТЕЛЬНО)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                <TextBox Text="{Binding NewPollOption4, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" Padding="8,6" Margin="0,0,0,16" />

                <!-- Actions -->
                <Grid>
                    <Button Content="Отмена" HorizontalAlignment="Left" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand" Command="{Binding CloseCreatePollDialogCommand}" />
                    <Button Content="Опубликовать опрос" HorizontalAlignment="Right" Background="{DynamicResource AccentBrush}" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Padding="18,8" Cursor="Hand" Command="{Binding SubmitCreatePollCommand}" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
