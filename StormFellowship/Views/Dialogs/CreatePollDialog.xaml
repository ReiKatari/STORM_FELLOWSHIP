<UserControl x:Class="StormFellowship.Views.Dialogs.CreatePollDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Backdrop Overlay with click-to-close -->
    <Grid Background="#85000000" MouseDown="OnBackdropMouseDown">
        <Border Width="560" MaxHeight="680" Background="{DynamicResource CardBackgroundBrush}" 
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1.5" 
                CornerRadius="20" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                MouseDown="OnDialogCardMouseDown">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="36" ShadowDepth="10" Opacity="0.7" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="42" Height="42" CornerRadius="14" Background="#26FBBF24" BorderBrush="#4DFBBF24" BorderThickness="1.5" Margin="0,0,14,0">
                            <Path Data="{StaticResource GeoPoll}" Fill="{StaticResource IconGradAmber}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Создание интерактивного опроса" FontWeight="Black" FontSize="17" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,2" />
                            <TextBlock Text="Задайте вопрос, прикрепите изображения и настройте варианты" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Style="{StaticResource IconButtonStyle}" Command="{Binding CloseCreatePollDialogCommand}" ToolTip="Закрыть (Esc)">
                        <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource CardHoverBrush}">
                            <Path Data="{StaticResource GeoClose}" Fill="{DynamicResource TextSecondaryBrush}" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Button>
                </Grid>

                <!-- Scrollable Body -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                    <StackPanel>
                        <!-- Question Input -->
                        <TextBlock Text="ВОПРОС ОПРОСА" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="4,0,0,6" />
                        <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,10">
                            <TextBox Text="{Binding NewPollQuestion, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" />
                        </Border>

                        <!-- Question Image Attachment -->
                        <Grid Margin="0,0,0,16">
                            <!-- Button to add image if none attached -->
                            <Button Style="{StaticResource IconButtonStyle}" Command="{Binding BrowsePollQuestionImageCommand}" HorizontalAlignment="Left" Visibility="{Binding NewPollQuestionImageUrl, Converter={StaticResource NullToVis}, ConverterParameter=invert}">
                                <Border Background="#1A38BDF8" BorderBrush="#3338BDF8" BorderThickness="1" CornerRadius="10" Padding="12,7">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GeoImage}" Fill="{StaticResource IconGradSky}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Прикрепить изображение к вопросу" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource IconGradSky}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Button>

                            <!-- Attached Image Preview with Remove Button -->
                            <Border Visibility="{Binding NewPollQuestionImageUrl, Converter={StaticResource StrNotEmptyToVis}}" CornerRadius="12" Background="#111827" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="8" Margin="0,4,0,0">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="60" Height="40" CornerRadius="8" Margin="0,0,10,0">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding NewPollQuestionImageUrl}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                        <TextBlock Text="{Binding NewPollQuestionImageUrl}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource IconButtonStyle}" Command="{Binding ClearPollQuestionImageCommand}" ToolTip="Удалить изображение">
                                        <Border Width="26" Height="26" CornerRadius="13" Background="#26EF4444">
                                            <Path Data="{StaticResource GeoClose}" Fill="#EF4444" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Options Header & Dynamic List -->
                        <TextBlock Text="ВАРИАНТЫ ОТВЕТОВ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="4,0,0,8" />
                        <ItemsControl ItemsSource="{Binding NewPollOptions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="10,8" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Option Text Input -->
                                            <TextBox Grid.Column="0" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />

                                            <!-- Option Image Attach / Thumbnail -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <!-- If image attached: show mini thumbnail -->
                                                <Border Width="30" Height="30" CornerRadius="6" Margin="0,0,4,0" Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding ImageUrl}" Stretch="UniformToFill" />
                                                    </Border.Background>
                                                </Border>

                                                <!-- Browse image button -->
                                                <Button Style="{StaticResource IconButtonStyle}" Width="30" Height="30" Command="{Binding DataContext.BrowseOptionImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="Прикрепить картинку к варианту">
                                                    <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource CardHoverBrush}">
                                                        <Path Data="{StaticResource GeoImage}" Fill="{StaticResource IconGradSky}" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </Button>
                                            </StackPanel>

                                            <!-- Delete Option Button -->
                                            <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Width="30" Height="30" Command="{Binding DataContext.RemoveNewPollOptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="Удалить вариант">
                                                <Border Width="28" Height="28" CornerRadius="8" Background="#1AEF4444">
                                                    <Path Data="{StaticResource GeoClose}" Fill="#EF4444" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Add Option Button -->
                        <Button Style="{StaticResource IconButtonStyle}" Command="{Binding AddNewPollOptionCommand}" HorizontalAlignment="Left" Margin="0,0,0,16">
                            <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="10" Padding="14,8">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource GeoPlus}" Fill="{StaticResource IconGradCyan}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="+ Добавить вариант ответа" FontSize="12" FontWeight="Bold" Foreground="{StaticResource IconGradCyan}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Button>

                        <!-- Poll Settings Toggles -->
                        <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,8">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding NewPollAllowMultiple}" Content="Разрешить выбор нескольких ответов" Margin="0,0,0,8" />
                                <CheckBox IsChecked="{Binding NewPollIsAnonymous}" Content="Анонимный опрос (скрывать имена проголосовавших)" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer Actions -->
                <Grid Grid.Row="2">
                    <Button HorizontalAlignment="Left" Style="{StaticResource IconButtonStyle}" Command="{Binding CloseCreatePollDialogCommand}">
                        <Border Background="{DynamicResource CardHoverBrush}" CornerRadius="12" Padding="16,10">
                            <TextBlock Text="Отмена (Esc)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                    </Button>
                    <Button HorizontalAlignment="Right" Style="{StaticResource IconButtonStyle}" Command="{Binding SubmitCreatePollCommand}">
                        <Border Background="{StaticResource IconGradAmber}" CornerRadius="12" Padding="22,10">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoPoll}" Fill="#000000" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Опубликовать опрос" FontSize="13" FontWeight="Black" Foreground="#000000" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
