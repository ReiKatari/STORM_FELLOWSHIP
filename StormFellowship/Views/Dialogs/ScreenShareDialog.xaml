<UserControl x:Class="StormFellowship.Views.Dialogs.ScreenShareDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Backdrop Overlay -->
    <Grid Background="{DynamicResource ModalOverlayBackgroundBrush}" MouseDown="OnBackdropMouseDown">
        <Border Background="{DynamicResource ModalDialogBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" MouseDown="OnDialogCardMouseDown">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="🖥️" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="ДЕМОНСТРАЦИЯ ЭКРАНА И ПРИЛОЖЕНИЙ" FontWeight="Black" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Выберите источник трансляции, разрешение, частоту кадров и аудиопоток." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,16" />

                <!-- Source Selector -->
                <TextBlock Text="ИСТОЧНИК ТРАНСЛЯЦИИ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding ScreenShareSources}" SelectedItem="{Binding ScreenShareSource}" Margin="0,0,0,12" />

                <!-- Quality / Framerate -->
                <TextBlock Text="КАЧЕСТВО И ЧАСТОТА КАДРОВ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding ScreenShareQualities}" SelectedItem="{Binding ScreenShareQuality}" Margin="0,0,0,14" />

                <!-- WASAPI Loopback Audio -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,20">
                    <CheckBox Content="🔊 Захват чистого звука выбранного приложения (WASAPI Loopback)" IsChecked="{Binding ScreenShareIncludeAudio}" Foreground="{DynamicResource TextPrimaryBrush}" />
                </Border>

                <!-- Actions -->
                <Grid>
                    <Button Content="Отмена" HorizontalAlignment="Left" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand" Command="{Binding CloseScreenShareDialogCommand}" />
                    <Button Content="Запустить трансляцию" HorizontalAlignment="Right" Background="{DynamicResource AccentBrush}" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Padding="18,8" Cursor="Hand" Command="{Binding SubmitStartScreenShareCommand}" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
