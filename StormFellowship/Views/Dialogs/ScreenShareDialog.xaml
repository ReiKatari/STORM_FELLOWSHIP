<UserControl x:Class="StormFellowship.Views.Dialogs.ScreenShareDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Backdrop Overlay -->
    <Grid Background="#85000000" MouseDown="OnBackdropMouseDown">
        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1.5" CornerRadius="20" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" MouseDown="OnDialogCardMouseDown">
            <Border.Effect>
                <DropShadowEffect Color="#00D2FF" BlurRadius="36" ShadowDepth="8" Opacity="0.25" />
            </Border.Effect>
            <StackPanel>
                <!-- Header -->
                <Grid Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="12" Background="#2600D2FF" BorderBrush="#4D00D2FF" BorderThickness="1" Margin="0,0,12,0">
                            <Path Data="{StaticResource GeoScreenShare}" Fill="{StaticResource IconGradCyan}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ДЕМОНСТРАЦИЯ ЭКРАНА И ОКОН" FontWeight="Black" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,2" />
                            <TextBlock Text="Трансляция с аппаратным захватом DWM и аудиопотоком" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Style="{StaticResource IconButtonStyle}" Command="{Binding CloseScreenShareDialogCommand}" ToolTip="Закрыть (Esc)">
                        <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource CardHoverBrush}">
                            <Path Data="{StaticResource GeoClose}" Fill="{DynamicResource TextSecondaryBrush}" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Button>
                </Grid>

                <!-- Source Selector Header with Refresh Button -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="ИСТОЧНИК ТРАНСЛЯЦИИ (ЭКРАНЫ И ПРИЛОЖЕНИЯ)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Command="{Binding RefreshRealCaptureSourcesCommand}" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoRefresh}" Fill="{StaticResource IconGradCyan}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="Обновить список" Foreground="{StaticResource IconGradCyan}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
                <ComboBox ItemsSource="{Binding ScreenShareSources}" SelectedItem="{Binding ScreenShareSource}" Margin="0,0,0,14" />

                <!-- Quality / Framerate -->
                <TextBlock Text="КАЧЕСТВО И ЧАСТОТА КАДРОВ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6" />
                <ComboBox ItemsSource="{Binding ScreenShareQualities}" SelectedItem="{Binding ScreenShareQuality}" Margin="0,0,0,14" />

                <!-- WASAPI Loopback Audio -->
                <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource GeoSpeaker}" Fill="{StaticResource IconGradEmerald}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <CheckBox Content="Захват звука выбранного приложения (WASAPI Loopback)" IsChecked="{Binding ScreenShareIncludeAudio}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Actions -->
                <Grid>
                    <Button HorizontalAlignment="Left" Style="{StaticResource IconButtonStyle}" Command="{Binding CloseScreenShareDialogCommand}">
                        <Border Background="{DynamicResource CardHoverBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="16,8">
                            <TextBlock Text="Отмена (Esc)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                    </Button>

                    <Button HorizontalAlignment="Right" Style="{StaticResource IconButtonStyle}" Command="{Binding SubmitStartScreenShareCommand}">
                        <Border Background="{StaticResource IconGradCyan}" CornerRadius="10" Padding="20,8">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoScreenShare}" Fill="#FFFFFF" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Запустить трансляцию" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
