<UserControl x:Class="StormFellowship.Views.Dialogs.CreateChannelDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Backdrop Overlay (Click to close) -->
    <Grid Background="#85000000" MouseDown="OnBackdropMouseDown">
        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1.5" CornerRadius="20" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" MouseDown="OnDialogCardMouseDown">
            <Border.Effect>
                <DropShadowEffect Color="#00D2FF" BlurRadius="36" ShadowDepth="8" Opacity="0.25" />
            </Border.Effect>
            <StackPanel>
                <!-- Title -->
                <Grid Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="12" Background="#2600D2FF" BorderBrush="#4D00D2FF" BorderThickness="1" Margin="0,0,12,0">
                            <Path Data="{StaticResource GeoHash}" Fill="{StaticResource IconGradCyan}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="СОЗДАНИЕ НОВОГО КАНАЛА" FontWeight="Black" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,2" />
                            <TextBlock Text="Текстовое или голосовое пространство для участников" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Style="{StaticResource IconButtonStyle}" Command="{Binding CloseCreateChannelDialogCommand}" ToolTip="Закрыть (Esc)">
                        <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource CardHoverBrush}">
                            <Path Data="{StaticResource GeoClose}" Fill="{DynamicResource TextSecondaryBrush}" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Button>
                </Grid>

                <!-- Channel Type Selection -->
                <TextBlock Text="ТИП КАНАЛА" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="2,0,0,6" />
                <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,14">
                    <StackPanel>
                        <RadioButton x:Name="RbTextChannel" IsChecked="True" Checked="OnTextTypeChecked" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoHash}" Fill="{StaticResource IconGradCyan}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Текстовый канал (Сообщения, файлы, опросы)" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="RbVoiceChannel" Checked="OnVoiceTypeChecked" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoSpeaker}" Fill="{StaticResource IconGradEmerald}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Голосовой канал (Созвоны, Opus HD 128 kbps)" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="RbAnnounceChannel" Checked="OnAnnounceTypeChecked">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoScanner}" Fill="{StaticResource IconGradAmber}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Канал объявлений (Важная информация)" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <!-- Channel Name Input -->
                <TextBlock Text="НАЗВАНИЕ КАНАЛА" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="2,0,0,6" />
                <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,14">
                    <TextBox Text="{Binding NewChannelName, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" />
                </Border>

                <!-- Channel Topic Input -->
                <TextBlock Text="ТЕМА КАНАЛА (НЕОБЯЗАТЕЛЬНО)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="2,0,0,6" />
                <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,14">
                    <TextBox Text="{Binding NewChannelTopic, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" />
                </Border>

                <!-- Bitrate Selector (Only for voice) -->
                <StackPanel x:Name="BitratePanel" Visibility="Collapsed" Margin="0,0,0,14">
                    <TextBlock Text="БИТРЕЙТ ЗВУКА" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="2,0,0,6" />
                    <ComboBox ItemsSource="{Binding AvailableBitrates}" SelectedItem="{Binding NewChannelBitrate}" />
                </StackPanel>

                <!-- Actions -->
                <Grid Margin="0,10,0,0">
                    <Button HorizontalAlignment="Left" Style="{StaticResource IconButtonStyle}" Command="{Binding CloseCreateChannelDialogCommand}">
                        <Border Background="{DynamicResource CardHoverBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="16,8">
                            <TextBlock Text="Отмена (Esc)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                    </Button>

                    <Button HorizontalAlignment="Right" Style="{StaticResource IconButtonStyle}" Command="{Binding SubmitCreateChannelCommand}">
                        <Border Background="{StaticResource IconGradCyan}" CornerRadius="10" Padding="20,8">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoPlus}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Создать канал" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
