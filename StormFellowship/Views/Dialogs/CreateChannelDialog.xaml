<UserControl x:Class="StormFellowship.Views.Dialogs.CreateChannelDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Backdrop Overlay (Click to close) -->
    <Grid Background="{DynamicResource ModalOverlayBackgroundBrush}" MouseDown="OnBackdropMouseDown">
        <Border Background="{DynamicResource ModalDialogBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" MouseDown="OnDialogCardMouseDown">
            <StackPanel>
                <!-- Title -->
                <TextBlock Text="СОЗДАНИЕ НОВОГО КАНАЛА" FontWeight="Black" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                <TextBlock Text="Создайте текстовый или голосовой канал для общения в содружестве." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,16" />

                <!-- Channel Type Selection (RadioButtons) -->
                <TextBlock Text="ТИП КАНАЛА" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                    <StackPanel>
                        <RadioButton x:Name="RbTextChannel" Content="# Текстовый канал (Переписка, файлы, стикеры)" IsChecked="True" Checked="OnTextTypeChecked" Margin="0,0,0,8" />
                        <RadioButton x:Name="RbVoiceChannel" Content="🔊 Голосовой канал (Созвоны, кристальный звук)" Checked="OnVoiceTypeChecked" Margin="0,0,0,8" />
                        <RadioButton x:Name="RbAnnounceChannel" Content="📢 Объявления (Важная информация)" Checked="OnAnnounceTypeChecked" />
                    </StackPanel>
                </Border>

                <!-- Channel Name Input -->
                <TextBlock Text="НАЗВАНИЕ КАНАЛА" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                <TextBox Text="{Binding NewChannelName, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" Padding="10,8" Margin="0,0,0,14" />

                <!-- Channel Topic Input -->
                <TextBlock Text="ТЕМА КАНАЛА (НЕОБЯЗАТЕЛЬНО)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                <TextBox Text="{Binding NewChannelTopic, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" Padding="10,8" Margin="0,0,0,14" />

                <!-- Bitrate Selector (Only for voice) -->
                <StackPanel x:Name="BitratePanel" Visibility="Collapsed" Margin="0,0,0,14">
                    <TextBlock Text="БИТРЕЙТ ЗВУКА" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding AvailableBitrates}" SelectedItem="{Binding NewChannelBitrate}" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" Padding="8,6" />
                </StackPanel>

                <!-- Actions -->
                <Grid Margin="0,10,0,0">
                    <Button Content="Отмена" HorizontalAlignment="Left" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand" Command="{Binding CloseCreateChannelDialogCommand}" />
                    <Button Content="Создать канал" HorizontalAlignment="Right" Background="{DynamicResource AccentBrush}" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Padding="18,8" Cursor="Hand" Command="{Binding SubmitCreateChannelCommand}" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
