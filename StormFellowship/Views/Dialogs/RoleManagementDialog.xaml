<UserControl x:Class="StormFellowship.Views.Dialogs.RoleManagementDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Backdrop Overlay -->
    <Grid Background="{DynamicResource ModalOverlayBackgroundBrush}" MouseDown="OnBackdropMouseDown">
        <Border Background="{DynamicResource ModalDialogBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Width="680" Height="500" HorizontalAlignment="Center" VerticalAlignment="Center" MouseDown="OnDialogCardMouseDown">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="52" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Background="{DynamicResource ModalHeaderBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="20,0">
                    <Grid VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="👑" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="УПРАВЛЕНИЕ РОЛЯМИ И ПРАВАМИ СОДРУЖЕСТВА" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Width="32" Height="32" Background="Transparent" BorderThickness="0" Cursor="Hand" Command="{Binding CloseCommand}" ToolTip="Закрыть (ESC)">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CloseBorder" CornerRadius="6" Background="Transparent">
                                        <TextBlock Text="✕" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CloseBorder" Property="Background" Value="#EF4444" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Body (Roles List + Role Editor) -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Roles List + Create Role Button -->
                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Roles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Margin="0,2" Padding="10,8" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" HorizontalContentAlignment="Stretch" Cursor="Hand" Tag="{Binding}" Click="OnRoleItemClicked">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="10" Height="10" CornerRadius="5" Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Button Grid.Row="1" Content="➕ Создать новую роль" Command="{Binding CreateNewRoleCommand}" Background="{DynamicResource AccentBrush}" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Padding="10,7" Margin="0,8,0,0" Cursor="Hand" FontSize="11" />
                        </Grid>
                    </Border>

                    <!-- Right: Role Properties & Permissions -->
                    <ScrollViewer Grid.Column="1" Padding="18" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Role Name -->
                            <TextBlock Text="НАЗВАНИЕ РОЛИ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding EditingRoleName, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" Padding="8,6" Margin="0,0,0,12" />

                            <!-- Role Color -->
                            <TextBlock Text="ЦВЕТ РОЛИ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding ColorPresets}" Margin="0,0,0,14">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="26" Height="26" Margin="0,0,6,6" Background="{Binding Converter={StaticResource HexToBrush}}" BorderThickness="0" Cursor="Hand" Tag="{Binding}" Click="OnColorPresetClicked">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border CornerRadius="13" Background="{TemplateBinding Background}" BorderBrush="#FFFFFF" BorderThickness="1" />
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Separator Background="{DynamicResource DividerBrush}" Margin="0,0,0,12" />

                            <!-- Permissions Checkboxes -->
                            <TextBlock Text="ПРАВА ДОСТУПА И РАЗРЕШЕНИЯ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
                            <CheckBox Content="💬 Отправка сообщений и файлов" IsChecked="{Binding PermSendMessages}" Margin="0,0,0,8" />
                            <CheckBox Content="🎙️ Подключение к голосовым каналам" IsChecked="{Binding PermConnectVoice}" Margin="0,0,0,8" />
                            <CheckBox Content="📢 Приоритетный голос (Priority Speaker)" IsChecked="{Binding PermPrioritySpeaker}" Margin="0,0,0,8" />
                            <CheckBox Content="🛠️ Управление каналами содружества" IsChecked="{Binding PermManageChannels}" Margin="0,0,0,8" />
                            <CheckBox Content="⚡ Права администратора (Полный доступ)" IsChecked="{Binding PermAdministrator}" Margin="0,0,0,12" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Footer Actions -->
                <Border Grid.Row="2" Background="{DynamicResource ModalHeaderBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="20,0">
                    <Grid VerticalAlignment="Center">
                        <Button Content="Удалить роль" Command="{Binding DeleteCurrentRoleCommand}" Background="Transparent" Foreground="{DynamicResource StatusDndBrush}" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left" FontWeight="SemiBold" FontSize="11" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Закрыть" Command="{Binding CloseCommand}" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" FontWeight="SemiBold" FontSize="12" />
                            <Button Content="Сохранить роль" Command="{Binding SaveCurrentRoleCommand}" Background="{DynamicResource AccentBrush}" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Padding="16,6" Cursor="Hand" FontSize="12" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
