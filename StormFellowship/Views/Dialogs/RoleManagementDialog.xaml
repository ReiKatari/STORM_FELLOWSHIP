<UserControl x:Class="StormFellowship.Views.Dialogs.RoleManagementDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Backdrop Overlay -->
    <Grid Background="#85000000" MouseDown="OnBackdropMouseDown">
        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1.5" CornerRadius="20" Width="680" Height="520" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20" MouseDown="OnDialogCardMouseDown">
            <Border.Effect>
                <DropShadowEffect Color="#00D2FF" BlurRadius="36" ShadowDepth="8" Opacity="0.25" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="12" Background="#26FBBF24" BorderBrush="#4DFBBF24" BorderThickness="1" Margin="0,0,12,0">
                            <Path Data="{StaticResource GeoCrown}" Fill="{StaticResource IconGradGold}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="УПРАВЛЕНИЕ РОЛЯМИ И ПРАВАМИ" FontWeight="Black" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,2" />
                            <TextBlock Text="Настройка разрешений участников содружества" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Style="{StaticResource IconButtonStyle}" Command="{Binding CloseCommand}" ToolTip="Закрыть (Esc)">
                        <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource CardHoverBrush}">
                            <Path Data="{StaticResource GeoClose}" Fill="{DynamicResource TextSecondaryBrush}" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Button>
                </Grid>

                <!-- Body (Roles List + Role Editor) -->
                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Roles List + Create Role Button -->
                    <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="14" Padding="10" Margin="0,0,12,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Roles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Margin="0,2" Padding="10,8" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" HorizontalContentAlignment="Stretch" Cursor="Hand" Tag="{Binding}" Click="OnRoleItemClicked">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="10" Height="10" CornerRadius="5" Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Button Grid.Row="1" Style="{StaticResource IconButtonStyle}" Command="{Binding CreateNewRoleCommand}" Margin="0,8,0,0">
                                <Border Background="{StaticResource IconGradCyan}" CornerRadius="10" Padding="12,8">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Path Data="{StaticResource GeoPlus}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Создать новую роль" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Right: Role Properties & Permissions -->
                    <ScrollViewer Grid.Column="1" Padding="6,0,6,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Role Name -->
                            <TextBlock Text="НАЗВАНИЕ РОЛИ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="2,0,0,4" />
                            <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="10,6" Margin="0,0,0,12">
                                <TextBox Text="{Binding EditingRoleName, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" />
                            </Border>

                            <!-- Role Color -->
                            <TextBlock Text="ЦВЕТ РОЛИ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="2,0,0,6" />
                            <ItemsControl ItemsSource="{Binding ColorPresets}" Margin="0,0,0,14">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="26" Height="26" Margin="0,0,6,6" Background="{Binding Converter={StaticResource HexToBrush}}" BorderThickness="0" Cursor="Hand" Tag="{Binding}" Click="OnColorPresetClicked">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border CornerRadius="13" Background="{TemplateBinding Background}" BorderBrush="#FFFFFF" BorderThickness="1" />
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Permissions Checkboxes -->
                            <TextBlock Text="ПРАВА ДОСТУПА И РАЗРЕШЕНИЯ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource IconGradCyan}" Margin="2,0,0,8" />
                            <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <CheckBox Content="Отправка текстовых сообщений и файлов" IsChecked="{Binding PermSendMessages}" Margin="0,0,0,8" />
                                    <CheckBox Content="Подключение к голосовым и видеоканалам" IsChecked="{Binding PermConnectVoice}" Margin="0,0,0,8" />
                                    <CheckBox Content="Приоритетный голос (Priority Speaker)" IsChecked="{Binding PermPrioritySpeaker}" Margin="0,0,0,8" />
                                    <CheckBox Content="Управление структурой каналов" IsChecked="{Binding PermManageChannels}" Margin="0,0,0,8" />
                                    <CheckBox Content="Права администратора (Полный доступ)" IsChecked="{Binding PermAdministrator}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Footer Actions -->
                <Grid Grid.Row="2">
                    <Button HorizontalAlignment="Left" Style="{StaticResource IconButtonStyle}" Command="{Binding DeleteCurrentRoleCommand}">
                        <Border Background="#1AEF4444" BorderBrush="#4DEF4444" BorderThickness="1" CornerRadius="10" Padding="14,8">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoTrash}" Fill="#EF4444" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Удалить роль" FontSize="11" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Button>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource IconButtonStyle}" Command="{Binding CloseCommand}" Margin="0,0,8,0">
                            <Border Background="{DynamicResource CardHoverBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14,8">
                                <TextBlock Text="Отмена (Esc)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Command="{Binding SaveCurrentRoleCommand}">
                            <Border Background="{StaticResource IconGradCyan}" CornerRadius="10" Padding="18,8">
                                <TextBlock Text="Сохранить роль" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                            </Border>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
