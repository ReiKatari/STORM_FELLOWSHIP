<UserControl
    x:Class="StormFellowship.Views.Dialogs.UserSettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:StormFellowship.Helpers"
    mc:Ignorable="d">

    <Grid Background="{StaticResource ModalOverlayBackgroundBrush}">
        <Border Background="{StaticResource ModalDialogBackgroundBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                CornerRadius="16" Width="820" Height="620"
                VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Navigation Sidebar -->
                <Border Background="{StaticResource SidebarBackgroundBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0" Padding="16,20">
                    <StackPanel Spacing="6">
                        <!-- User Mini Card -->
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,16">
                            <Border Width="36" Height="36" CornerRadius="18" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5">
                                <Image Source="{x:Bind ViewModel.CurrentUser.AvatarPath, Mode=OneWay}" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.CurrentUser.DisplayName, Mode=OneWay}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.CurrentUser.FullUsername, Mode=OneWay}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="USER SETTINGS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,4" />

                        <!-- Nav Items -->
                        <Button x:Name="NavThemesBtn" Content="Appearance &amp; Themes" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="{StaticResource CardBackgroundBrush}" BorderThickness="0" CornerRadius="6" Padding="10,8" Click="OnNavThemesClicked" />
                        <Button x:Name="NavVoiceBtn" Content="Voice &amp; Video (TeamSpeak)" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0" CornerRadius="6" Padding="10,8" Click="OnNavVoiceClicked" />
                        <Button x:Name="NavProfileBtn" Content="Profile &amp; Status" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0" CornerRadius="6" Padding="10,8" Click="OnNavProfileClicked" />
                        <Button x:Name="NavAboutBtn" Content="About &amp; Info" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0" CornerRadius="6" Padding="10,8" Click="OnNavAboutClicked" />
                    </StackPanel>
                </Border>

                <!-- Right Content Pane -->
                <Grid Grid.Column="1" Padding="28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Close Button Top Right -->
                    <Button HorizontalAlignment="Right" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" Click="OnCloseClicked">
                        <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Button>

                    <!-- TAB 1: THEMES & APPEARANCE -->
                    <ScrollViewer x:Name="ThemesTab" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="18">
                            <StackPanel Spacing="4">
                                <TextBlock Text="APPEARANCE &amp; STORM THEMES" FontSize="20" FontWeight="Black" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Select from 4 bespoke, high-performance themes crafted for STORM FELLOWSHIP." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>

                            <!-- Theme Cards Grid -->
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 1. STORM DARK -->
                                <Border Grid.Row="0" Grid.Column="0" Margin="0,0,8,12" Background="#0B0F17" BorderBrush="#00A3FF" BorderThickness="2" CornerRadius="10" Padding="14">
                                    <StackPanel Spacing="10">
                                        <Grid>
                                            <TextBlock Text="STORM DARK" FontWeight="Bold" FontSize="14" Foreground="#F1F5F9" />
                                            <Border HorizontalAlignment="Right" Background="#3300A3FF" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="DEFAULT" FontSize="9" FontWeight="Bold" Foreground="#00A3FF" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="Deep navy/slate dark theme with electric cyan storm accents." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse Width="16" Height="16" Fill="#0B0F17" Stroke="#1E2B3D" StrokeThickness="1" />
                                            <Ellipse Width="16" Height="16" Fill="#131B26" />
                                            <Ellipse Width="16" Height="16" Fill="#00A3FF" />
                                        </StackPanel>
                                        <Button Content="Apply Storm Dark" HorizontalAlignment="Stretch" Background="#00A3FF" Foreground="#FFFFFF" FontWeight="SemiBold" CornerRadius="6" Click="OnApplyDarkClicked" />
                                    </StackPanel>
                                </Border>

                                <!-- 2. STORM NIGHT -->
                                <Border Grid.Row="0" Grid.Column="1" Margin="8,0,0,12" Background="#000000" BorderBrush="#00E5FF" BorderThickness="1.5" CornerRadius="10" Padding="14">
                                    <StackPanel Spacing="10">
                                        <Grid>
                                            <TextBlock Text="STORM NIGHT" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" />
                                            <Border HorizontalAlignment="Right" Background="#3300E5FF" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="OLED BLACK" FontSize="9" FontWeight="Bold" Foreground="#00E5FF" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="Pure pitch black &amp; carbon theme with neon cyber cyan glow." FontSize="11" Foreground="#A1A1AA" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse Width="16" Height="16" Fill="#000000" Stroke="#27272A" StrokeThickness="1" />
                                            <Ellipse Width="16" Height="16" Fill="#101014" />
                                            <Ellipse Width="16" Height="16" Fill="#00E5FF" />
                                        </StackPanel>
                                        <Button Content="Apply Storm Night" HorizontalAlignment="Stretch" Background="#18181E" BorderBrush="#00E5FF" BorderThickness="1" Foreground="#00E5FF" FontWeight="SemiBold" CornerRadius="6" Click="OnApplyNightClicked" />
                                    </StackPanel>
                                </Border>

                                <!-- 3. STORM DAY -->
                                <Border Grid.Row="1" Grid.Column="0" Margin="0,0,8,0" Background="#F1F5F9" BorderBrush="#0284C7" BorderThickness="1.5" CornerRadius="10" Padding="14">
                                    <StackPanel Spacing="10">
                                        <Grid>
                                            <TextBlock Text="STORM DAY" FontWeight="Bold" FontSize="14" Foreground="#0F172A" />
                                            <Border HorizontalAlignment="Right" Background="#200284C7" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="LIGHT" FontSize="9" FontWeight="Bold" Foreground="#0284C7" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="Clean, crisp modern light theme with storm blue accents." FontSize="11" Foreground="#475569" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse Width="16" Height="16" Fill="#F1F5F9" Stroke="#CBD5E1" StrokeThickness="1" />
                                            <Ellipse Width="16" Height="16" Fill="#FFFFFF" Stroke="#CBD5E1" StrokeThickness="1" />
                                            <Ellipse Width="16" Height="16" Fill="#0284C7" />
                                        </StackPanel>
                                        <Button Content="Apply Storm Day" HorizontalAlignment="Stretch" Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold" CornerRadius="6" Click="OnApplyDayClicked" />
                                    </StackPanel>
                                </Border>

                                <!-- 4. STORM MIDNIGHT -->
                                <Border Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" Background="#0D0714" BorderBrush="#A855F7" BorderThickness="1.5" CornerRadius="10" Padding="14">
                                    <StackPanel Spacing="10">
                                        <Grid>
                                            <TextBlock Text="STORM MIDNIGHT" FontWeight="Bold" FontSize="14" Foreground="#FAF5FF" />
                                            <Border HorizontalAlignment="Right" Background="#33A855F7" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="CYBER VIOLET" FontSize="9" FontWeight="Bold" Foreground="#A855F7" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="Cyberpunk deep violet &amp; purple storm aesthetic." FontSize="11" Foreground="#C084FC" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse Width="16" Height="16" Fill="#0D0714" Stroke="#3B1D5F" StrokeThickness="1" />
                                            <Ellipse Width="16" Height="16" Fill="#1C0F2E" />
                                            <Ellipse Width="16" Height="16" Fill="#A855F7" />
                                        </StackPanel>
                                        <Button Content="Apply Storm Midnight" HorizontalAlignment="Stretch" Background="#25143C" BorderBrush="#A855F7" BorderThickness="1" Foreground="#A855F7" FontWeight="SemiBold" CornerRadius="6" Click="OnApplyMidnightClicked" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- TAB 2: VOICE & VIDEO -->
                    <ScrollViewer x:Name="VoiceTab" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="VOICE &amp; AUDIO SETTINGS" FontSize="20" FontWeight="Black" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="TeamSpeak 5-grade ultra low-latency audio engine controls." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>

                            <!-- Audio Input Device -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="INPUT DEVICE (MICROPHONE)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                                <ComboBox ItemsSource="{x:Bind ViewModel.AudioInputDevices}" SelectedIndex="0" HorizontalAlignment="Stretch" Background="{StaticResource InputBackgroundBrush}" />
                            </StackPanel>

                            <!-- Live VU-Meter Mic Test -->
                            <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="8" Padding="14" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <Grid>
                                        <TextBlock Text="MIC TEST (LIVE VU-METER)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.MicLiveLevel, Mode=OneWay}" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />
                                    </Grid>
                                    <!-- Progress Bar -->
                                    <ProgressBar Value="{x:Bind ViewModel.MicLiveLevel, Mode=OneWay}" Maximum="100" Height="8" CornerRadius="4" Foreground="{StaticResource CallWaveformActiveBrush}" Background="{StaticResource InputBackgroundBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Voice Activity Detection Slider -->
                            <StackPanel Spacing="6">
                                <Grid>
                                    <TextBlock Text="VOICE ACTIVITY SENSITIVITY (VAD THRESHOLD)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.VadThreshold, Mode=OneWay}" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />
                                </Grid>
                                <Slider x:Name="VadSlider" Value="{x:Bind ViewModel.VadThreshold, Mode=TwoWay}" Minimum="0" Maximum="100" StepFrequency="1" />
                            </StackPanel>

                            <!-- Push to Talk Toggle & Keybind -->
                            <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="8" Padding="14" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Push-to-Talk (PTT)" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Hold a key to transmit voice instead of automatic voice detection." FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.IsPushToTalk, Mode=TwoWay}" OnContent="" OffContent="" />
                                </Grid>
                            </Border>

                            <!-- Audio Processing Options -->
                            <StackPanel Spacing="10">
                                <CheckBox Content="3D Positional Spatial Audio (TeamSpeak 3D Nodes)" IsChecked="{x:Bind ViewModel.Is3DPositionalAudio, Mode=TwoWay}" Foreground="{StaticResource TextPrimaryBrush}" />
                                <CheckBox Content="Krisp / RNNoise AI Noise Suppression" IsChecked="{x:Bind ViewModel.IsNoiseSuppression, Mode=TwoWay}" Foreground="{StaticResource TextPrimaryBrush}" />
                                <CheckBox Content="Acoustic Echo Cancellation" IsChecked="{x:Bind ViewModel.IsEchoCancellation, Mode=TwoWay}" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- TAB 3: USER PROFILE -->
                    <ScrollViewer x:Name="ProfileTab" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="USER PROFILE &amp; STATUS" FontSize="20" FontWeight="Black" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Customize your gaming identity, avatar, and custom status." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>

                            <!-- Status Options -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="ONLINE STATUS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="🟢 Online" Background="{StaticResource CardBackgroundBrush}" Click="OnStatusOnlineClicked" />
                                    <Button Content="🟡 Away / Idle" Background="{StaticResource CardBackgroundBrush}" Click="OnStatusIdleClicked" />
                                    <Button Content="🔴 Do Not Disturb" Background="{StaticResource CardBackgroundBrush}" Click="OnStatusDndClicked" />
                                    <Button Content="⚪ Invisible" Background="{StaticResource CardBackgroundBrush}" Click="OnStatusOfflineClicked" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Custom Status Input -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="CUSTOM STATUS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBox Text="{x:Bind ViewModel.CurrentUser.CustomStatus, Mode=TwoWay}" PlaceholderText="What's happening? (e.g. Exploring STORM FELLOWSHIP)" Background="{StaticResource InputBackgroundBrush}" />
                            </StackPanel>

                            <!-- Display Name -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="DISPLAY NAME" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBox Text="{x:Bind ViewModel.CurrentUser.DisplayName, Mode=TwoWay}" Background="{StaticResource InputBackgroundBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- TAB 4: ABOUT -->
                    <ScrollViewer x:Name="AboutTab" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="48" Height="48" CornerRadius="10" Background="{StaticResource AccentBrush}" Padding="6">
                                    <Image Source="ms-appx:///Assets/Icons/storm_logo_512.png" Stretch="Uniform" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="STORM FELLOWSHIP" FontSize="20" FontWeight="Black" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Version 0.0.1 (WinUI 3 / Windows App SDK)" FontSize="12" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                                </StackPanel>
                            </StackPanel>

                            <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="10" Padding="16" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Next-Generation Gaming &amp; Voice Platform" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Combines the best low-latency, high-fidelity voice channels of TeamSpeak with the modern UI, rich markdown messaging, stickers, emojis, and 1-on-1 direct calls of Discord."
                                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="Author: ReiKatari" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="Repository: https://github.com/ReiKatari/STORM_FELLOWSHIP" FontSize="11" Foreground="{StaticResource AccentBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
