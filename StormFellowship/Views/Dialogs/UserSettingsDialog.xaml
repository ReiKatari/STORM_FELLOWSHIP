<UserControl x:Class="StormFellowship.Views.Dialogs.UserSettingsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Backdrop Overlay (Click to close) -->
    <Grid Background="{DynamicResource ModalOverlayBackgroundBrush}" MouseDown="OnBackdropMouseDown">
        <Border Background="{DynamicResource ModalDialogBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Width="720" Height="580" HorizontalAlignment="Center" VerticalAlignment="Center" MouseDown="OnDialogCardMouseDown">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="54" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Background="{DynamicResource ModalHeaderBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="20,0">
                    <Grid VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚙️" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="НАСТРОЙКИ STORM FELLOWSHIP" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <!-- High Contrast Close Button -->
                        <Button HorizontalAlignment="Right" Width="32" Height="32" Background="Transparent" BorderThickness="0" Cursor="Hand" Command="{Binding CloseCommand}" ToolTip="Закрыть (ESC)">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CloseBorder" CornerRadius="6" Background="Transparent">
                                        <TextBlock Text="✕" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CloseBorder" Property="Background" Value="#EF4444" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Main Content Tabs -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Navigation Tabs -->
                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0" Padding="8,10">
                        <StackPanel>
                            <Button Content="🎨 Внешний вид и темы" Click="OnTabThemesClicked" Margin="0,2" Padding="12,8" HorizontalContentAlignment="Left" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="12" />
                            <Button Content="🎙️ Голос и звук" Click="OnTabAudioClicked" Margin="0,2" Padding="12,8" HorizontalContentAlignment="Left" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="12" />
                            <Button Content="👤 Профиль и статусы" Click="OnTabProfileClicked" Margin="0,2" Padding="12,8" HorizontalContentAlignment="Left" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="12" />
                            <Button Content="⌨️ Горячие клавиши" Click="OnTabHotkeysClicked" Margin="0,2" Padding="12,8" HorizontalContentAlignment="Left" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="12" />
                            <Button Content="ℹ️ О программе" Click="OnTabAboutClicked" Margin="0,2" Padding="12,8" HorizontalContentAlignment="Left" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                    </Border>

                    <!-- Right Tab Content View -->
                    <ScrollViewer Grid.Column="1" Padding="20" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <!-- TAB 1: THEMES -->
                            <StackPanel x:Name="TabThemesContent" Visibility="Visible">
                                <TextBlock Text="ВНЕШНИЙ ВИД И ТЕМЫ" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="Выберите тему оформления. Изменения применяются мгновенно." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,14" />

                                <UniformGrid Columns="2" Rows="2">
                                    <!-- Storm Dark -->
                                    <Button Margin="4" Padding="12" Background="#0B0F17" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" Cursor="Hand" Click="OnThemeDarkClicked">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Border Width="12" Height="12" CornerRadius="6" Background="#00A3FF" Margin="0,0,6,0" />
                                                <TextBlock Text="ТЕМНАЯ STORM" FontWeight="Bold" FontSize="11" Foreground="#F8FAFC" />
                                            </StackPanel>
                                            <TextBlock Text="Темно-синяя с цианом" FontSize="10" Foreground="#CBD5E1" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Storm Night -->
                                    <Button Margin="4" Padding="12" Background="#000000" BorderBrush="#00E5FF" BorderThickness="1" Cursor="Hand" Click="OnThemeNightClicked">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Border Width="12" Height="12" CornerRadius="6" Background="#00E5FF" Margin="0,0,6,0" />
                                                <TextBlock Text="НОЧНАЯ STORM" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" />
                                            </StackPanel>
                                            <TextBlock Text="Глубокий черный карбон" FontSize="10" Foreground="#E4E4E7" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Storm Day -->
                                    <Button Margin="4" Padding="12" Background="#F1F5F9" BorderBrush="#0284C7" BorderThickness="1" Cursor="Hand" Click="OnThemeDayClicked">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Border Width="12" Height="12" CornerRadius="6" Background="#0284C7" Margin="0,0,6,0" />
                                                <TextBlock Text="СВЕТЛАЯ STORM" FontWeight="Bold" FontSize="11" Foreground="#0F172A" />
                                            </StackPanel>
                                            <TextBlock Text="Контрастная светлая" FontSize="10" Foreground="#334155" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Storm Midnight -->
                                    <Button Margin="4" Padding="12" Background="#0D0714" BorderBrush="#A855F7" BorderThickness="1" Cursor="Hand" Click="OnThemeMidnightClicked">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Border Width="12" Height="12" CornerRadius="6" Background="#A855F7" Margin="0,0,6,0" />
                                                <TextBlock Text="ПОЛУНОЧЬ STORM" FontWeight="Bold" FontSize="11" Foreground="#FAF5FF" />
                                            </StackPanel>
                                            <TextBlock Text="Киберпанк фиолетовая" FontSize="10" Foreground="#E9D5FF" />
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>
                            </StackPanel>

                            <!-- TAB 2: VOICE & AUDIO -->
                            <StackPanel x:Name="TabAudioContent" Visibility="Collapsed">
                                <TextBlock Text="ЗВУКОВОЙ ДВИЖОК И УСТРОЙСТВА" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />

                                <!-- Input Device -->
                                <TextBlock Text="УСТРОЙСТВО ВВОДА (МИКРОФОН)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding AudioInputDevices}" SelectedItem="{Binding SelectedAudioInput}" Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="0" Maximum="100" Value="{Binding InputVolume}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding InputVolume, StringFormat='{}{0:0}%'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Directional Audio Mode Selection -->
                                <TextBlock Text="НАПРАВЛЕННОСТЬ ЗВУКА МИКРОФОНА:" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding DirectionModes}" SelectedItem="{Binding SelectedDirectionMode}" Margin="0,0,0,12" />

                                <!-- Output Device & Test Sound -->
                                <TextBlock Text="УСТРОЙСТВО ВЫВОДА (ДИНАМИКИ / НАУШНИКИ)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding AudioOutputDevices}" SelectedItem="{Binding SelectedAudioOutput}" Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="0" Maximum="100" Value="{Binding OutputVolume}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding OutputVolume, StringFormat='{}{0:0}%'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="10,0,12,0" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Content="🔊 Проверить звук" Command="{Binding TestAudioCommand}" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="12,5" Cursor="Hand" FontWeight="SemiBold" FontSize="11" />
                                </Grid>

                                <Separator Background="{DynamicResource DividerBrush}" Margin="0,4,0,12" />

                                <!-- Activation Mode -->
                                <TextBlock Text="Режим активации микрофона:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <RadioButton Content="Активация по голосу" IsChecked="{Binding IsVadMode}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,16,0" />
                                    <RadioButton Content="Нажми и говори" IsChecked="{Binding IsPttMode}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>

                                <TextBlock Text="Порог чувствительности микрофона:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <Slider Minimum="0" Maximum="100" Value="{Binding VadThreshold}" Margin="0,0,0,12" />

                                <TextBlock Text="Уровень микрофона в реальном времени:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <ProgressBar Value="{Binding LiveMicLevel, Mode=OneWay}" Minimum="0" Maximum="100" Height="8" Foreground="{DynamicResource StatusOnlineBrush}" Background="{DynamicResource CardBackgroundBrush}" Margin="0,0,0,14" />

                                <TextBlock Text="ШУМОПОДАВЛЕНИЕ СЛЕДУЮЩЕГО ПОКОЛЕНИЯ (AI DSP):" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding NoiseModes}" SelectedItem="{Binding SelectedNoiseMode}" Margin="0,0,0,12" />

                                <CheckBox Content="Звуковые сигналы событий" IsChecked="{Binding SoundCuesEnabled}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                <CheckBox Content="Пространственный 3D-звук (Spatial Proximity Audio)" IsChecked="{Binding SpatialAudioEnabled}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                <CheckBox Content="Режим экономии ресурсов (Lite Mode для ноутбуков)" IsChecked="{Binding IsLiteMode}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,10,0" />
                            </StackPanel>

                            <!-- TAB 3: USER PROFILE & STATUSES -->
                            <StackPanel x:Name="TabProfileContent" Visibility="Collapsed">
                                <TextBlock Text="ПРОФИЛЬ И СТАТУСЫ" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" />

                                <!-- Avatar Customization Block -->
                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Current Avatar Preview -->
                                        <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AvatarGlyph}" FontSize="28" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Avatar actions & Presets -->
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <Button Content="📁 Загрузить свой аватар..." Command="{Binding UploadCustomAvatarCommand}" Background="{DynamicResource AccentBrush}" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Padding="12,5" Cursor="Hand" FontSize="11" />
                                            </StackPanel>
                                            <TextBlock Text="Или выберите фирменную иконку:" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                                            <ItemsControl ItemsSource="{Binding AvatarPresets}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Width="28" Height="28" Margin="0,0,4,4" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Cursor="Hand" Tag="{Binding}" Click="OnAvatarPresetClicked">
                                                            <TextBlock Text="{Binding}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <TextBlock Text="Отображаемое имя:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" Padding="8,6" Margin="0,0,0,10" />

                                <TextBlock Text="Пользовательский статус:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding CustomStatus, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" Padding="8,6" Margin="0,0,0,12" />

                                <!-- 24+ Status Presets Grid -->
                                <TextBlock Text="КАТАЛОГ СТАТУСОВ (В 1 КЛИК):" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="8" MaxHeight="160">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding StatusPresets}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Margin="2" Padding="8,5" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Cursor="Hand" Tag="{Binding}" Click="OnStatusPresetClicked">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Icon}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Title}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>

                            <!-- TAB 4: HOTKEYS -->
                            <StackPanel x:Name="TabHotkeysContent" Visibility="Collapsed">
                                <TextBlock Text="ГОРЯЧИЕ КЛАВИШИ" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" />

                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Нажми и говори (Push to Talk)" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="Удерживайте для активации голоса" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="10,4">
                                            <TextBlock Text="{Binding PttKey}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Быстрое отключение микрофона (Mute)" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="Переключить микрофон" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="10,4">
                                            <TextBlock Text="Ctrl + Shift + M" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Заглушить все звуки (Deafen)" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="Отключить динамики и микрофон" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="10,4">
                                            <TextBlock Text="Ctrl + Shift + D" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- TAB 5: ABOUT -->
                            <StackPanel x:Name="TabAboutContent" Visibility="Collapsed">
                                <TextBlock Text="О ПРОГРАММЕ" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />

                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Image Source="pack://application:,,,/Assets/AppIcon.png" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="STORM FELLOWSHIP" FontWeight="Black" FontSize="15" Foreground="{DynamicResource AccentBrush}" />
                                                <TextBlock Text="Версия 0.0.5 • Высокопроизводительный звуковой движок" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="Профессиональная десктопная платформа нового поколения для общения, голосовых созвонов, видеосвязи и управления сообществами." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
                                        <TextBlock Text="Разработчик: ReiKatari" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- Footer Buttons -->
                <Border Grid.Row="2" Background="{DynamicResource ModalHeaderBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="20,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Закрыть" Command="{Binding CloseCommand}" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Padding="16,8" Margin="0,0,10,0" Cursor="Hand" FontWeight="SemiBold" FontSize="12" />
                        <Button Content="Сохранить изменения" Command="{Binding ApplySettingsCommand}" Background="{DynamicResource AccentBrush}" Foreground="#FFFFFF" BorderThickness="0" Padding="18,8" Cursor="Hand" FontWeight="Bold" FontSize="12">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
