<UserControl x:Class="StormFellowship.Views.Dialogs.UserSettingsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource ModalOverlayBackgroundBrush}">
        <Border Background="{DynamicResource ModalDialogBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Width="680" Height="520" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="52" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Background="{DynamicResource ModalHeaderBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="20,0">
                    <Grid VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚙" FontSize="16" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="STORM FELLOWSHIP SETTINGS" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Width="30" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand" Command="{Binding CloseCommand}">
                            <TextBlock Text="✕" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Main Content Tabs -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Navigation Tabs -->
                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0" Padding="8,10">
                        <StackPanel>
                            <Button Content="🎨 Themes &amp; UI" Click="OnTabThemesClicked" Margin="0,2" Padding="10,8" HorizontalContentAlignment="Left" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="12" />
                            <Button Content="🎙️ Voice &amp; Audio" Click="OnTabAudioClicked" Margin="0,2" Padding="10,8" HorizontalContentAlignment="Left" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="12" />
                            <Button Content="👤 User Profile" Click="OnTabProfileClicked" Margin="0,2" Padding="10,8" HorizontalContentAlignment="Left" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="12" />
                            <Button Content="⌨️ Hotkeys (PTT)" Click="OnTabHotkeysClicked" Margin="0,2" Padding="10,8" HorizontalContentAlignment="Left" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="12" />
                            <Button Content="ℹ️ About" Click="OnTabAboutClicked" Margin="0,2" Padding="10,8" HorizontalContentAlignment="Left" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                    </Border>

                    <!-- Right Tab Content View -->
                    <ScrollViewer Grid.Column="1" Padding="20" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <!-- TAB 1: THEMES -->
                            <StackPanel x:Name="TabThemesContent" Visibility="Visible">
                                <TextBlock Text="APPEARANCE &amp; THEMES" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="Select from the 4 custom Storm themes. Changes apply instantly." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,14" />

                                <UniformGrid Columns="2" Rows="2">
                                    <!-- Storm Dark -->
                                    <Button Margin="4" Padding="12" Background="#0B0F17" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" Cursor="Hand" Click="OnThemeDarkClicked">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Border Width="12" Height="12" CornerRadius="6" Background="#00A3FF" Margin="0,0,6,0" />
                                                <TextBlock Text="STORM DARK" FontWeight="Bold" FontSize="12" Foreground="#F1F5F9" />
                                            </StackPanel>
                                            <TextBlock Text="Navy &amp; slate with cyan" FontSize="10" Foreground="#94A3B8" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Storm Night -->
                                    <Button Margin="4" Padding="12" Background="#000000" BorderBrush="#00E5FF" BorderThickness="1" Cursor="Hand" Click="OnThemeNightClicked">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Border Width="12" Height="12" CornerRadius="6" Background="#00E5FF" Margin="0,0,6,0" />
                                                <TextBlock Text="STORM NIGHT" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" />
                                            </StackPanel>
                                            <TextBlock Text="OLED carbon black neon" FontSize="10" Foreground="#666666" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Storm Day -->
                                    <Button Margin="4" Padding="12" Background="#F1F5F9" BorderBrush="#0284C7" BorderThickness="1" Cursor="Hand" Click="OnThemeDayClicked">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Border Width="12" Height="12" CornerRadius="6" Background="#0284C7" Margin="0,0,6,0" />
                                                <TextBlock Text="STORM DAY" FontWeight="Bold" FontSize="12" Foreground="#0F172A" />
                                            </StackPanel>
                                            <TextBlock Text="Clean high-contrast light" FontSize="10" Foreground="#475569" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Storm Midnight -->
                                    <Button Margin="4" Padding="12" Background="#0D0714" BorderBrush="#A855F7" BorderThickness="1" Cursor="Hand" Click="OnThemeMidnightClicked">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Border Width="12" Height="12" CornerRadius="6" Background="#A855F7" Margin="0,0,6,0" />
                                                <TextBlock Text="STORM MIDNIGHT" FontWeight="Bold" FontSize="12" Foreground="#FAF5FF" />
                                            </StackPanel>
                                            <TextBlock Text="Cyberpunk neon violet" FontSize="10" Foreground="#C084FC" />
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>
                            </StackPanel>

                            <!-- TAB 2: VOICE & AUDIO (Audio Engine) -->
                            <StackPanel x:Name="TabAudioContent" Visibility="Collapsed">
                                <TextBlock Text="STORM AUDIO ENGINE" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" />

                                <TextBlock Text="Input Mode:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <RadioButton Content="Voice Activity Detection (VAD)" IsChecked="{Binding IsVadMode}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,16,0" />
                                    <RadioButton Content="Push-to-Talk (PTT)" IsChecked="{Binding IsPttMode}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>

                                <TextBlock Text="VAD Sensitivity Threshold:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <Slider Minimum="0" Maximum="100" Value="{Binding VadThreshold}" Margin="0,0,0,12" />

                                <TextBlock Text="Live Mic VU-Meter:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <ProgressBar Value="{Binding LiveMicLevel, Mode=OneWay}" Minimum="0" Maximum="100" Height="8" Foreground="{DynamicResource StatusOnlineBrush}" Background="{DynamicResource CardBackgroundBrush}" Margin="0,0,0,14" />

                                <CheckBox Content="Enable Sound Cues (Mute/Join/Leave)" IsChecked="{Binding SoundCuesEnabled}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                <CheckBox Content="Enable 3D Positional Spatial Audio" IsChecked="{Binding SpatialAudioEnabled}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                <CheckBox Content="AI Background Noise Suppression (RNNoise)" IsChecked="{Binding NoiseSuppressionEnabled}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                            </StackPanel>

                            <!-- TAB 3: USER PROFILE -->
                            <StackPanel x:Name="TabProfileContent" Visibility="Collapsed">
                                <TextBlock Text="USER PROFILE" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" />
                                <TextBlock Text="Display Name:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" Padding="8,6" Margin="0,0,0,10" />
                                <TextBlock Text="Custom Status:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding CustomStatus, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" Padding="8,6" />
                            </StackPanel>

                            <!-- TAB 4: HOTKEYS -->
                            <StackPanel x:Name="TabHotkeysContent" Visibility="Collapsed">
                                <TextBlock Text="HOTKEYS &amp; PUSH-TO-TALK" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" />
                                <Border Background="{DynamicResource CardBackgroundBrush}" Padding="12" CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Push-to-Talk Hotkey" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="Hold this key to transmit voice in channels" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="{Binding PttKeyName}" Background="{DynamicResource AccentBrush}" Foreground="#FFFFFF" FontWeight="Bold" Padding="12,4" Cursor="Hand" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- TAB 5: ABOUT -->
                            <StackPanel x:Name="TabAboutContent" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource AccentBrush}" Margin="0,0,10,0">
                                        <TextBlock Text="⚡" FontSize="20" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="STORM FELLOWSHIP" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="Version 0.0.1 (Official Release)" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="High-performance modern communication, voice and fellowship platform." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <TextBlock Text="Featuring low-latency high-fidelity voice engine with rich chat, stickers &amp; fellowships." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- Footer -->
                <Border Grid.Row="2" Background="{DynamicResource ModalHeaderBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="20,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Close" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="16,6" Margin="0,0,10,0" Cursor="Hand" Command="{Binding CloseCommand}" />
                        <Button Content="Save Changes" Background="{DynamicResource AccentBrush}" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" Padding="16,6" Cursor="Hand" Command="{Binding SaveCommand}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
