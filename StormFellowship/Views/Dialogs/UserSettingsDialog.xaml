<UserControl x:Class="StormFellowship.Views.Dialogs.UserSettingsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Backdrop Overlay -->
    <Grid Background="{DynamicResource ModalOverlayBackgroundBrush}" MouseDown="OnBackdropMouseDown">
        <Border Background="{DynamicResource ModalDialogBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1.5" CornerRadius="16" Width="760" Height="580" HorizontalAlignment="Center" VerticalAlignment="Center" MouseDown="OnDialogCardMouseDown">
            <Border.Effect>
                <DropShadowEffect Color="#00A3FF" BlurRadius="24" ShadowDepth="0" Opacity="0.35" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="54" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="54" />
                </Grid.RowDefinitions>

                <!-- Modal Header -->
                <Border Background="{DynamicResource ModalHeaderBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="20,0" CornerRadius="16,16,0,0">
                    <Grid VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoGear}" Fill="{DynamicResource AccentBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="НАСТРОЙКИ STORM FELLOWSHIP" FontWeight="Black" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- High-Contrast Vector Close Button with Crimson Hover -->
                        <Button HorizontalAlignment="Right" Width="32" Height="32" Background="Transparent" BorderThickness="0" Cursor="Hand" Command="{Binding CloseModalCommand}" ToolTip="Закрыть (ESC)">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CloseBorder" CornerRadius="8" Background="Transparent">
                                        <Path Data="{StaticResource GeoWinClose}" Stroke="#FFFFFF" StrokeThickness="1.8" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CloseBorder" Property="Background" Value="#E11D48" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Body (Sidebar Navigation + Tab Content) -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Tab Navigation Bar -->
                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0" Padding="12,14">
                        <StackPanel>
                            <TextBlock Text="ОСНОВНЫЕ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="8,0,0,10" />

                            <!-- Tab 1: Themes -->
                            <Button x:Name="BtnTabThemes" Click="OnTabThemesClicked" Margin="0,3" Padding="10,8" Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="24" Height="24" CornerRadius="6" Background="#1A00D2FF" Margin="0,0,10,0">
                                                    <Path Data="{StaticResource GeoDashboard}" Fill="{StaticResource IconGradCyan}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Темы и Оформление" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Tab 2: Audio -->
                            <Button x:Name="BtnTabAudio" Click="OnTabAudioClicked" Margin="0,3" Padding="10,8" Background="Transparent" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="24" Height="24" CornerRadius="6" Background="#1A34D399" Margin="0,0,10,0">
                                                    <Path Data="{StaticResource GeoMic}" Fill="{StaticResource IconGradEmerald}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Голос и Звук" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Tab 3: Profile -->
                            <Button x:Name="BtnTabProfile" Click="OnTabProfileClicked" Margin="0,3" Padding="10,8" Background="Transparent" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="24" Height="24" CornerRadius="6" Background="#1AC084FC" Margin="0,0,10,0">
                                                    <Path Data="{StaticResource GeoUsers}" Fill="{StaticResource IconGradPurple}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Профиль и Статусы" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Tab 4: Hotkeys -->
                            <Button x:Name="BtnTabHotkeys" Click="OnTabHotkeysClicked" Margin="0,3" Padding="10,8" Background="Transparent" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="24" Height="24" CornerRadius="6" Background="#1AFBBF24" Margin="0,0,10,0">
                                                    <Path Data="{StaticResource GeoCommand}" Fill="{StaticResource IconGradAmber}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Горячие клавиши" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Tab 5: About -->
                            <Button x:Name="BtnTabAbout" Click="OnTabAboutClicked" Margin="0,3" Padding="10,8" Background="Transparent" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="24" Height="24" CornerRadius="6" Background="#1A38BDF8" Margin="0,0,10,0">
                                                    <Path Data="{StaticResource GeoShieldLock}" Fill="{StaticResource IconGradSky}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="О программе" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Right Tab Content Area -->
                    <ScrollViewer Grid.Column="1" Padding="20,16" VerticalScrollBarVisibility="Auto">
                        <StackPanel>

                            <!-- TAB 1: THEMES & ACCENTS -->
                            <StackPanel x:Name="TabThemesContent" Visibility="Visible">
                                <TextBlock Text="ТЕМЫ ОФОРМЛЕНИЯ И АКЦЕНТЫ" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />

                                <UniformGrid Columns="2" Margin="0,0,0,16">
                                    <Border Margin="4" CornerRadius="10" Background="#0F172A" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1.5" Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="Storm Dark (Основная)" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" Margin="0,0,0,6" />
                                            <Button Content="Выбрать тему" Click="OnThemeDarkClicked" Background="{DynamicResource AccentBrush}" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Padding="10,5" Cursor="Hand" FontSize="10" />
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="4" CornerRadius="10" Background="#000000" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1.5" Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="Storm Night (Глубокая)" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" Margin="0,0,0,6" />
                                            <Button Content="Выбрать тему" Click="OnThemeNightClicked" Background="{DynamicResource AccentBrush}" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Padding="10,5" Cursor="Hand" FontSize="10" />
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="4" CornerRadius="10" Background="#0A0E17" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1.5" Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="Storm Midnight (Полночь)" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" Margin="0,0,0,6" />
                                            <Button Content="Выбрать тему" Click="OnThemeMidnightClicked" Background="{DynamicResource AccentBrush}" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Padding="10,5" Cursor="Hand" FontSize="10" />
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="4" CornerRadius="10" Background="#1E293B" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1.5" Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="Storm Day (Светлый графит)" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" Margin="0,0,0,6" />
                                            <Button Content="Выбрать тему" Click="OnThemeDayClicked" Background="{DynamicResource AccentBrush}" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Padding="10,5" Cursor="Hand" FontSize="10" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- Accent Color Palette Selector -->
                                <TextBlock Text="ФИРМЕННЫЙ АКЦЕНТНЫЙ ЦВЕТ (PALETTE):" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding AccentColorPalette}" Margin="0,0,0,16">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Width="32" Height="32" Margin="0,0,8,8" Background="{Binding Hex, Converter={StaticResource HexToBrush}}" BorderThickness="0" Cursor="Hand" Command="{Binding DataContext.SelectAccentColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="{Binding Name}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border CornerRadius="16" Background="{TemplateBinding Background}" BorderBrush="#FFFFFF" BorderThickness="1.5" />
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- TAB 2: VOICE & AUDIO WITH VU-METER -->
                            <StackPanel x:Name="TabAudioContent" Visibility="Collapsed">
                                <TextBlock Text="ЗВУКОВОЙ ДВИЖОК И УСТРОЙСТВА" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />

                                <!-- Input Device -->
                                <TextBlock Text="УСТРОЙСТВО ВВОДА (МИКРОФОН)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding AudioInputDevices}" SelectedItem="{Binding SelectedAudioInput}" Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="0" Maximum="100" Value="{Binding InputVolume}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding InputVolume, StringFormat='{}{0:0}%'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Directional Audio Mode Selection -->
                                <TextBlock Text="НАПРАВЛЕННОСТЬ ЗВУКА МИКРОФОНА:" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding DirectionModes}" SelectedItem="{Binding SelectedDirectionMode}" Margin="0,0,0,12" />

                                <!-- Output Device & Test Sound -->
                                <TextBlock Text="УСТРОЙСТВО ВЫВОДА (ДИНАМИКИ / НАУШНИКИ)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding AudioOutputDevices}" SelectedItem="{Binding SelectedAudioOutput}" Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="0" Maximum="100" Value="{Binding OutputVolume}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding OutputVolume, StringFormat='{}{0:0}%'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="10,0,12,0" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Command="{Binding TestAudioCommand}" Style="{StaticResource IconButtonStyle}">
                                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource GeoVolumeUp}" Fill="{StaticResource IconGradCyan}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Проверить звук" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </Grid>

                                <Separator Background="{DynamicResource DividerBrush}" Margin="0,4,0,12" />

                                <!-- VU METER -->
                                <TextBlock Text="УРОВЕНЬ МИКРОФОНА (VU-METER):" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <ProgressBar Value="{Binding LiveMicLevel, Mode=OneWay}" Minimum="0" Maximum="100" Height="8" Foreground="{DynamicResource StatusOnlineBrush}" Background="{DynamicResource CardBackgroundBrush}" Margin="0,0,0,14" />

                                <!-- 30 Voice Morpher FX Presets -->
                                <TextBlock Text="ИЗМЕНЕНИЕ ГОЛОСА В РЕАЛЬНОМ ВРЕМЕНИ (30 МОДЕЛЕЙ):" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding VoiceChangerPresets}" SelectedItem="{Binding SelectedVoiceChangerPreset}" DisplayMemberPath="Name" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Command="{Binding PreviewVoiceChangerCommand}" Style="{StaticResource IconButtonStyle}" Margin="8,0,0,0">
                                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource GeoSpeaker}" Fill="{StaticResource IconGradEmerald}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Демо-сигнал" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </Grid>

                                <!-- Live Mic Monitoring Card (Hear Yourself Live) -->
                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1.5" CornerRadius="10" Padding="12,10" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                <Path Data="{StaticResource GeoMic}" Fill="{StaticResource IconGradCyan}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Услышать свой измененный голос (Live Мониторинг):" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="Включите и говорите в микрофон, чтобы услышать эффект в реальном времени" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" IsChecked="{Binding IsMicMonitoringLoopbackEnabled, Mode=TwoWay}" Cursor="Hand" Margin="10,0,0,0">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="TogglePill" Width="68" Height="28" CornerRadius="14" Background="#1E293B" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                                        <Grid>
                                                            <TextBlock x:Name="ToggleText" Text="ВЫКЛ" FontSize="9" FontWeight="Black" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                            <Ellipse x:Name="ToggleKnob" Width="20" Height="20" Fill="#64748B" HorizontalAlignment="Left" Margin="4,0,0,0" />
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="TogglePill" Property="Background" Value="{StaticResource IconGradCyan}" />
                                                            <Setter TargetName="TogglePill" Property="BorderThickness" Value="0" />
                                                            <Setter TargetName="ToggleKnob" Property="Fill" Value="#FFFFFF" />
                                                            <Setter TargetName="ToggleKnob" Property="HorizontalAlignment" Value="Right" />
                                                            <Setter TargetName="ToggleKnob" Property="Margin" Value="0,0,4,0" />
                                                            <Setter TargetName="ToggleText" Property="Text" Value="ВКЛ" />
                                                            <Setter TargetName="ToggleText" Property="Foreground" Value="#FFFFFF" />
                                                            <Setter TargetName="ToggleText" Property="HorizontalAlignment" Value="Left" />
                                                            <Setter TargetName="ToggleText" Property="Margin" Value="10,0,0,0" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                    </Grid>
                                </Border>

                                <!-- Voice FX Presets & Equalizer -->
                                <TextBlock Text="ГОЛОСОВОЙ ЭКВАЛАЙЗЕР И СТУДИЙНЫЙ ТОНБЛОК:" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding FxPresets}" SelectedItem="{Binding SelectedFxPreset}" Margin="0,0,0,12" />

                                <!-- Zero-Copy SIMD AVX2 Status -->
                                <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                <Path Data="{StaticResource GeoLightning}" Fill="{StaticResource IconGradCyan}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="ZERO-COPY SIMD DSP PIPELINE:" FontSize="10" FontWeight="Black" Foreground="{StaticResource IconGradCyan}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding DspInstructionSet}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#1A34D399" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="Задержка &lt; 2.5 мс" FontSize="10" FontWeight="Bold" Foreground="#34D399" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Audio Ducking & Game Attenuation -->
                                <TextBlock Text="ПРИГЛУШЕНИЕ ИГР И ФОНОВЫХ ПРОГРАММ ПРИ РЕЧИ (DUCKING):" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="10" Maximum="70" Value="{Binding DuckingPercent}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding DuckingPercent, StringFormat='{}–{0:0}%'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Smart Voice Isolation -->
                                <TextBlock Text="SMART VOICE ISOLATION (ОТСЕЧЕНИЕ КЛИКОВ КЛАВИАТУРЫ И ДЫХАНИЯ):" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="0" Maximum="100" Value="{Binding SmartKeySuppression}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding SmartKeySuppression, StringFormat='{}Кнопки: {0:0}%'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Live Translation -->
                                <TextBlock Text="СИНХРОННЫЙ ПЕРЕВОД СООБЩЕНИЙ И СУБТИТРОВ РЕЧИ (LIVE TRANSLATION):" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding SelectedLanguage}" DisplayMemberPath="Name" Margin="0,0,0,12" />

                                <!-- Storm Backup & Sync -->
                                <TextBlock Text="РЕЗЕРВНОЕ КОПИРОВАНИЕ И СИНХРОНИЗАЦИЯ (.STORMBACKUP):" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Button Command="{Binding ExportBackupCommand}" Style="{StaticResource IconButtonStyle}" Margin="0,0,8,0">
                                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource GeoSave}" Fill="{StaticResource IconGradCyan}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Экспорт профиля (.stormbackup)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                    <Button Command="{Binding ImportBackupCommand}" Style="{StaticResource IconButtonStyle}">
                                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource GeoUpload}" Fill="{StaticResource IconGradPurple}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Восстановить из файла" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </StackPanel>

                                <CheckBox Content="Звуковые сигналы событий (Mute/Deafen/Join)" IsChecked="{Binding SoundCuesEnabled}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                <CheckBox Content="Пространственный 3D-звук (Spatial Proximity Audio)" IsChecked="{Binding SpatialAudioEnabled}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                <CheckBox Content="Режим экономии ресурсов (Lite Mode для ноутбуков)" IsChecked="{Binding IsLiteMode}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,10,0" />
                            </StackPanel>

                            <!-- TAB 3: USER PROFILE & CUSTOM BANNER -->
                            <StackPanel x:Name="TabProfileContent" Visibility="Collapsed">
                                <TextBlock Text="ПРОФИЛЬ И ПЕРСОНАЛИЗАЦИЯ" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" />

                                <!-- Interactive Profile Card with Banner Preview -->
                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Margin="0,0,0,14">
                                    <StackPanel>
                                        <!-- Profile Banner Header -->
                                        <Border Height="60" CornerRadius="12,12,0,0" Background="{Binding ProfileBannerHex, Converter={StaticResource HexToBrush}}" Padding="12">
                                            <TextBlock Text="STORM FELLOWSHIP MEMBER" FontSize="10" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Right" />
                                        </Border>
                                        <Border Padding="14" Margin="0,-24,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Avatar Preview (Vector Glyph or Custom Image) -->
                                                <Grid Width="60" Height="60">
                                                    <Border Width="60" Height="60" CornerRadius="30" Background="{StaticResource IconGradCyan}" BorderBrush="{DynamicResource CardBackgroundBrush}" BorderThickness="3" Visibility="{Binding HasCustomAvatar, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                                        <Path Data="{Binding AvatarGlyph, Converter={StaticResource GeoKeyToGeo}}" Fill="#FFFFFF" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <Border Width="60" Height="60" CornerRadius="30" BorderBrush="{DynamicResource CardBackgroundBrush}" BorderThickness="3" Visibility="{Binding HasCustomAvatar, Converter={StaticResource BoolToVis}}">
                                                        <Border.Background>
                                                             <ImageBrush ImageSource="{Binding AvatarPath}" Stretch="UniformToFill" />
                                                        </Border.Background>
                                                    </Border>
                                                </Grid>

                                                <StackPanel Grid.Column="1" Margin="14,14,0,0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                        <Button Command="{Binding UploadCustomAvatarCommand}" Style="{StaticResource IconButtonStyle}" Margin="0,0,8,0">
                                                            <Border Background="{StaticResource IconGradCyan}" CornerRadius="8" Padding="12,6">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Path Data="{StaticResource GeoImage}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                    <TextBlock Text="Загрузить аватар..." FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Border>
                                                        </Button>
                                                        <Button Command="{Binding ResetCustomAvatarCommand}" Style="{StaticResource IconButtonStyle}" Visibility="{Binding HasCustomAvatar, Converter={StaticResource BoolToVis}}">
                                                            <Border Background="#1AEF4444" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="8" Padding="10,6">
                                                                <TextBlock Text="Сбросить" FontSize="11" FontWeight="Bold" Foreground="#EF4444" />
                                                            </Border>
                                                        </Button>
                                                    </StackPanel>
                                                    <TextBlock Text="Или выберите векторную эмблему профиля:" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6" />
                                                    <ItemsControl ItemsSource="{Binding AvatarPresets}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Width="34" Height="34" Margin="0,0,6,6" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Cursor="Hand" Tag="{Binding}" Click="OnAvatarPresetClicked" ToolTip="{Binding Name}">
                                                                    <Border Width="26" Height="26" CornerRadius="7" Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}" Opacity="0.9">
                                                                        <Path Data="{Binding IconGeo, Converter={StaticResource GeoKeyToGeo}}" Fill="#FFFFFF" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Отображаемое имя:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" Padding="8,6" Margin="0,0,0,10" />

                                <TextBlock Text="Пользовательский статус:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding CustomStatus, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" Padding="8,6" Margin="0,0,0,12" />

                                <!-- Status Presets -->
                                <TextBlock Text="КАТАЛОГ СТАТУСОВ (В 1 КЛИК):" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="8" MaxHeight="140">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding StatusPresets}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Margin="0,0,6,6" Padding="8,5" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Cursor="Hand" Tag="{Binding}" Click="OnStatusPresetClicked">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Width="20" Height="20" CornerRadius="5" Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                <Path Data="{Binding IconGeo, Converter={StaticResource GeoKeyToGeo}}" Fill="#FFFFFF" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>

                            <!-- TAB 4: HOTKEYS -->
                            <StackPanel x:Name="TabHotkeysContent" Visibility="Collapsed">
                                <TextBlock Text="ГОРЯЧИЕ КЛАВИШИ И УПРАВЛЕНИЕ" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />
                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,4">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource GeoGamepad}" Fill="{StaticResource IconGradPurple}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Игровой оверлей поверх DirectX/Vulkan" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Border HorizontalAlignment="Right" Background="{DynamicResource InputBackgroundBrush}" CornerRadius="4" Padding="8,3">
                                                <TextBlock Text="Shift + ~" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                        </Grid>
                                        <Grid Margin="0,4">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource GeoSearch}" Fill="{StaticResource IconGradSky}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Полнотекстовый поиск" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Border HorizontalAlignment="Right" Background="{DynamicResource InputBackgroundBrush}" CornerRadius="4" Padding="8,3">
                                                <TextBlock Text="Ctrl + F" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                        </Grid>
                                        <Grid Margin="0,4">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource GeoClose}" Fill="{DynamicResource TextMutedBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Закрытие всех окон и диалогов" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Border HorizontalAlignment="Right" Background="{DynamicResource InputBackgroundBrush}" CornerRadius="4" Padding="8,3">
                                                <TextBlock Text="ESC" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- TAB 5: ABOUT & CLOUD SYNC -->
                            <StackPanel x:Name="TabAboutContent" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Image Source="pack://application:,,,/Assets/AppIcon.png" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="STORM FELLOWSHIP" FontWeight="Black" FontSize="16" Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock Text="Версия 0.2.2 (WinUI 3 Fluent 2 &amp; Ultra Low-Latency SIMD Edition)" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="Разработчик: ReiKatari" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="Репозиторий: https://github.com/ReiKatari/STORM_FELLOWSHIP" FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12" />

                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Path Data="{StaticResource GeoCloudSync}" Fill="{StaticResource IconGradCyan}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Тестирование с другими пользователями и Облако" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="• Приглашение друзей: Отправьте другу инвайт-ссылку storm://invite/fellowship_id или код содружества. Друг нажимает «+» в левом сайдбаре и входит в содружество." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,4" />
                                        <TextBlock Text="• Облачная синхронизация: Профиль, темы и настройки автоматически сохраняются в постоянное хранилище %AppData%\StormFellowship и защищены AES-256 GCM." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,4" />
                                        <TextBlock Text="• Realtime P2P Mesh: Голос и видео транслируются напрямую между клиентами без задержек через WebRTC/Opus HD." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Modal Footer Actions -->
                <Border Grid.Row="2" Background="{DynamicResource ModalHeaderBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="20,0" CornerRadius="0,0,16,16">
                    <Grid VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Закрыть" Command="{Binding CloseModalCommand}" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" FontWeight="SemiBold" FontSize="12" />
                            <Button Content="Сохранить настройки" Command="{Binding ApplySettingsCommand}" Background="{DynamicResource AccentBrush}" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Padding="18,7" Cursor="Hand" FontSize="12" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
