<UserControl x:Class="StormFellowship.Views.Dialogs.CreateFellowshipDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Backdrop (Click to close) -->
    <Grid Background="{DynamicResource ModalOverlayBackgroundBrush}" MouseDown="OnBackdropMouseDown">
        <Border Background="{DynamicResource ModalDialogBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" MouseDown="OnDialogCardMouseDown">
            <StackPanel>
                <!-- Title -->
                <TextBlock Text="СОЗДАНИЕ ИЛИ ВХОД В СОДРУЖЕСТВО" FontWeight="Black" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                <TextBlock Text="Содружество — это ваше личное пространство для общения с друзьями и командой." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20" />

                <!-- Fellowship Name Input -->
                <TextBlock Text="НАЗВАНИЕ СОДРУЖЕСТВА" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                <TextBox Text="{Binding FellowshipNameInput, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" Padding="10,8" Margin="0,0,0,16" />

                <!-- Join Code Input -->
                <TextBlock Text="ИЛИ ВОЙТИ ПО КОДУ ПРИГЛАШЕНИЯ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding JoinCodeInput, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" Padding="10,8" />
                    <Button Grid.Column="1" Content="Войти" Margin="8,0,0,0" Padding="16,0" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Cursor="Hand" Command="{Binding JoinWithCodeCommand}" />
                </Grid>

                <!-- Actions -->
                <Grid>
                    <Button Content="Отмена" HorizontalAlignment="Left" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand" Command="{Binding CloseCommand}" />
                    <Button Content="Создать содружество" HorizontalAlignment="Right" Background="{DynamicResource AccentBrush}" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Padding="18,8" Cursor="Hand" Command="{Binding CreateCommand}" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
