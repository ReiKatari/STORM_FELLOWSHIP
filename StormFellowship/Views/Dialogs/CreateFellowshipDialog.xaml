<UserControl
    x:Class="StormFellowship.Views.Dialogs.CreateFellowshipDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{StaticResource ModalOverlayBackgroundBrush}">
        <Border Background="{StaticResource ModalDialogBackgroundBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                CornerRadius="14" Width="460" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
            <StackPanel Spacing="16">
                <!-- Header -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="CREATE A FELLOWSHIP" FontSize="18" FontWeight="Black" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Your fellowship is where you and your gaming clan hang out and talk." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0" Click="OnCloseClicked">
                        <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                    </Button>
                </Grid>

                <!-- Server Name Input -->
                <StackPanel Spacing="6">
                    <TextBlock Text="FELLOWSHIP NAME" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBox x:Name="FellowshipNameInput" Text="My Storm Guild" Background="{StaticResource InputBackgroundBrush}"
                             BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>

                <!-- Server Description -->
                <StackPanel Spacing="6">
                    <TextBlock Text="DESCRIPTION / TOPIC" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBox x:Name="FellowshipDescInput" Text="A new realm for tactical ops and voice gaming." Background="{StaticResource InputBackgroundBrush}"
                             BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>

                <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="0,4" />

                <!-- Join with Code -->
                <StackPanel Spacing="6">
                    <TextBlock Text="HAVE AN INVITE ALREADY?" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InviteCodeInput" PlaceholderText="storm://invite/code or invite code..." Background="{StaticResource InputBackgroundBrush}"
                                 BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                        <Button Grid.Column="1" Content="Join" Margin="8,0,0,0" Padding="14,6" CornerRadius="6"
                                Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                Click="OnJoinWithCodeClicked" />
                    </Grid>
                </StackPanel>

                <!-- Actions -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Content="Back" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}" Click="OnCloseClicked" />
                    <Button Grid.Column="1" Content="Create Fellowship" Background="{StaticResource AccentBrush}" Foreground="{StaticResource TextOnAccentBrush}"
                            FontWeight="Bold" CornerRadius="6" Padding="18,8" Click="OnCreateClicked" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
