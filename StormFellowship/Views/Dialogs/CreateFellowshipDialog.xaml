<UserControl x:Class="StormFellowship.Views.Dialogs.CreateFellowshipDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Backdrop Overlay (Click to close) -->
    <Grid Background="#85000000" MouseDown="OnBackdropMouseDown">
        <Border Width="560" MaxHeight="660" Background="{DynamicResource CardBackgroundBrush}" 
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1.5" 
                CornerRadius="20" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                MouseDown="OnDialogCardMouseDown">
            <Border.Effect>
                <DropShadowEffect Color="#00D2FF" BlurRadius="36" ShadowDepth="8" Opacity="0.25" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="44" Height="44" CornerRadius="14" Background="#2600D2FF" BorderBrush="#4D00D2FF" BorderThickness="1.5" Margin="0,0,14,0">
                            <Path Data="{StaticResource GeoShieldLock}" Fill="{StaticResource IconGradCyan}" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="СОЗДАНИЕ ИЛИ ВХОД В СОДРУЖЕСТВО" FontWeight="Black" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,2" />
                            <TextBlock Text="Защищенное пространство со сквозным шифрованием E2EE" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Style="{StaticResource IconButtonStyle}" Command="{Binding CloseCreateFellowshipDialogCommand}" ToolTip="Закрыть (Esc)">
                        <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource CardHoverBrush}">
                            <Path Data="{StaticResource GeoClose}" Fill="{DynamicResource TextSecondaryBrush}" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Button>
                </Grid>

                <!-- Scrollable Body -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,18">
                    <StackPanel>
                        <!-- 1. CREATE SECTION -->
                        <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Path Data="{StaticResource GeoPlus}" Fill="{StaticResource IconGradCyan}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="СОЗДАТЬ НОВОЕ СОДРУЖЕСТВО" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Fellowship Name -->
                                <TextBlock Text="НАЗВАНИЕ СОДРУЖЕСТВА" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="2,0,0,6" />
                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,12">
                                    <TextBox Text="{Binding FellowshipNameInput, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" />
                                </Border>

                                <!-- Security & Protection Shield Options -->
                                <TextBlock Text="ПАРАМЕТРЫ ЗАЩИТЫ И БЕЗОПАСНОСТИ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource IconGradCyan}" Margin="2,4,0,8" />
                                
                                <Border Background="#111827" BorderBrush="#2600D2FF" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <CheckBox IsChecked="True" Content="E2EE Сквозное шифрование всех каналов (AES-256-GCM)" Margin="0,0,0,8" />
                                        <CheckBox IsChecked="True" Content="Auto-Mod Защита от спама, ботов и рейдов" Margin="0,0,0,8" />
                                        <CheckBox IsChecked="True" Content="Защищенные одноразовые ссылки-приглашения" Margin="0,0,0,8" />
                                        <CheckBox IsChecked="False" Content="Требовать двухфакторную аутентификацию (2FA) для модераторов" />
                                    </StackPanel>
                                </Border>

                                <Button HorizontalAlignment="Right" Style="{StaticResource IconButtonStyle}" Command="{Binding CreateFellowshipCommand}">
                                    <Border Background="{StaticResource IconGradCyan}" CornerRadius="10" Padding="18,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource GeoShield}" Fill="#FFFFFF" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Создать содружество" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- 2. METHOD 1: JOIN VIA INVITE CODE / LINK -->
                        <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Path Data="{StaticResource GeoCommand}" Fill="{StaticResource IconGradPurple}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="СПОСОБ 1: ССЫЛКА-ПРИГЛАШЕНИЕ ИЛИ КОД" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Передайте другу инвайт-ссылку storm://invite/код или введите полученный код ниже:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="12,8">
                                        <TextBox Text="{Binding JoinCodeInput, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" />
                                    </Border>
                                    <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource IconButtonStyle}" Command="{Binding JoinWithCodeCommand}">
                                        <Border Background="{StaticResource IconGradPurple}" CornerRadius="10" Padding="18,8">
                                            <TextBlock Text="Присоединиться" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" />
                                        </Border>
                                    </Button>
                                </Grid>

                                <Button HorizontalAlignment="Left" Style="{StaticResource IconButtonStyle}" Command="{Binding CopyCurrentInviteLinkCommand}" ToolTip="Скопировать ссылку текущего содружества">
                                    <Border Background="#1A38BDF8" BorderBrush="#3338BDF8" BorderThickness="1" CornerRadius="8" Padding="10,5">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource GeoCopy}" Fill="{StaticResource IconGradSky}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Скопировать инвайт-ссылку текущего содружества" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- 3. METHOD 2: DIRECT LAN / VPN P2P (ZeroTier / Radmin) -->
                        <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="14" Padding="16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Path Data="{StaticResource GeoNetwork}" Fill="{StaticResource IconGradEmerald}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="СПОСОБ 2: ЛОКАЛЬНАЯ СЕТЬ / DIRECT P2P (LAN / VPN)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Прямое соединение без серверов по локальной сети или через VPN (ZeroTier / Radmin):" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="12,8">
                                        <TextBox Text="{Binding DirectLanIpInput, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" />
                                    </Border>
                                    <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource IconButtonStyle}" Command="{Binding ConnectDirectLanPeerCommand}">
                                        <Border Background="{StaticResource IconGradEmerald}" CornerRadius="10" Padding="16,8">
                                            <TextBlock Text="Direct P2P Вызов" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" />
                                        </Border>
                                    </Button>
                                    <Button Grid.Column="2" Margin="6,0,0,0" Style="{StaticResource IconButtonStyle}" Command="{Binding AnnounceLanPresenceCommand}" ToolTip="Оповестить сеть">
                                        <Border Background="#2634D399" BorderBrush="#4D34D399" BorderThickness="1" CornerRadius="10" Padding="10,8">
                                            <Path Data="{StaticResource GeoRefresh}" Fill="{StaticResource IconGradEmerald}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer Actions with Cancel Button -->
                <Grid Grid.Row="2">
                    <Button HorizontalAlignment="Left" Style="{StaticResource IconButtonStyle}" Command="{Binding CloseCreateFellowshipDialogCommand}">
                        <Border Background="{DynamicResource CardHoverBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="18,10">
                            <TextBlock Text="Отмена (Esc)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
