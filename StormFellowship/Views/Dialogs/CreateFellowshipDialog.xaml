<UserControl x:Class="StormFellowship.Views.Dialogs.CreateFellowshipDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource ModalOverlayBackgroundBrush}">
        <Border Background="{DynamicResource ModalDialogBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
            <StackPanel>
                <!-- Title -->
                <TextBlock Text="CREATE A FELLOWSHIP" FontWeight="Black" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                <TextBlock Text="Your fellowship is where you and your friends hang out. Make yours and start talking." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20" />

                <!-- Fellowship Name Input -->
                <TextBlock Text="FELLOWSHIP NAME" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                <TextBox Text="{Binding FellowshipNameInput, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" Padding="10,8" Margin="0,0,0,16" />

                <!-- Join Code Input -->
                <TextBlock Text="OR JOIN WITH INVITE CODE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding JoinCodeInput, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" Padding="10,8" />
                    <Button Grid.Column="1" Content="Join" Margin="8,0,0,0" Padding="14,0" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Cursor="Hand" Command="{Binding JoinWithCodeCommand}" />
                </Grid>

                <!-- Actions -->
                <Grid>
                    <Button Content="Back" HorizontalAlignment="Left" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand" Command="{Binding CloseCommand}" />
                    <Button Content="Create Fellowship" HorizontalAlignment="Right" Background="{DynamicResource AccentBrush}" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Padding="18,8" Cursor="Hand" Command="{Binding CreateCommand}" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
