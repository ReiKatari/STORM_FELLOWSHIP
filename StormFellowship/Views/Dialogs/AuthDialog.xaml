<UserControl x:Class="StormFellowship.Views.Dialogs.AuthDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             KeyDown="OnDialogKeyDown" Focusable="True">
    <!-- Backdrop with click-to-close -->
    <Grid Background="#85000000" MouseDown="OnBackdropMouseDown">
        <Border Width="500" MaxHeight="620" Background="{DynamicResource CardBackgroundBrush}" 
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1.5" 
                CornerRadius="20" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                MouseDown="OnCardMouseDown">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="36" ShadowDepth="10" Opacity="0.7" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="44" Height="44" CornerRadius="14" Background="#2638BDF8" BorderBrush="#4D38BDF8" BorderThickness="1.5" Margin="0,0,14,0">
                            <Path Data="{StaticResource GeoCloudSync}" Fill="{StaticResource IconGradCyan}" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Облачный аккаунт STORM" FontWeight="Black" FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,2" />
                            <TextBlock Text="Бесплатное облако Supabase 24/7 &amp; E2EE Шифрование" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Style="{StaticResource IconButtonStyle}" Command="{Binding CloseModalCommand}" ToolTip="Закрыть (Esc)">
                        <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource CardHoverBrush}">
                            <Path Data="{StaticResource GeoClose}" Fill="{DynamicResource TextSecondaryBrush}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Button>
                </Grid>

                <!-- Tab Navigation Pill -->
                <Border Grid.Row="1" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="4" Margin="0,0,0,16">
                    <UniformGrid Columns="3">
                        <Button x:Name="BtnTabLogin" Click="OnTabLoginClicked" Style="{StaticResource IconButtonStyle}">
                            <Border x:Name="PillLogin" CornerRadius="8" Padding="0,8" Background="{DynamicResource CardHoverBrush}">
                                <TextBlock Text="Вход" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                            </Border>
                        </Button>
                        <Button x:Name="BtnTabRegister" Click="OnTabRegisterClicked" Style="{StaticResource IconButtonStyle}">
                            <Border x:Name="PillRegister" CornerRadius="8" Padding="0,8" Background="Transparent">
                                <TextBlock Text="Регистрация" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                            </Border>
                        </Button>
                        <Button x:Name="BtnTabCloud" Click="OnTabCloudClicked" Style="{StaticResource IconButtonStyle}">
                            <Border x:Name="PillCloud" CornerRadius="8" Padding="0,8" Background="Transparent">
                                <TextBlock Text="Облако &amp; P2P" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                            </Border>
                        </Button>
                    </UniformGrid>
                </Border>

                <!-- Content Area -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                    <StackPanel>
                        <!-- Error Message Badge -->
                        <Border Visibility="{Binding ErrorMessage, Converter={StaticResource StrNotEmptyToVis}}" Background="#26EF4444" BorderBrush="#4DEF4444" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠️ " FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ErrorMessage}" FontSize="12" FontWeight="SemiBold" Foreground="#EF4444" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- TAB 1: LOGIN FORM -->
                        <StackPanel x:Name="TabLoginContent">
                            <TextBlock Text="ЭЛЕКТРОННАЯ ПОЧТА (EMAIL)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="4,0,0,6" />
                            <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,14">
                                <TextBox Text="{Binding LoginEmail, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" />
                            </Border>

                            <TextBlock Text="ПАРОЛЬ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="4,0,0,6" />
                            <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,16">
                                <PasswordBox x:Name="LoginPasswordBox" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" PasswordChanged="OnLoginPasswordChanged" />
                            </Border>

                            <Button Style="{StaticResource IconButtonStyle}" Command="{Binding LoginCommand}" Margin="0,4,0,0">
                                <Border Background="{StaticResource IconGradCyan}" CornerRadius="12" Padding="0,12">
                                    <TextBlock Text="Войти в облачный аккаунт" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                </Border>
                            </Button>
                        </StackPanel>

                        <!-- TAB 2: REGISTER FORM -->
                        <StackPanel x:Name="TabRegisterContent" Visibility="Collapsed">
                            <TextBlock Text="ЭЛЕКТРОННАЯ ПОЧТА (EMAIL)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="4,0,0,6" />
                            <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,12">
                                <TextBox Text="{Binding RegisterEmail, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" />
                            </Border>

                            <TextBlock Text="ОТОБРАЖАЕМОЕ ИМЯ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="4,0,0,6" />
                            <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,12">
                                <TextBox Text="{Binding RegisterDisplayName, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" />
                            </Border>

                            <TextBlock Text="ПАРОЛЬ (ОТ 6 СИМВОЛОВ)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="4,0,0,6" />
                            <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,14">
                                <PasswordBox x:Name="RegisterPasswordBox" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" PasswordChanged="OnRegisterPasswordChanged" />
                            </Border>

                            <!-- Choose Initial Avatar -->
                            <TextBlock Text="ВЫБЕРИТЕ АВАТАР" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="4,0,0,6" />
                            <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="8" Margin="0,0,0,16">
                                <WrapPanel HorizontalAlignment="Center">
                                    <ItemsControl ItemsSource="{Binding AvailableAvatars}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Width="36" Height="36" Margin="3" Style="{StaticResource IconButtonStyle}" Command="{Binding DataContext.SelectAvatarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding IconGeo}">
                                                    <Border Width="30" Height="30" CornerRadius="8" Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}">
                                                        <Path Data="{Binding IconGeo, Converter={StaticResource GeoKeyToGeo}}" Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </WrapPanel>
                            </Border>

                            <Button Style="{StaticResource IconButtonStyle}" Command="{Binding RegisterCommand}">
                                <Border Background="{StaticResource IconGradPurple}" CornerRadius="12" Padding="0,12">
                                    <TextBlock Text="Создать облачный аккаунт (Бесплатно)" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                </Border>
                            </Button>
                        </StackPanel>

                        <!-- TAB 3: CLOUD SYNC & P2P STATUS -->
                        <StackPanel x:Name="TabCloudContent" Visibility="Collapsed">
                            <!-- Cloud Status Card -->
                            <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Path Data="{StaticResource GeoCloudSync}" Fill="{StaticResource IconGradCyan}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Статус облачной синхронизации" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding CloudStatusText}" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding LastSyncFormatted, StringFormat='Последняя синхронизация: {0}'}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- P2P & Free Cloud Architecture Info -->
                            <Border Background="{DynamicResource CardHoverBrush}" CornerRadius="14" Padding="14" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="🌐 Архитектура связи STORM FELLOWSHIP:" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                                    <TextBlock Text="1. Бесплатный облачный бэкенд: Supabase Realtime DB обеспечивает 24/7 доступность каналов и сообщений." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                    <TextBlock Text="2. Сквозное шифрование: E2EE AES-256 GCM шифрует ключи на вашем устройстве." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                    <TextBlock Text="3. P2P WebRTC Direct Mesh: Голосовые и видео звонки идут напрямую без серверов." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Cloud Actions -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Style="{StaticResource IconButtonStyle}" Command="{Binding SyncNowCommand}" Margin="0,0,6,0">
                                    <Border Background="{StaticResource IconGradCyan}" CornerRadius="12" Padding="0,10">
                                        <TextBlock Text="🔄 Синхронизировать" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                    </Border>
                                </Button>

                                <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Command="{Binding LogoutCommand}" Margin="6,0,0,0">
                                    <Border Background="#26EF4444" BorderBrush="#4DEF4444" BorderThickness="1" CornerRadius="12" Padding="0,10">
                                        <TextBlock Text="🚪 Сменить / Выйти" FontWeight="Bold" FontSize="12" Foreground="#EF4444" HorizontalAlignment="Center" />
                                    </Border>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer -->
                <Grid Grid.Row="3">
                    <Button HorizontalAlignment="Right" Style="{StaticResource IconButtonStyle}" Command="{Binding CloseModalCommand}">
                        <Border Background="{DynamicResource CardHoverBrush}" CornerRadius="10" Padding="18,8">
                            <TextBlock Text="Закрыть" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
