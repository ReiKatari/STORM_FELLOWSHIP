<Application x:Class="StormFellowship.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:StormFellowship.Helpers"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/StormDarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <helpers:BoolToVisibilityConverter x:Key="BoolToVis" />
            <helpers:NullToVisibilityConverter x:Key="NullToVis" />
            <helpers:HexToBrushConverter x:Key="HexToBrush" />
            <helpers:StringNotEmptyToVisibilityConverter x:Key="StrNotEmptyToVis" />
            <helpers:BoolToMutedColorConverter x:Key="BoolToMutedColor" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
