<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Backgrounds (Light) -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="RailBackgroundBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#EDF2F7" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="DividerBrush" Color="#E2E8F0" />

    <!-- Accents -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0284C7" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#0369A1" />
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#250284C7" />
    <SolidColorBrush x:Key="AccentMutedBrush" Color="#1A0284C7" />

    <!-- Typography -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#475569" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

    <!-- Status -->
    <SolidColorBrush x:Key="StatusOnlineBrush" Color="#16A34A" />
    <SolidColorBrush x:Key="StatusIdleBrush" Color="#D97706" />
    <SolidColorBrush x:Key="StatusDndBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="StatusOfflineBrush" Color="#94A3B8" />

    <!-- Call Specific -->
    <SolidColorBrush x:Key="CallContainerBackgroundBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="CallControlBarBackgroundBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="CallControlButtonBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CallControlButtonHoverBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="CallEndButtonBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="CallWaveformActiveBrush" Color="#16A34A" />
    <SolidColorBrush x:Key="CallAvatarSpeakingRingBrush" Color="#16A34A" />
    <SolidColorBrush x:Key="CallOverlayPillBrush" Color="#E2E8F0" />

    <!-- Modal Dialogs -->
    <SolidColorBrush x:Key="ModalOverlayBackgroundBrush" Color="#B30F172A" />
    <SolidColorBrush x:Key="ModalDialogBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ModalHeaderBackgroundBrush" Color="#F1F5F9" />
</ResourceDictionary>
