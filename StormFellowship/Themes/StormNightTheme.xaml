<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Backgrounds (OLED Black) -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#000000" />
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#000000" />
    <SolidColorBrush x:Key="RailBackgroundBrush" Color="#000000" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#08080A" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#101014" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#18181E" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#22222A" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#0B0B0E" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#30303A" />
    <SolidColorBrush x:Key="DividerBrush" Color="#22222A" />

    <!-- Accents (Neon Cyan) -->
    <SolidColorBrush x:Key="AccentBrush" Color="#00E5FF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#48EEFF" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#00B5CC" />
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#4000E5FF" />
    <SolidColorBrush x:Key="AccentMutedBrush" Color="#1A00E5FF" />

    <!-- High-Contrast Bright Typography (No dark text on dark background) -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#E4E4E7" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#A1A1AA" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#000000" />

    <!-- Status -->
    <SolidColorBrush x:Key="StatusOnlineBrush" Color="#22C55E" />
    <SolidColorBrush x:Key="StatusIdleBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="StatusDndBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="StatusOfflineBrush" Color="#A1A1AA" />

    <!-- Call Specific -->
    <SolidColorBrush x:Key="CallContainerBackgroundBrush" Color="#0B0B0E" />
    <SolidColorBrush x:Key="CallControlBarBackgroundBrush" Color="#040405" />
    <SolidColorBrush x:Key="CallControlButtonBrush" Color="#18181E" />
    <SolidColorBrush x:Key="CallControlButtonHoverBrush" Color="#22222A" />
    <SolidColorBrush x:Key="CallEndButtonBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="CallWaveformActiveBrush" Color="#00E5FF" />
    <SolidColorBrush x:Key="CallAvatarSpeakingRingBrush" Color="#00E5FF" />
    <SolidColorBrush x:Key="CallOverlayPillBrush" Color="#040405" />

    <!-- Modal Dialogs -->
    <SolidColorBrush x:Key="ModalOverlayBackgroundBrush" Color="#E6000000" />
    <SolidColorBrush x:Key="ModalDialogBackgroundBrush" Color="#0E0E12" />
    <SolidColorBrush x:Key="ModalHeaderBackgroundBrush" Color="#08080B" />
</ResourceDictionary>
