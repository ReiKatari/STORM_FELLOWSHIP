<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =========================================================================
         STORM FELLOWSHIP - REFINED CYBERPUNK DARK THEME (BALANCED & ERGONOMIC)
         ========================================================================= -->

    <!-- Colors -->
    <Color x:Key="StormAppBackgroundColor">#0B0F19</Color>
    <Color x:Key="StormNavSidebarColor">#070A10</Color>
    <Color x:Key="StormCardBackgroundColor">#131B2E</Color>
    <Color x:Key="StormCardHoverColor">#1C263E</Color>
    <Color x:Key="StormCardBorderColor">#24314A</Color>

    <!-- Balanced Modern Sapphire & Indigo Accents -->
    <Color x:Key="StormAccentColor">#3B82F6</Color>
    <Color x:Key="StormAccentSecondaryColor">#6366F1</Color>
    <Color x:Key="StormAccentHoverColor">#60A5FA</Color>
    <Color x:Key="StormAccentPressedColor">#2563EB</Color>
    <Color x:Key="StormGlowColor">#263B82F6</Color>

    <Color x:Key="StormTextPrimaryColor">#FFFFFF</Color>
    <Color x:Key="StormTextSecondaryColor">#CBD5E1</Color>
    <Color x:Key="StormTextMutedColor">#94A3B8</Color>

    <!-- Background Brushes -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource StormAppBackgroundColor}"/>
    <SolidColorBrush x:Key="NavSidebarBrush" Color="{StaticResource StormNavSidebarColor}"/>
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="{StaticResource StormNavSidebarColor}"/>
    <SolidColorBrush x:Key="RailBackgroundBrush" Color="{StaticResource StormNavSidebarColor}"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource StormNavSidebarColor}"/>
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{StaticResource StormAppBackgroundColor}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource StormCardBackgroundColor}"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource StormCardHoverColor}"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource StormCardBorderColor}"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#080C14"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource StormCardBorderColor}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#1E293B"/>

    <!-- Accent Brushes -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource StormAccentColor}"/>
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{StaticResource StormAccentColor}"/>
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="{StaticResource StormAccentSecondaryColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource StormAccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource StormAccentPressedColor}"/>
    <SolidColorBrush x:Key="AccentGlowBrush" Color="{StaticResource StormGlowColor}"/>
    <SolidColorBrush x:Key="AccentMutedBrush" Color="#1A3B82F6"/>

    <!-- Typography Brushes -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource StormTextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource StormTextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource StormTextMutedColor}"/>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF"/>

    <!-- Status Brushes -->
    <SolidColorBrush x:Key="StatusOnlineBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="StatusIdleBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="StatusDndBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="StatusOfflineBrush" Color="#64748B"/>

    <!-- Call Overlay Specific -->
    <SolidColorBrush x:Key="CallOverlayBackgroundBrush" Color="#0B0F19"/>
    <SolidColorBrush x:Key="CallContainerBackgroundBrush" Color="{StaticResource StormCardBackgroundColor}"/>
    <SolidColorBrush x:Key="CallControlBarBackgroundBrush" Color="#070A10"/>
    <SolidColorBrush x:Key="CallControlButtonBrush" Color="{StaticResource StormCardBackgroundColor}"/>
    <SolidColorBrush x:Key="CallControlButtonHoverBrush" Color="{StaticResource StormCardHoverColor}"/>
    <SolidColorBrush x:Key="CallEndButtonBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="CallWaveformActiveBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="CallAvatarSpeakingRingBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="CallOverlayPillBrush" Color="#070A10"/>

    <!-- Modal Dialogs -->
    <SolidColorBrush x:Key="ModalOverlayBackgroundBrush" Color="#D9070A10"/>
    <SolidColorBrush x:Key="ModalDialogBackgroundBrush" Color="{StaticResource StormCardBackgroundColor}"/>
    <SolidColorBrush x:Key="ModalHeaderBackgroundBrush" Color="#070A10"/>

    <!-- Gradients -->
    <LinearGradientBrush x:Key="StormHeroGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3B82F6" Offset="0.0"/>
        <GradientStop Color="#6366F1" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="StormCardGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#182238" Offset="0.0"/>
        <GradientStop Color="#111827" Offset="1.0"/>
    </LinearGradientBrush>

</ResourceDictionary>
