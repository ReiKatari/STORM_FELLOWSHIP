<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B0F17" />
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#090D14" />
    <SolidColorBrush x:Key="RailBackgroundBrush" Color="#070A0F" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#0F1520" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#131B26" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#182230" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#202D3F" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#101722" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#1E2B3D" />
    <SolidColorBrush x:Key="DividerBrush" Color="#172230" />

    <!-- Accents -->
    <SolidColorBrush x:Key="AccentBrush" Color="#00A3FF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#33B5FF" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#008BE0" />
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#3300A3FF" />
    <SolidColorBrush x:Key="AccentMutedBrush" Color="#1A00A3FF" />

    <!-- Typography -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

    <!-- Status -->
    <SolidColorBrush x:Key="StatusOnlineBrush" Color="#22C55E" />
    <SolidColorBrush x:Key="StatusIdleBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="StatusDndBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="StatusOfflineBrush" Color="#64748B" />

    <!-- Call Specific -->
    <SolidColorBrush x:Key="CallContainerBackgroundBrush" Color="#111722" />
    <SolidColorBrush x:Key="CallControlBarBackgroundBrush" Color="#0C1017" />
    <SolidColorBrush x:Key="CallControlButtonBrush" Color="#182332" />
    <SolidColorBrush x:Key="CallControlButtonHoverBrush" Color="#223247" />
    <SolidColorBrush x:Key="CallEndButtonBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="CallWaveformActiveBrush" Color="#22C55E" />
    <SolidColorBrush x:Key="CallAvatarSpeakingRingBrush" Color="#22C55E" />
    <SolidColorBrush x:Key="CallOverlayPillBrush" Color="#0A0D13" />

    <!-- Modal Dialogs -->
    <SolidColorBrush x:Key="ModalOverlayBackgroundBrush" Color="#CC05080C" />
    <SolidColorBrush x:Key="ModalDialogBackgroundBrush" Color="#111722" />
    <SolidColorBrush x:Key="ModalHeaderBackgroundBrush" Color="#0D121B" />
</ResourceDictionary>
