<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Backgrounds (Cyberpunk Violet) -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0D0714" />
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#08040C" />
    <SolidColorBrush x:Key="RailBackgroundBrush" Color="#06020A" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#140B21" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#1C0F2E" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#25143C" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#321C50" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#150B22" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#4C1D95" />
    <SolidColorBrush x:Key="DividerBrush" Color="#3B0764" />

    <!-- Accents (Neon Purple) -->
    <SolidColorBrush x:Key="AccentBrush" Color="#A855F7" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#C084FC" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#9333EA" />
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#40A855F7" />
    <SolidColorBrush x:Key="AccentMutedBrush" Color="#20A855F7" />

    <!-- High-Contrast Bright Typography (No dark text on dark background) -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FAF5FF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#E9D5FF" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#C084FC" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

    <!-- Status -->
    <SolidColorBrush x:Key="StatusOnlineBrush" Color="#22C55E" />
    <SolidColorBrush x:Key="StatusIdleBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="StatusDndBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="StatusOfflineBrush" Color="#C084FC" />

    <!-- Call Specific -->
    <SolidColorBrush x:Key="CallContainerBackgroundBrush" Color="#170B26" />
    <SolidColorBrush x:Key="CallControlBarBackgroundBrush" Color="#0E0617" />
    <SolidColorBrush x:Key="CallControlButtonBrush" Color="#25143C" />
    <SolidColorBrush x:Key="CallControlButtonHoverBrush" Color="#341B53" />
    <SolidColorBrush x:Key="CallEndButtonBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="CallWaveformActiveBrush" Color="#A855F7" />
    <SolidColorBrush x:Key="CallAvatarSpeakingRingBrush" Color="#A855F7" />
    <SolidColorBrush x:Key="CallOverlayPillBrush" Color="#0E0617" />

    <!-- Modal Dialogs -->
    <SolidColorBrush x:Key="ModalOverlayBackgroundBrush" Color="#CC0D0714" />
    <SolidColorBrush x:Key="ModalDialogBackgroundBrush" Color="#1B0E2C" />
    <SolidColorBrush x:Key="ModalHeaderBackgroundBrush" Color="#130920" />
</ResourceDictionary>
