<Window x:Class="StormFellowship.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:StormFellowship.Views.Controls"
        xmlns:dialogs="clr-namespace:StormFellowship.Views.Dialogs"
        mc:Ignorable="d"
        Title="STORM FELLOWSHIP"
        Height="780" Width="1240"
        MinHeight="620" MinWidth="940"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Storm TitleBar -->
        <controls:TitleBarControl x:Name="AppTitleBar" DataContext="{Binding}" />

        <!-- Main Workspace (Rail + Channel Sidebar + Main Area + Member List) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="{Binding SidebarWidth}" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 1. Left Icon Rail (Fellowships + Folders + DMs) -->
            <controls:FellowshipRailControl x:Name="FellowshipRail" Grid.Column="0" DataContext="{Binding RailViewModel}" />

            <!-- 2. Channel & DM Sidebar -->
            <controls:ChannelSidebarControl x:Name="ChannelSidebar" Grid.Column="1" DataContext="{Binding SidebarViewModel}" />

            <!-- 3. Central Stage (Chat View OR Call Overlay) -->
            <Grid Grid.Column="2">
                <!-- Chat View -->
                <controls:ChatViewControl x:Name="MainChatView" DataContext="{Binding ChatViewModel}"
                                          Visibility="{Binding IsInCallView, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

                <!-- Call Overlay Stage (Direct 1-1 / Voice Room) -->
                <controls:CallOverlayControl x:Name="CallOverlay" DataContext="{Binding CallViewModel}"
                                             Visibility="{Binding IsInCallView, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <!-- 4. Right Member List Panel -->
            <controls:MemberListControl x:Name="MemberList" Grid.Column="3" DataContext="{Binding MemberListViewModel}"
                                        Visibility="{Binding IsMemberListVisible, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <!-- Toast Notification Pill Bar -->
        <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,32"
                Background="{DynamicResource AccentBrush}" CornerRadius="20" Padding="18,8"
                Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}"
                Panel.ZIndex="999">
            <TextBlock Text="{Binding ToastMessage}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" />
        </Border>

        <!-- MODAL OVERLAYS & DIALOGS -->
        <Grid Grid.RowSpan="2" Visibility="{Binding IsCreateFellowshipModalOpen, Converter={StaticResource BoolToVis}}">
            <dialogs:CreateFellowshipDialog DataContext="{Binding CreateFellowshipModalViewModel}" />
        </Grid>

        <Grid Grid.RowSpan="2" Visibility="{Binding IsFellowshipSettingsModalOpen, Converter={StaticResource BoolToVis}}">
            <dialogs:FellowshipSettingsDialog DataContext="{Binding FellowshipSettingsModalViewModel}" />
        </Grid>

        <Grid Grid.RowSpan="2" Visibility="{Binding IsUserSettingsModalOpen, Converter={StaticResource BoolToVis}}">
            <dialogs:UserSettingsDialog DataContext="{Binding UserSettingsViewModel}" />
        </Grid>

        <Grid Grid.RowSpan="2" Visibility="{Binding IsCreateChannelModalOpen, Converter={StaticResource BoolToVis}}">
            <dialogs:CreateChannelDialog DataContext="{Binding CreateChannelModalViewModel}" />
        </Grid>

        <Grid Grid.RowSpan="2" Visibility="{Binding IsEditChannelModalOpen, Converter={StaticResource BoolToVis}}">
            <dialogs:EditChannelDialog DataContext="{Binding EditChannelModalViewModel}" />
        </Grid>

        <Grid Grid.RowSpan="2" Visibility="{Binding IsRoleManagementModalOpen, Converter={StaticResource BoolToVis}}">
            <dialogs:RoleManagementDialog DataContext="{Binding RoleManagementViewModel}" />
        </Grid>

        <Grid Grid.RowSpan="2" Visibility="{Binding IsCreatePollModalOpen, Converter={StaticResource BoolToVis}}">
            <dialogs:CreatePollDialog DataContext="{Binding}" />
        </Grid>

        <Grid Grid.RowSpan="2" Visibility="{Binding IsSearchModalOpen, Converter={StaticResource BoolToVis}}">
            <dialogs:SearchDialog DataContext="{Binding}" />
        </Grid>

        <Grid Grid.RowSpan="2" Visibility="{Binding IsE2EESecurityModalOpen, Converter={StaticResource BoolToVis}}">
            <dialogs:E2EESecurityDialog DataContext="{Binding}" />
        </Grid>

        <Grid Grid.RowSpan="2" Visibility="{Binding IsScreenShareModalOpen, Converter={StaticResource BoolToVis}}">
            <dialogs:ScreenShareDialog DataContext="{Binding}" />
        </Grid>

        <!-- Emote & Sticker Picker Popup Layer -->
        <Grid Grid.RowSpan="2" Visibility="{Binding IsEmotePickerOpen, Converter={StaticResource BoolToVis}}" Background="#55000000">
            <dialogs:EmotePickerPopup HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="EmotePopup" />
        </Grid>
    </Grid>
</Window>
