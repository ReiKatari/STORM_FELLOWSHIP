<Window x:Class="StormFellowship.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:StormFellowship.Views.Controls"
        xmlns:dialogs="clr-namespace:StormFellowship.Views.Dialogs"
        mc:Ignorable="d"
        Title="STORM FELLOWSHIP v0.2.2"
        Icon="pack://application:,,,/Assets/AppIcon.png"
        Height="780" Width="1240"
        MinHeight="620" MinWidth="940"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      ResizeBorderThickness="6"
                      CornerRadius="14"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Storm TitleBar -->
        <controls:TitleBarControl x:Name="AppTitleBar" DataContext="{Binding}" />

        <!-- Main Workspace (Rail + Channel Sidebar + Main Area + Member List) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="{Binding SidebarWidth}" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 1. Left Icon Rail (Fellowships + Folders + DMs) -->
            <controls:FellowshipRailControl x:Name="FellowshipRail" Grid.Column="0" DataContext="{Binding RailViewModel}" />

            <!-- 2. Channel & DM Sidebar -->
            <controls:ChannelSidebarControl x:Name="ChannelSidebar" Grid.Column="1" DataContext="{Binding SidebarViewModel}" />

            <!-- 3. Central Stage (Chat View OR Call Overlay) -->
            <Grid Grid.Column="2">
                <!-- Chat View (Visible by default) -->
                <Grid Visibility="{Binding IsInCallView, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <controls:ChatViewControl x:Name="MainChatView" DataContext="{Binding ChatViewModel}" />
                </Grid>

                <!-- Call Overlay Stage (Visible ONLY during active call) -->
                <Grid Visibility="{Binding IsInCallView, Converter={StaticResource BoolToVis}}">
                    <controls:CallOverlayControl x:Name="CallOverlay" DataContext="{Binding CallViewModel}" />
                </Grid>
            </Grid>

            <!-- 4. Right Member List Panel -->
            <controls:MemberListControl x:Name="MemberList" Grid.Column="3" DataContext="{Binding MemberListViewModel}"
                                        Visibility="{Binding DataContext.IsMemberListVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <!-- Floating Modern Toast Notification Hub (Bottom-Right) -->
        <Border Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24"
                Background="#EE131B2E" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1.5"
                CornerRadius="12" Padding="14,10" MaxWidth="380"
                Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}"
                Panel.ZIndex="999">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.6" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="28" Height="28" CornerRadius="8" Background="#263B82F6" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Path Data="{StaticResource GeoBell}" Fill="{StaticResource IconGradCyan}" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding ToastMessage}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- MODAL OVERLAYS & DIALOGS -->
        <Grid Grid.RowSpan="2" Visibility="{Binding IsCreateFellowshipModalOpen, Converter={StaticResource BoolToVis}}">
            <dialogs:CreateFellowshipDialog DataContext="{Binding}" />
        </Grid>

        <Grid Grid.RowSpan="2" Visibility="{Binding IsFellowshipSettingsModalOpen, Converter={StaticResource BoolToVis}}">
            <dialogs:FellowshipSettingsDialog DataContext="{Binding}" />
        </Grid>

        <Grid Grid.RowSpan="2" Visibility="{Binding IsUserSettingsModalOpen, Converter={StaticResource BoolToVis}}">
            <dialogs:UserSettingsDialog DataContext="{Binding UserSettingsViewModel}" />
        </Grid>

        <Grid Grid.RowSpan="2" Visibility="{Binding IsCreateChannelModalOpen, Converter={StaticResource BoolToVis}}">
            <dialogs:CreateChannelDialog DataContext="{Binding}" />
        </Grid>

        <Grid Grid.RowSpan="2" Visibility="{Binding IsEditChannelModalOpen, Converter={StaticResource BoolToVis}}">
            <dialogs:EditChannelDialog DataContext="{Binding}" />
        </Grid>

        <Grid Grid.RowSpan="2" Visibility="{Binding IsRoleManagementModalOpen, Converter={StaticResource BoolToVis}}">
            <dialogs:RoleManagementDialog DataContext="{Binding}" />
        </Grid>

        <Grid Grid.RowSpan="2" Visibility="{Binding IsCreatePollModalOpen, Converter={StaticResource BoolToVis}}">
            <dialogs:CreatePollDialog DataContext="{Binding}" />
        </Grid>

        <Grid Grid.RowSpan="2" Visibility="{Binding IsSearchModalOpen, Converter={StaticResource BoolToVis}}">
            <dialogs:SearchDialog DataContext="{Binding}" />
        </Grid>

        <Grid Grid.RowSpan="2" Visibility="{Binding IsE2EESecurityModalOpen, Converter={StaticResource BoolToVis}}">
            <dialogs:E2EESecurityDialog DataContext="{Binding}" />
        </Grid>

        <Grid Grid.RowSpan="2" Visibility="{Binding IsScreenShareModalOpen, Converter={StaticResource BoolToVis}}">
            <dialogs:ScreenShareDialog DataContext="{Binding}" />
        </Grid>

        <!-- Cloud Account & Auth Dialog Layer -->
        <Grid Grid.RowSpan="2" Visibility="{Binding IsAuthModalOpen, Converter={StaticResource BoolToVis}}">
            <dialogs:AuthDialog DataContext="{Binding AuthViewModel}" />
        </Grid>

        <!-- Soundboard Dialog Layer -->
        <Grid Grid.RowSpan="2" Visibility="{Binding IsSoundboardModalOpen, Converter={StaticResource BoolToVis}}">
            <dialogs:SoundboardDialog DataContext="{Binding}" />
        </Grid>

        <!-- Quick Switcher Command Palette (Ctrl+K) Layer -->
        <Grid Grid.RowSpan="2" Visibility="{Binding IsQuickSwitcherModalOpen, Converter={StaticResource BoolToVis}}">
            <dialogs:QuickSwitcherDialog DataContext="{Binding}" />
        </Grid>

        <!-- Floating User Profile & Status Card Overlay -->
        <Grid Grid.RowSpan="2" Visibility="{Binding IsUserProfileQuickCardOpen, Converter={StaticResource BoolToVis}}" Background="#66000000">
            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="70,0,0,56" Width="300"
                    Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="16">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="6" Opacity="0.5" />
                </Border.Effect>
                <StackPanel>
                    <!-- Header with Close button -->
                    <Grid Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoUser}" Fill="{StaticResource IconGradCyan}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Профиль и статус" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Style="{StaticResource IconButtonStyle}" Command="{Binding CloseUserProfileQuickCardCommand}">
                            <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource CardHoverBrush}">
                                <Path Data="{StaticResource GeoClose}" Fill="{DynamicResource TextSecondaryBrush}" Width="9" Height="9" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Button>
                    </Grid>

                    <!-- User Banner & Avatar -->
                    <Border CornerRadius="12" Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" Padding="12" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Avatar with Custom Image Support -->
                            <Grid Width="46" Height="46">
                                <Border Width="46" Height="46" CornerRadius="23" Background="{StaticResource IconGradCyan}" Visibility="{Binding CurrentUser.HasCustomAvatarImage, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                    <Path Data="{Binding CurrentUser.AvatarGlyph, Converter={StaticResource GeoKeyToGeo}}" Fill="#FFFFFF" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Width="46" Height="46" CornerRadius="23" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" Visibility="{Binding CurrentUser.HasCustomAvatarImage, Converter={StaticResource BoolToVis}}">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding CurrentUser.AvatarPath}" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                            </Grid>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentUser.DisplayName}" FontWeight="Black" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding CurrentUser.Username, StringFormat='{}@{0}'}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                <Border Background="#1A10B981" CornerRadius="4" Padding="6,1" Margin="0,4,0,0" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding CurrentUser.RoleName}" FontSize="9" FontWeight="Bold" Foreground="#10B981" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Status Selector Title -->
                    <TextBlock Text="ВЫБОР СТАТУСА" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6" />

                    <!-- Status Buttons -->
                    <Button Margin="0,2" Padding="8,6" Background="{DynamicResource InputBackgroundBrush}" BorderThickness="0" Style="{StaticResource IconButtonStyle}" Command="{Binding SetUserStatusCommand}" CommandParameter="Online">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Fill="{DynamicResource StatusOnlineBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="В сети" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Button>
                    <Button Margin="0,2" Padding="8,6" Background="{DynamicResource InputBackgroundBrush}" BorderThickness="0" Style="{StaticResource IconButtonStyle}" Command="{Binding SetUserStatusCommand}" CommandParameter="Idle">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Fill="{DynamicResource StatusIdleBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="Не активен" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Button>
                    <Button Margin="0,2" Padding="8,6" Background="{DynamicResource InputBackgroundBrush}" BorderThickness="0" Style="{StaticResource IconButtonStyle}" Command="{Binding SetUserStatusCommand}" CommandParameter="DoNotDisturb">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Fill="{DynamicResource StatusDndBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="Не беспокоить" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Button>
                    <Button Margin="0,2" Padding="8,6" Background="{DynamicResource InputBackgroundBrush}" BorderThickness="0" Style="{StaticResource IconButtonStyle}" Command="{Binding SetUserStatusCommand}" CommandParameter="Invisible">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Fill="{DynamicResource StatusOfflineBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="Невидимка" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Button>

                    <Separator Margin="0,8" />

                    <!-- Quick Action Buttons -->
                    <Button Margin="0,2" Padding="8,6" Background="{DynamicResource CardHoverBrush}" BorderThickness="0" Style="{StaticResource IconButtonStyle}" Command="{Binding CopyUserIdCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoCopy}" Fill="{StaticResource IconGradCyan}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Скопировать User ID" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Margin="0,2" Padding="8,6" Background="{DynamicResource CardHoverBrush}" BorderThickness="0" Style="{StaticResource IconButtonStyle}" Command="{Binding OpenUserSettingsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoGear}" Fill="{StaticResource IconGradPurple}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Полные настройки аккаунта..." FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Folder Manager Dialog Layer -->
        <Grid Grid.RowSpan="2" Visibility="{Binding IsFolderManagerModalOpen, Converter={StaticResource BoolToVis}}">
            <dialogs:FolderManagerDialog DataContext="{Binding}" />
        </Grid>

        <!-- Emote & Sticker Picker Popup Layer -->
        <Grid Grid.RowSpan="2" Visibility="{Binding IsEmotePickerOpen, Converter={StaticResource BoolToVis}}" Background="#55000000">
            <dialogs:EmotePickerPopup HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="EmotePopup" />
        </Grid>
    </Grid>
</Window>
