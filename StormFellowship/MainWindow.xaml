<Window
    x:Class="StormFellowship.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:StormFellowship.Views.Controls"
    xmlns:dialogs="using:StormFellowship.Views.Dialogs"
    mc:Ignorable="d"
    Title="STORM FELLOWSHIP v0.0.1">

    <Grid x:Name="RootGrid" Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Styled Title Bar -->
        <controls:TitleBarControl x:Name="AppTitleBar" />

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 1. Leftmost Fellowship / Server Rail -->
            <controls:FellowshipRailControl x:Name="FellowshipRail" Grid.Column="0" />

            <!-- 2. Channel & DM Sidebar -->
            <controls:ChannelSidebarControl x:Name="ChannelSidebar" Grid.Column="1" />

            <!-- 3. Central Workspace: Chat View & Call View Overlay -->
            <Grid Grid.Column="2">
                <!-- Chat View -->
                <controls:ChatViewControl x:Name="MainChatView"
                                          ToggleMemberListRequested="OnToggleMemberListRequested" />

                <!-- Call Overlay Screen (1-1 Direct Calls & Group Calls) -->
                <controls:CallOverlayControl x:Name="CallOverlay" />
            </Grid>

            <!-- 4. Right Member List Sidebar (Collapsible) -->
            <controls:MemberListControl x:Name="MemberList" Grid.Column="3" />
        </Grid>

        <!-- MODAL DIALOG OVERLAYS -->
        <!-- Create / Join Fellowship Modal -->
        <dialogs:CreateFellowshipDialog x:Name="CreateFellowshipModal" Grid.RowSpan="2" Visibility="Collapsed" />

        <!-- Fellowship Settings Modal -->
        <dialogs:FellowshipSettingsDialog x:Name="FellowshipSettingsModal" Grid.RowSpan="2" Visibility="Collapsed" />

        <!-- User Settings Modal -->
        <dialogs:UserSettingsDialog x:Name="UserSettingsModal" Grid.RowSpan="2" Visibility="Collapsed"
                                    CloseRequested="OnUserSettingsCloseRequested" />
    </Grid>
</Window>
